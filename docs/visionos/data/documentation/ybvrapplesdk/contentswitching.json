{"sections":[],"seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"generated":true}],"kind":"article","identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/contentswitching"]}],"abstract":[{"text":"Move an existing player from one video to another without tearing it down.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true,"type":"reference"},{"type":"text","text":" replaces the content playing in a live player. It"},{"type":"text","text":" "},{"type":"text","text":"keeps the player, the rendering surface, and the immersive space intact, which makes it the"},{"type":"text","text":" "},{"text":"right call for “up next” rails, recommendation panels, and channel switching. Creating a new","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true,"type":"reference"},{"text":" per video would instead drop and rebuild the surface — on visionOS that","type":"text"},{"text":" ","type":"text"},{"text":"means visibly leaving and re-entering the immersive space.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the player has not started anything yet, "},{"type":"codeVoice","code":"switchContent(to:_:)"},{"type":"text","text":" falls back to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","isActive":true},{"type":"text","text":", so it is safe to call as the single entry point"},{"type":"text","text":" "},{"type":"text","text":"for playback."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Changing the "},{"inlineContent":[{"text":"player","type":"text"}],"type":"emphasis"},{"type":"text","text":" rather than the video — moving a session from an immersive space into a"},{"type":"text","text":" "},{"type":"text","text":"window, say — is the opposite trade and needs a new manager: see "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Switching","type":"heading","level":2,"anchor":"Switching"},{"inlineContent":[{"type":"text","text":"As with "},{"type":"codeVoice","code":"startStream"},{"type":"text","text":", pre-fetching the signaling file removes a network round trip from"},{"type":"text","text":" "},{"type":"text","text":"inside the switch:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func switchTo(video newVideo: Video) async {","    guard newVideo != currentVideo else { return }","","    do {","        let signaling = try await player.fetchSignalingFile(video: newVideo)","        try await player.switchContent(to: newVideo, signaling)","    } catch {","        loadFailure = error.localizedDescription","    }","}"]},{"inlineContent":[{"text":"The switch tears down the previous item, stops analytics tracking for it, resolves the new","type":"text"},{"type":"text","text":" "},{"text":"item’s signaling, and starts the new stream. Analytics restart automatically for the new","type":"text"},{"type":"text","text":" "},{"type":"text","text":"content."}],"type":"paragraph"},{"text":"Reflecting the Transition in Your UI","type":"heading","level":2,"anchor":"Reflecting-the-Transition-in-Your-UI"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isSwitchingContent","isActive":true},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" for the duration of the call. Drive a","type":"text"},{"text":" ","type":"text"},{"text":"loading state from it, and disable the controls that would race the switch:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["player.isSwitchingContent","    .receive(on: DispatchQueue.main)","    .sink { [weak self] switching in","        self?.isSwitchingContent = switching","    }","    .store(in: &cancellables)"],"syntax":"swift"},{"type":"codeListing","code":["Button(\"Play\") { … }","    .disabled(vm.isSwitchingContent)"],"syntax":"swift"},{"name":"Important","content":[{"inlineContent":[{"text":"Re-bind your player subscriptions around a switch rather than reusing them.","type":"text"},{"text":" ","type":"text"},{"text":"Which bindings apply depends on the content — a control room item exposes a camera selector","type":"text"},{"text":" ","type":"text"},{"text":"and per-camera language sets that a flat item does not. Cancel your subscriptions, call","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"switchContent"},{"text":", then re-subscribe and re-read","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"type":"aside","style":"important"},{"inlineContent":[{"text":"Reset your own transport state as part of the switch too: position, duration, subtitle cue,","type":"text"},{"text":" ","type":"text"},{"text":"and the selected audio and subtitle languages all belong to the outgoing item.","type":"text"}],"type":"paragraph"},{"anchor":"Reacting-to-Playback-Ending","type":"heading","level":2,"text":"Reacting to Playback Ending"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true},{"text":" publishes the ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","isActive":true},{"text":" that just finished. Use it to chain","type":"text"},{"text":" ","type":"text"},{"text":"straight into the next item rather than dismissing the player:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["player.itemDidEnd","    .receive(on: DispatchQueue.main)","    .sink { [weak self] finished in","        guard let next = self?.nextUp(after: finished) else { return }","        Task { await self?.switchTo(video: next) }","    }","    .store(in: &cancellables)"],"syntax":"swift"},{"anchor":"Handling-Failures","type":"heading","level":2,"text":"Handling Failures"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true},{"text":" reports errors that surface after playback has begun, as","type":"text"},{"text":" ","type":"text"},{"text":"distinct from the error thrown by the ","type":"text"},{"type":"codeVoice","code":"switchContent"},{"text":" call itself:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in","        self?.loadFailure = error.localizedDescription","    }","    .store(in: &cancellables)"],"syntax":"swift"},{"anchor":"Ads-and-Switching","type":"heading","level":2,"text":"Ads and Switching"},{"inlineContent":[{"text":"A schedule set through ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true},{"text":" belongs to the content it was scheduled","type":"text"},{"text":" ","type":"text"},{"text":"against and is cleared when the content changes. Schedule the new item’s breaks after the","type":"text"},{"text":" ","type":"text"},{"text":"switch completes — see ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"metadata":{"roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}],"role":"article","title":"Switching Content"},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/playbackError":{"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/playbackerror","title":"playbackError","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"playbackError"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"PassthroughSubject","preciseIdentifier":"s:7Combine18PassthroughSubjectC"},{"kind":"text","text":"<any "},{"kind":"typeIdentifier","text":"Error","preciseIdentifier":"s:s5ErrorP"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Never","preciseIdentifier":"s:s5NeverO"},{"kind":"text","text":">"}],"abstract":[],"type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","kind":"symbol","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/ads":{"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/ads","title":"ads","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ads"},{"kind":"text","text":": "},{"preciseIdentifier":"s:12YBVRAppleSDK16YBVRAdControllerC","kind":"typeIdentifier","text":"YBVRAdController"}],"abstract":[{"type":"text","text":"Ad breaks: the schedule, the skip control, and the state a host binds its a