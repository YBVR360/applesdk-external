{"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"abstract":[{"text":"Move an existing player from one video to another without tearing it down.","type":"text"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"generated":true,"anchor":"Guides","title":"Guides"}],"metadata":{"role":"article","title":"Switching Content","modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article"},"kind":"article","sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true,"type":"reference"},{"text":" replaces the content playing in a live player. It","type":"text"},{"text":" ","type":"text"},{"text":"keeps the player, the rendering surface, and the immersive space intact, which makes it the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"right call for “up next” rails, recommendation panels, and channel switching. Creating a new"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference","isActive":true},{"type":"text","text":" per video would instead drop and rebuild the surface — on visionOS that"},{"type":"text","text":" "},{"type":"text","text":"means visibly leaving and re-entering the immersive space."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If the player has not started anything yet, ","type":"text"},{"type":"codeVoice","code":"switchContent(to:_:)"},{"text":" falls back to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","type":"reference","isActive":true},{"text":", so it is safe to call as the single entry point","type":"text"},{"text":" ","type":"text"},{"text":"for playback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Changing the "},{"type":"emphasis","inlineContent":[{"text":"player","type":"text"}]},{"type":"text","text":" rather than the video — moving a session from an immersive space into a"},{"type":"text","text":" "},{"type":"text","text":"window, say — is the opposite trade and needs a new manager: see "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","type":"reference","isActive":true},{"type":"text","text":"."}]},{"type":"heading","text":"Switching","level":2,"anchor":"Switching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"As with "},{"code":"startStream","type":"codeVoice"},{"text":", pre-fetching the signaling file removes a network round trip from","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"inside the switch:"}]},{"type":"codeListing","code":["func switchTo(video newVideo: Video) async {","    guard newVideo != currentVideo else { return }","","    do {","        let signaling = try await player.fetchSignalingFile(video: newVideo)","        try await player.switchContent(to: newVideo, signaling)","    } catch {","        loadFailure = error.localizedDescription","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch tears down the previous item, stops analytics tracking for it, resolves the new"},{"type":"text","text":" "},{"type":"text","text":"item’s signaling, and starts the new stream. Analytics restart automatically for the new"},{"type":"text","text":" "},{"type":"text","text":"content."}]},{"text":"Reflecting the Transition in Your UI","type":"heading","anchor":"Reflecting-the-Transition-in-Your-UI","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isSwitchingContent","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the duration of the call. Drive a"},{"type":"text","text":" "},{"type":"text","text":"loading state from it, and disable the controls that would race the switch:"}]},{"type":"codeListing","code":["player.isSwitchingContent","    .receive(on: DispatchQueue.main)","    .sink { [weak self] switching in","        self?.isSwitchingContent = switching","    }","    .store(in: &cancellables)"],"syntax":"swift"},{"type":"codeListing","code":["Button(\"Play\") { … }","    .disabled(vm.isSwitchingContent)"],"syntax":"swift"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-bind your player subscriptions around a switch rather than reusing them."},{"type":"text","text":" "},{"type":"text","text":"Which bindings apply depends on the content — a control room item exposes a camera selector"},{"type":"text","text":" "},{"type":"text","text":"and per-camera language sets that a flat item does not. Cancel your subscriptions, call"},{"text":" ","type":"text"},{"type":"codeVoice","code":"switchContent"},{"text":", then re-subscribe and re-read","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","isActive":true,"type":"reference"},{"text":".","type":"text"}]}],"type":"aside","style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"text":"Reset your own transport state as part of the switch too: position, duration, subtitle cue,","type":"text"},{"text":" ","type":"text"},{"text":"and the selected audio and subtitle languages all belong to the outgoing item.","type":"text"}]},{"anchor":"Reacting-to-Playback-Ending","level":2,"text":"Reacting to Playback Ending","type":"heading"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","type":"reference"},{"text":" publishes the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","type":"reference"},{"text":" that just finished. Use it to chain","type":"text"},{"text":" ","type":"text"},{"text":"straight into the next item rather than dismissing the player:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["player.itemDidEnd","    .receive(on: DispatchQueue.main)","    .sink { [weak self] finished in","        guard let next = self?.nextUp(after: finished) else { return }","        Task { await self?.switchTo(video: next) }","    }","    .store(in: &cancellables)"],"type":"codeListing"},{"anchor":"Handling-Failures","level":2,"text":"Handling Failures","type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError"},{"type":"text","text":" reports errors that surface after playback has begun, as"},{"type":"text","text":" "},{"type":"text","text":"distinct from the error thrown by the "},{"type":"codeVoice","code":"switchContent"},{"type":"text","text":" call itself:"}],"type":"paragraph"},{"syntax":"swift","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in","        self?.loadFailure = error.localizedDescription","    }","    .store(in: &cancellables)"],"type":"codeListing"},{"anchor":"Ads-and-Switching","level":2,"text":"Ads and Switching","type":"heading"},{"inlineContent":[{"type":"text","text":"A schedule set through "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true},{"type":"text","text":" belongs to the content it was scheduled"},{"type":"text","text":" "},{"type":"text","text":"against and is cleared when the content changes. Schedule the new item’s breaks after the"},{"type":"text","text":" "},{"type":"text","text":"switch completes — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},{"type":"text","text":"."}],"type":"paragraph"}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/contentswitching"]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager":{"kind":"symbol","title":"YBVRPlayerManager","type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager","abstract":[{"type":"text","text":"YBVRPlayer is an object that provides the interface to display videos inside custom geometries."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YBVRPlayerManager","kind":"identifier"}],"navigatorTitle":[{"text":"YBVRPlayerManager","kind":"identifier"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/ads":{"kind":"symbol","title":"ads","type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/ads","abstract":[{"text":"Ad breaks: the schedule, the skip control, and the state a host binds its ad UI to.","type":"text"}],"role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"ads"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"YBVRAdController","preciseIdentifier":"s:12YBVRAppleSDK16YBVRAdControllerC"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Vi