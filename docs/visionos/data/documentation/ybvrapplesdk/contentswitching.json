{"abstract":[{"type":"text","text":"Move an existing player from one video to another without tearing it down."}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/contentswitching"],"traits":[{"interfaceLanguage":"swift"}]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"type":"text","text":" replaces the content playing in a live player. It"},{"type":"text","text":" "},{"type":"text","text":"keeps the player, the rendering surface, and the immersive space intact, which makes it the"},{"type":"text","text":" "},{"type":"text","text":"right call for “up next” rails, recommendation panels, and channel switching. Creating a new"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" per video would instead drop and rebuild the surface — on visionOS that"},{"type":"text","text":" "},{"text":"means visibly leaving and re-entering the immersive space.","type":"text"}]},{"inlineContent":[{"type":"text","text":"If the player has not started anything yet, "},{"code":"switchContent(to:_:)","type":"codeVoice"},{"text":" falls back to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","isActive":true,"type":"reference"},{"type":"text","text":", so it is safe to call as the single entry point"},{"text":" ","type":"text"},{"text":"for playback.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Changing the "},{"type":"emphasis","inlineContent":[{"text":"player","type":"text"}]},{"type":"text","text":" rather than the video — moving a session from an immersive space into a"},{"type":"text","text":" "},{"text":"window, say — is the opposite trade and needs a new manager: see ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","isActive":true},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Switching","level":2,"type":"heading","anchor":"Switching"},{"inlineContent":[{"type":"text","text":"As with "},{"type":"codeVoice","code":"startStream"},{"type":"text","text":", pre-fetching the signaling file removes a network round trip from"},{"type":"text","text":" "},{"type":"text","text":"inside the switch:"}],"type":"paragraph"},{"syntax":"swift","code":["func switchTo(video newVideo: Video) async {","    guard newVideo != currentVideo else { return }","","    do {","        let signaling = try await player.fetchSignalingFile(video: newVideo)","        try await player.switchContent(to: newVideo, signaling)","    } catch {","        loadFailure = error.localizedDescription","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"The switch tears down the previous item, stops analytics tracking for it, resolves the new"},{"type":"text","text":" "},{"type":"text","text":"item’s signaling, and starts the new stream. Analytics restart automatically for the new"},{"type":"text","text":" "},{"type":"text","text":"content."}],"type":"paragraph"},{"text":"Reflecting the Transition in Your UI","anchor":"Reflecting-the-Transition-in-Your-UI","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isSwitchingContent"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the duration of the call. Drive a"},{"type":"text","text":" "},{"type":"text","text":"loading state from it, and disable the controls that would race the switch:"}],"type":"paragraph"},{"syntax":"swift","code":["player.isSwitchingContent","    .receive(on: DispatchQueue.main)","    .sink { [weak self] switching in","        self?.isSwitchingContent = switching","    }","    .store(in: &cancellables)"],"type":"codeListing"},{"syntax":"swift","code":["Button(\"Play\") { … }","    .disabled(vm.isSwitchingContent)"],"type":"codeListing"},{"name":"Important","style":"important","content":[{"inlineContent":[{"type":"text","text":"Re-bind your player subscriptions around a switch rather than reusing them."},{"type":"text","text":" "},{"type":"text","text":"Which bindings apply depends on the content — a control room item exposes a camera selector"},{"type":"text","text":" "},{"type":"text","text":"and per-camera language sets that a flat item does not. Cancel your subscriptions, call"},{"text":" ","type":"text"},{"code":"switchContent","type":"codeVoice"},{"text":", then re-subscribe and re-read","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"},{"type":"text","text":"."}],"type":"paragraph"}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"Reset your own transport state as part of the switch too: position, duration, subtitle cue,","type":"text"},{"text":" ","type":"text"},{"text":"and the selected audio and subtitle languages all belong to the outgoing item.","type":"text"}]},{"text":"Reacting to Playback Ending","type":"heading","level":2,"anchor":"Reacting-to-Playback-Ending"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true},{"type":"text","text":" publishes the "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","isActive":true},{"type":"text","text":" that just finished. Use it to chain"},{"type":"text","text":" "},{"type":"text","text":"straight into the next item rather than dismissing the player:"}]},{"syntax":"swift","code":["player.itemDidEnd","    .receive(on: DispatchQueue.main)","    .sink { [weak self] finished in","        guard let next = self?.nextUp(after: finished) else { return }","        Task { await self?.switchTo(video: next) }","    }","    .store(in: &cancellables)"],"type":"codeListing"},{"text":"Handling Failures","type":"heading","anchor":"Handling-Failures","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true,"type":"reference"},{"text":" reports errors that surface after playback has begun, as","type":"text"},{"text":" ","type":"text"},{"text":"distinct from the error thrown by the ","type":"text"},{"code":"switchContent","type":"codeVoice"},{"text":" call itself:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in","        self?.loadFailure = error.localizedDescription","    }","    .store(in: &cancellables)"]},{"text":"Ads and Switching","type":"heading","anchor":"Ads-and-Switching","level":2},{"type":"paragraph","inlineContent":[{"text":"A schedule set through ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true,"type":"reference"},{"text":" belongs to the content it was scheduled","type":"text"},{"text":" ","type":"text"},{"text":"against and is cleared when the content changes. Schedule the new item’s breaks after the","type":"text"},{"text":" ","type":"text"},{"text":"switch completes — see ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}],"sections":[],"kind":"article","schemaVersion":{"major":0,"minor":3,"patch":0},"hierarchy":{"p