{"sections":[],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"generated":true,"anchor":"Guides"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","type":"reference","isActive":true},{"text":" replaces the content playing in a live player. It","type":"text"},{"text":" ","type":"text"},{"text":"keeps the player, the rendering surface, and the immersive space intact, which makes it the","type":"text"},{"text":" ","type":"text"},{"text":"right call for “up next” rails, recommendation panels, and channel switching. Creating a new","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference","isActive":true},{"text":" per video would instead drop and rebuild the surface — on visionOS that","type":"text"},{"text":" ","type":"text"},{"text":"means visibly leaving and re-entering the immersive space.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the player has not started anything yet, "},{"type":"codeVoice","code":"switchContent(to:_:)"},{"type":"text","text":" falls back to"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)"},{"type":"text","text":", so it is safe to call as the single entry point"},{"type":"text","text":" "},{"type":"text","text":"for playback."}]},{"type":"paragraph","inlineContent":[{"text":"Changing the ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"player"}]},{"text":" rather than the video — moving a session from an immersive space into a","type":"text"},{"text":" ","type":"text"},{"text":"window, say — is the opposite trade and needs a new manager: see ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","type":"reference","isActive":true},{"text":".","type":"text"}]},{"anchor":"Switching","text":"Switching","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"As with ","type":"text"},{"type":"codeVoice","code":"startStream"},{"text":", pre-fetching the signaling file removes a network round trip from","type":"text"},{"text":" ","type":"text"},{"text":"inside the switch:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func switchTo(video newVideo: Video) async {","    guard newVideo != currentVideo else { return }","","    do {","        let signaling = try await player.fetchSignalingFile(video: newVideo)","        try await player.switchContent(to: newVideo, signaling)","    } catch {","        loadFailure = error.localizedDescription","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"The switch tears down the previous item, stops analytics tracking for it, resolves the new","type":"text"},{"text":" ","type":"text"},{"text":"item’s signaling, and starts the new stream. Analytics restart automatically for the new","type":"text"},{"text":" ","type":"text"},{"text":"content.","type":"text"}]},{"anchor":"Reflecting-the-Transition-in-Your-UI","text":"Reflecting the Transition in Your UI","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isSwitchingContent","type":"reference","isActive":true},{"text":" is ","type":"text"},{"type":"codeVoice","code":"true"},{"text":" for the duration of the call. Drive a","type":"text"},{"text":" ","type":"text"},{"text":"loading state from it, and disable the controls that would race the switch:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["player.isSwitchingContent","    .receive(on: DispatchQueue.main)","    .sink { [weak self] switching in","        self?.isSwitchingContent = switching","    }","    .store(in: &cancellables)"]},{"type":"codeListing","code":["Button(\"Play\") { … }","    .disabled(vm.isSwitchingContent)"],"syntax":"swift"},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"Re-bind your player subscriptions around a switch rather than reusing them.","type":"text"},{"text":" ","type":"text"},{"text":"Which bindings apply depends on the content — a control room item exposes a camera selector","type":"text"},{"text":" ","type":"text"},{"text":"and per-camera language sets that a flat item does not. Cancel your subscriptions, call","type":"text"},{"text":" ","type":"text"},{"code":"switchContent","type":"codeVoice"},{"text":", then re-subscribe and re-read","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}]},{"inlineContent":[{"text":"Reset your own transport state as part of the switch too: position, duration, subtitle cue,","type":"text"},{"text":" ","type":"text"},{"text":"and the selected audio and subtitle languages all belong to the outgoing item.","type":"text"}],"type":"paragraph"},{"anchor":"Reacting-to-Playback-Ending","text":"Reacting to Playback Ending","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true},{"text":" publishes the ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","isActive":true},{"text":" that just finished. Use it to chain","type":"text"},{"text":" ","type":"text"},{"text":"straight into the next item rather than dismissing the player:","type":"text"}],"type":"paragraph"},{"code":["player.itemDidEnd","    .receive(on: DispatchQueue.main)","    .sink { [weak self] finished in","        guard let next = self?.nextUp(after: finished) else { return }","        Task { await self?.switchTo(video: next) }","    }","    .store(in: &cancellables)"],"syntax":"swift","type":"codeListing"},{"anchor":"Handling-Failures","text":"Handling Failures","level":2,"type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true},{"text":" reports errors that surface after playback has begun, as","type":"text"},{"text":" ","type":"text"},{"text":"distinct from the error thrown by the ","type":"text"},{"code":"switchContent","type":"codeVoice"},{"text":" call itself:","type":"text"}],"type":"paragraph"},{"code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in","        self?.loadFailure = error.localizedDescription","    }","    .store(in: &cancellables)"],"syntax":"swift","type":"codeListing"},{"anchor":"Ads-and-Switching","type":"heading","level":2,"text":"Ads and Switching"},{"inlineContent":[{"text":"A schedule set through ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true,"type":"reference"},{"text":" belongs to the content it was scheduled","type":"text"},{"text":" ","type":"text"},{"text":"against and is cleared when the content changes. Schedule the new item’s breaks after the","type":"text"},{"text":" ","type":"text"},{"text":"switch completes — see ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/contentswitching"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"type":"text","text":"Move an existing player from one video to another without tearing it down."}],"kind":"article","metadata":{"roleHeading":"Article","role":"article","title":"Switching Content","modules":[{"name":"YBVRAppleSDK"}]},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},"schemaVersion":{"patch":0,"major":0,"minor":3},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"kind":"symbol","abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"url":"\/documentation\/ybvrapplesdk","type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","title":"YBVRAppleSDK","role":"collection"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/isSwitchingContent":{"kind":"symbol","abstract":[],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/isswitchingcontent","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"isSwitchingContent"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CurrentValueSubject","preciseIdentifier":"s:7Combine19CurrentValueSubjectC"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Never","preciseIdentifier":"s:s5NeverO"},{"kind":"text","text":">"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isSwitchingContent","title":"isSwitchingContent","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/startStream(video:_:)":{"role":"symbol","url":"\/documentation\/y