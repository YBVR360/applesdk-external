{"abstract":[{"type":"text","text":"Schedule ad breaks against the content timeline and drive your own ad UI."}],"metadata":{"role":"article","modules":[{"name":"YBVRAppleSDK"}],"title":"Inserting Ads","roleHeading":"Article"},"kind":"article","sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},"schemaVersion":{"major":0,"minor":3,"patch":0},"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"generated":true,"title":"Guides","anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/adinsertion"]}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController","type":"reference","isActive":true},{"type":"text","text":", reached through "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","type":"reference","isActive":true},{"type":"text","text":", inserts ad breaks as HLS"},{"type":"text","text":" "},{"type":"text","text":"interstitials. That has two consequences worth knowing up front:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"No manifest support is needed.","type":"text"}],"type":"strong"},{"type":"text","text":" The content playlist does not have to carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"EXT-X-DATERANGE"},{"type":"text","text":" tags — the cue points come from the schedule you supply."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"Resuming is seamless.","type":"text"}]},{"text":" The content item stays buffered across a break, so nothing of the","type":"text"},{"text":" ","type":"text"},{"text":"content is lost or skipped when an ad plays.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Ads require the HLS player. Low-latency RTMP streams have no interstitial","type":"text"},{"text":" ","type":"text"},{"text":"mechanism, and a schedule set on one is ignored.","type":"text"}]}],"name":"Important"},{"type":"heading","text":"Scheduling Breaks","anchor":"Scheduling-Breaks","level":2},{"type":"paragraph","inlineContent":[{"text":"Build an ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","isActive":true,"type":"reference"},{"type":"text","text":" from a cue point and the creatives to play there, then hand the whole"},{"type":"text","text":" "},{"type":"text","text":"schedule to "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","isActive":true},{"text":". Each call replaces the previous schedule:","type":"text"}]},{"type":"codeListing","code":["let breaks = [","    YBVRAdBreak(","        id: \"pre\",","        cue: .preRoll,","        creatives: [YBVRAdCreative(urlString: preRollURL)]","    ),","    YBVRAdBreak(","        id: \"mid-1\",","        cue: .midRoll(120),","        creatives: [","            YBVRAdCreative(urlString: firstInPodURL),","            YBVRAdCreative(urlString: secondInPodURL)","        ],","        skipAfter: 5","    ),","    YBVRAdBreak(","        id: \"post\",","        cue: .postRoll,","        creatives: [YBVRAdCreative(urlString: postRollURL)]","    )","]","","player.ads.schedule(breaks)"],"syntax":"swift"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCue","isActive":true},{"type":"text","text":" places the break: "},{"type":"codeVoice","code":".preRoll"},{"text":" before the content, ","type":"text"},{"type":"codeVoice","code":".midRoll(seconds)"},{"text":" at a point","type":"text"},{"text":" ","type":"text"},{"text":"on the content timeline, ","type":"text"},{"code":".postRoll","type":"codeVoice"},{"text":" after it. Listing several creatives in one break plays","type":"text"},{"type":"text","text":" "},{"text":"them back to back as a pod. Creatives with unusable URLs are dropped.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/skipAfter","type":"reference","isActive":true},{"type":"text","text":" sets how many seconds must play before the break can be skipped, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/maxDuration","isActive":true},{"text":" caps the break. ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/scheduled","isActive":true},{"type":"text","text":" reads back what is"},{"type":"text","text":" "},{"text":"currently scheduled, and ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()"},{"type":"text","text":" drops it — though a break already"},{"type":"text","text":" "},{"type":"text","text":"on screen plays to its end."}]},{"style":"note","type":"aside","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Schedules are per content item. Re-apply them after"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"type":"text","tex