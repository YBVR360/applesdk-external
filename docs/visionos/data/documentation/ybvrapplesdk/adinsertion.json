{"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"sections":[],"schemaVersion":{"patch":0,"major":0,"minor":3},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"title":"Guides","anchor":"Guides","generated":true}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController","isActive":true},{"type":"text","text":", reached through "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true},{"type":"text","text":", inserts ad breaks as HLS"},{"type":"text","text":" "},{"type":"text","text":"interstitials. That has two consequences worth knowing up front:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No manifest support is needed."}],"type":"strong"},{"type":"text","text":" The content playlist does not have to carry"},{"type":"text","text":" "},{"code":"EXT-X-DATERANGE","type":"codeVoice"},{"type":"text","text":" tags — the cue points come from the schedule you supply."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Resuming is seamless."}],"type":"strong"},{"type":"text","text":" The content item stays buffered across a break, so nothing of the"},{"type":"text","text":" "},{"type":"text","text":"content is lost or skipped when an ad plays."}]}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ads require the HLS player. Low-latency RTMP streams have no interstitial"},{"type":"text","text":" "},{"type":"text","text":"mechanism, and a schedule set on one is ignored."}]}],"style":"important","name":"Important"},{"level":2,"text":"Scheduling Breaks","type":"heading","anchor":"Scheduling-Breaks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build an "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","isActive":true},{"type":"text","text":" from a cue point and the creatives to play there, then hand the whole"},{"type":"text","text":" "},{"type":"text","text":"schedule to "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","isActive":true},{"type":"text","text":". Each call replaces the previous schedule:"}]},{"type":"codeListing","syntax":"swift","code":["let breaks = [","    YBVRAdBreak(","        id: \"pre\",","        cue: .preRoll,","        creatives: [YBVRAdCreative(urlString: preRollURL)]","    ),","    YBVRAdBreak(","        id: \"mid-1\",","        cue: .midRoll(120),","        creatives: [","            YBVRAdCreative(urlString: firstInPodURL),","            YBVRAdCreative(urlString: secondInPodURL)","        ],","        skipAfter: 5","    ),","    YBVRAdBreak(","        id: \"post\",","        cue: .postRoll,","        creatives: [YBVRAdCreative(urlString: postRollURL)]","    )","]","","player.ads.schedule(breaks)"]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCue","isActive":true},{"type":"text","text":" places the break: "},{"type":"codeVoice","code":".preRoll"},{"type":"text","text":" before the content, "},{"type":"codeVoice","code":".midRoll(seconds)"},{"type":"text","text":" at a point"},{"type":"text","text":" "},{"type":"text","text":"on the content timeline, "},{"type":"codeVoice","code":".postRoll"},{"type":"text","text":" after it. Listing several creatives in one break plays"},{"type":"text","text":" "},{"type":"text","text":"them back to back as a pod. Creatives with unusable URLs are dropped."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/skipAfter","isActive":true},{"type":"text","text":" sets how many seconds must play before the break can be skipped, and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/maxDuration","isActive":true},{"type":"text","text":" caps the break. "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/scheduled","isActive":true},{"type":"text","text":" reads back what is"},{"type":"text","text":" "},{"text":"currently scheduled, and ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()","isActive":true,"type":"reference"},{"text":" drops it — though a break already","type":"text"},{"text":" ","type":"text"},{"text":"on screen plays to its end.","type":"text"}]},{"type":"aside","content":[{"inlineContent":[{"type":"text","text":"Schedules are per content item. Re-apply them after"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true},{"type":"text","text":"; see "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"style":"note","name":"Note"},{"level":3,"text":"Immersive Creatives","type":"heading","anchor":"Immersive-Creatives"},{"type":"paragraph","inlineContent":[{"text":"A creative renders as a flat 2D panel by default. Pass ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative\/geometry","isActive":true,"type":"reference"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"creative authored for an immersive geometry, and the surface switches for that creative and is","type":"text"},{"text":" ","type":"text"},{"text":"restored to the content’s geometry when the break ends:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["YBVRAdCreative(urlString: sphericalAdURL, geometry: .nsEquirectangularMono)"]},{"level":2,"text":"Observing Ad Playback","type":"heading","anchor":"Observing-Ad-Playback"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playback","isActive":true,"type":"reference"},{"text":" carries a ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback","isActive":true,"type":"reference"},{"text":" while an ad is on screen and ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"while content plays — the simplest signal for “am I in an ad right now”:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["player.ads.playback","    .receive(on: DispatchQueue.main)","    .sink { [weak self] playback in","        self?.adPlayback = playback","        self?.isPlayingAd = playback != nil","    }","    .store(in: &cancellables)"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback","isActive":true,"type":"reference"},{"text":" names the ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","isActive":true,"type":"reference"},{"text":", the ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative","isActive":true,"type":"reference"},{"text":" on screen, and its index","type":"text"},{"text":" ","type":"text"},{"text":"within the pod — enough to render “Ad 2 of 3”.","type":"text"}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didBegin","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd","isActive":true,"type":"reference"},{"text":" fire once per break for","type":"text"},{"text":" ","type":"text"},{"text":"one-shot work such as hiding your transport controls:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["player.ads.didBegin","    .receive(on: DispatchQueue.main)","    .sink { [weak self] _ in self?.hideControls() }","    .store(in: &cancellables)"]},{"level":3,"text":"Progress and Skipping","type":"heading","anchor":"Progress-and-Skipping"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration","isActive":true},{"type":"text","text":" track progress through the ad"},{"type":"text","text":" "},{"text":"on screen, in seconds, and are zero outside a break. Progress is break-relative when the break","type":"text"},{"text":" ","type":"text"},{"text":"declares a ","type":"text"},{"type":"codeVoice","code":"maxDuration"},{"text":" and creative-relative otherwise.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive a skip button from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn"},{"type":"text","text":", and call"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()"},{"text":" to act on it:","type":"text"}]},{"code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"cancelCurrentBreak()"},{"type":"text","text":" abandons the break and resumes the content where it was interrupted —"},{"type":"text","text":" "},{"type":"text","text":"no content is skipped. It returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when refused because the break’s "},{"type":"codeVoice","code":"skipAfter"},{"type":"text","text":" offset"},{"type":"text","text":" "},{"type":"text","text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the"},{"type":"text","text":" "},{"type":"text","text":"button’s enabled state to "},{"type":"codeVoice","code":"canSkip"},{"type":"text","text":" keeps the two in step."}],"type":"paragraph"},{"level":3,"type":"heading","text":"Seeks and Missed Mid-Rolls","anchor":"Seeks-and-Missed-Mid-Rolls"},{"type":"paragraph","inlineContent":[{"text":"Interstitials fire when playback ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"crosses"}]},{"text":" a cue point, so a seek can jump over one. By","type":"text"},{"type":"text","text":" "},{"type":"text","text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last"},{"type":"text","text":" "},{"type":"text","text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["player.ads.playsMissedMidRollsOnSeek = false"]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while an ad re-armed by a seek is being fetched but"},{"type":"text","text":" "},{"type":"text","text":"has not yet reached the screen — a good cue for a brief spinner."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true},{"type":"text","text":" reports the breaks that have already played or been skipped,"},{"text":" ","type":"text"},{"type":"text","text":"which is what you need to draw timeline markers that distinguish consumed breaks from"},{"type":"text","text":" "},{"text":"upcoming ones.","type":"text"}],"type":"paragraph"},{"level":3,"anchor":"Resuming-a-Session-on-Another-Player","type":"heading","text":"Resuming a Session on Another Player"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Which breaks have played lives in the manager that played them, and a schedule is armed"},{"text":" ","type":"text"},{"type":"text","text":"against the content that manager opened. Resuming the same content on a "},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"text":" manager —","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed"},{"type":"text","text":" "},{"text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up","type":"text"},{"text":" ","type":"text"},{"text":"above reads as a viewer skipping them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Carry the ids across and hand them over before the new manager opens its stream:"}]},{"syntax":"swift","code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","isActive":true},{"type":"text","text":" drops those breaks from the schedule and takes them out of"},{"type":"text","text":" "},{"type":"text","text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine"},{"type":"text","text":" "},{"type":"text","text":"content switch still plays its ads. See "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"abstract":[{"text":"Schedule ad breaks against the content timeline and drive your own ad UI.","type":"text"}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/adinsertion"],"traits":[{"interfaceLanguage":"swift"}]}],"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"title":"Inserting Ads","roleHeading":"Article","role":"article"},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController":{"abstract":[{"text":"Breaks are inserted as HLS interstitials, which means:","type":"text"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController","role":"symbol","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller","kind":"symbol","fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"YBVRAdController"}],"navigatorTitle":[{"kind":"identifier","text":"YBVRAdController"}],"title":"YBVRAdController","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/schedule(_:)