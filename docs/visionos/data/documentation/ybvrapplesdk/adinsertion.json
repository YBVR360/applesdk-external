,"inlineContent":[{"type":"text","text":"Drive a skip button from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip"},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn"},{"type":"text","text":", and call"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()"},{"text":" to act on it:","type":"text"}]},{"syntax":"swift","code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"],"type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"cancelCurrentBreak()"},{"type":"text","text":" abandons the break and resumes the content where it was interrupted —"},{"type":"text","text":" "},{"text":"no content is skipped. It returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" when refused because the break’s ","type":"text"},{"code":"skipAfter","type":"codeVoice"},{"text":" offset","type":"text"},{"text":" ","type":"text"},{"text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the","type":"text"},{"text":" ","type":"text"},{"text":"button’s enabled state to ","type":"text"},{"code":"canSkip","type":"codeVoice"},{"text":" keeps the two in step.","type":"text"}],"type":"paragraph"},{"text":"Seeks and Missed Mid-Rolls","anchor":"Seeks-and-Missed-Mid-Rolls","level":3,"type":"heading"},{"inlineContent":[{"text":"Interstitials fire when playback ","type":"text"},{"inlineContent":[{"type":"text","text":"crosses"}],"type":"emphasis"},{"text":" a cue point, so a seek can jump over one. By","type":"text"},{"text":" ","type":"text"},{"text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last","type":"text"},{"type":"text","text":" "},{"type":"text","text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["player.ads.playsMissedMidRollsOnSeek = false"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","type":"reference","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while an ad re-armed by a seek is being fetched but"},{"type":"text","text":" "},{"type":"text","text":"has not yet reached the screen — a good cue for a brief spinner."},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","type":"reference","isActive":true},{"text":" reports the breaks that have already played or been skipped,","type":"text"},{"text":" ","type":"text"},{"text":"which is what you need to draw timeline markers that distinguish consumed breaks from","type":"text"},{"text":" ","type":"text"},{"text":"upcoming ones.","type":"text"}]},{"anchor":"Resuming-a-Session-on-Another-Player","level":3,"text":"Resuming a Session on Another Player","type":"heading"},{"inlineContent":[{"text":"Which breaks have played lives in the manager that played them, and a schedule is armed","type":"text"},{"text":" ","type":"text"},{"text":"against the content that manager opened. Resuming the same content on a ","type":"text"},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"text":" manager —","type":"text"},{"text":" ","type":"text"},{"text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed","type":"text"},{"text":" ","type":"text"},{"text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up","type":"text"},{"text":" ","type":"text"},{"text":"above reads as a viewer skipping them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Carry the ids across and hand them over before the new manager opens its stream:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","type":"reference","isActive":true},{"text":" drops those breaks from the schedule and takes them out of","type":"text"},{"text":" ","type":"text"},{"text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine","type":"text"},{"text":" ","type":"text"},{"text":"content switch still plays its ads. See ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","type":"reference","isActive":true},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/clearSchedule()":{"title":"clearSchedule()","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/clearschedule()","abstract":[{"type":"text","text":"Drop the schedule. A break already on screen plays to its end - use"},{"type":"text","text":" "},{"type":"codeVoice","code":"cancelCurrentBreak()"},{"type":"text","text":" to end that one."}],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearSchedule","kind":"identifier"},{"text":"()","kind":"t