{"abstract":[{"type":"text","text":"Schedule ad breaks against the content timeline and drive your own ad UI."}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/adinsertion"]}],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController","isActive":true,"type":"reference"},{"text":", reached through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads"},{"text":", inserts ad breaks as HLS","type":"text"},{"text":" ","type":"text"},{"text":"interstitials. That has two consequences worth knowing up front:","type":"text"}]},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"No manifest support is needed.","type":"text"}],"type":"strong"},{"type":"text","text":" The content playlist does not have to carry"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EXT-X-DATERANGE"},{"text":" tags — the cue points come from the schedule you supply.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Resuming is seamless.","type":"text"}]},{"type":"text","text":" The content item stays buffered across a break, so nothing of the"},{"text":" ","type":"text"},{"text":"content is lost or skipped when an ad plays.","type":"text"}]}]}],"type":"unorderedList"},{"name":"Important","style":"important","type":"aside","content":[{"inlineContent":[{"text":"Ads require the HLS player. Low-latency RTMP streams have no interstitial","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"mechanism, and a schedule set on one is ignored."}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Scheduling Breaks","anchor":"Scheduling-Breaks"},{"type":"paragraph","inlineContent":[{"text":"Build an ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","isActive":true,"type":"reference"},{"text":" from a cue point and the creatives to play there, then hand the whole","type":"text"},{"text":" ","type":"text"},{"text":"schedule to ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","type":"reference"},{"text":". Each call replaces the previous schedule:","type":"text"}]},{"syntax":"swift","code":["let breaks = [","    YBVRAdBreak(","        id: \"pre\",","        cue: .preRoll,","        creatives: [YBVRAdCreative(urlString: preRollURL)]","    ),","    YBVRAdBreak(","        id: \"mid-1\",","        cue: .midRoll(120),","        creatives: [","            YBVRAdCreative(urlString: firstInPodURL),","            YBVRAdCreative(urlString: secondInPodURL)","        ],","        skipAfter: 5","    ),","    YBVRAdBreak(","        id: \"post\",","        cue: .postRoll,","        creatives: [YBVRAdCreative(urlString: postRollURL)]","    )","]","","player.ads.schedule(breaks)"],"type":"codeListing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCue"},{"text":" places the break: ","type":"text"},{"code":".preRoll","type":"codeVoice"},{"text":" before the content, ","type":"text"},{"code":".midRoll(seconds)","type":"codeVoice"},{"text":" at a point","type":"text"},{"text":" ","type":"text"},{"text":"on the content timeline, ","type":"text"},{"code":".postRoll","type":"codeVoice"},{"text":" after it. Listing several creatives in one break plays","type":"text"},{"text":" ","type":"text"},{"text":"them back to back as a pod. Creatives with unusable URLs are dropped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/skipAfter"},{"text":" sets how many seconds must play before the break can be skipped, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/maxDuration"},{"text":" caps the break. ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/scheduled","isActive":true,"type":"reference"},{"text":" reads back what is","type":"text"},{"text":" ","type":"text"},{"text":"currently scheduled, and ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()","isActive":true,"type":"reference"},{"text":" drops it — though a break already","type":"text"},{"text":" ","type":"text"},{"text":"on screen plays to its end.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Schedules are per content item. Re-apply them after","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"text":"; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},{"text":".","type":"text"}]}],"style":"note","type":"aside","name":"Note"},{"text":"Immersive Creatives","type":"heading","level":3,"anchor":"Immersive-Creatives"},{"inlineContent":[{"text":"A creative renders as a flat 2D panel by default. Pass ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative\/geometry"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"creative authored for an immersive geometry, and the surface switches for that creative and is","type":"text"},{"text":" ","type":"text"},{"text":"restored to the content’s geometry when the break ends:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["YBVRAdCreative(urlString: sphericalAdURL, geometry: .nsEquirectangularMono)"],"type":"codeListing"},{"text":"Observing Ad Playback","type":"heading","level":2,"anchor":"Observing-Ad-Playback"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playback"},{"text":" carries a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback"},{"text":" while an ad is on screen and ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"while content plays — the simplest signal for “am I in an ad right now”:","type":"text"}]},{"syntax":"swift","code":["player.ads.playback","    .receive(on: DispatchQueue.main)","    .sink { [weak self] playback in","        self?.adPlayback = playback","        self?.isPlayingAd = playback != nil","    }","    .store(in: &cancellables)"],"type":"codeListing"},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback"},{"text":" names the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak"},{"text":", the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative"},{"text":" on screen, and its index","type":"text"},{"text":" ","type":"text"},{"text":"within the pod — enough to render “Ad 2 of 3”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didBegin"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd"},{"text":" fire once per break for","type":"text"},{"text":" ","type":"text"},{"text":"one-shot work such as hiding your transport controls:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["player.ads.didBegin","    .receive(on: DispatchQueue.main)","    .sink { [weak self] _ in self?.hideControls() }","    .store(in: &cancellables)"],"type":"codeListing"},{"text":"Progress and Skipping","type":"heading","level":3,"anchor":"Progress-and-Skipping"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration"},{"text":" track progress through the ad","type":"text"},{"text":" ","type":"text"},{"text":"on screen, in seconds, and are zero outside a break. Progress is break-relative when the break","type":"text"},{"type":"text","text":" "},{"type":"text","text":"declares a "},{"type":"codeVoice","code":"maxDuration"},{"type":"text","text":" and creative-relative otherwise."}],"type":"paragraph"},{"inlineContent":[{"text":"Drive a skip button from ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn","isActive":true},{"type":"text","text":", and call"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()","isActive":true},{"type":"text","text":" to act on it:"}],"type":"paragraph"},{"code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"codeVoice","code":"cancelCurrentBreak()"},{"type":"text","text":" abandons the break and resumes the content where it was interrupted —"},{"type":"text","text":" "},{"type":"text","text":"no content is skipped. It returns "},{"type":"codeVoice","code":"false"},{"text":" when refused because the break’s ","type":"text"},{"type":"codeVoice","code":"skipAfter"},{"text":" offset","type":"text"},{"text":" ","type":"text"},{"text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the","type":"text"},{"type":"text","text":" "},{"type":"text","text":"button’s enabled state to "},{"code":"canSkip","type":"codeVoice"},{"type":"text","text":" keeps the two in step."}],"type":"paragraph"},{"anchor":"Seeks-and-Missed-Mid-Rolls","text":"Seeks and Missed Mid-Rolls","type":"heading","level":3},{"inlineContent":[{"text":"Interstitials fire when playback ","type":"text"},{"type":"emphasis","inlineContent":[{"type":"text","text":"crosses"}]},{"type":"text","text":" a cue point, so a seek can jump over one. By"},{"type":"text","text":" "},{"type":"text","text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last"},{"type":"text","text":" "},{"type":"text","text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["player.ads.playsMissedMidRollsOnSeek = false"]},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while an ad re-armed by a seek is being fetched but"},{"type":"text","text":" "},{"type":"text","text":"has not yet reached the screen — a good cue for a brief spinner."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true},{"type":"text","text":" reports the breaks that have already played or been skipped,"},{"type":"text","text":" "},{"text":"which is what you need to draw timeline markers that distinguish consumed breaks from","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"upcoming ones."}],"type":"paragraph"},{"text":"Resuming a Session on Another Player","type":"heading","level":3,"anchor":"Resuming-a-Session-on-Another-Player"},{"inlineContent":[{"text":"Which breaks have played lives in the manager that played them, and a schedule is armed","type":"text"},{"text":" ","type":"text"},{"text":"against the content that manager opened. Resuming the same content on a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"type":"text","text":" manager —"},{"type":"text","text":" "},{"type":"text","text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed"},{"type":"text","text":" "},{"text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up","type":"text"},{"type":"text","text":" "},{"type":"text","text":"above reads as a viewer skipping them."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Carry the ids across and hand them over before the new manager opens its stream:"}],"type":"paragraph"},{"syntax":"swift","code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","isActive":true},{"text":" drops those breaks from the schedule and takes them out of","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine"},{"type":"text","text":" "},{"type":"text","text":"content switch still plays its ads. See "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","isActive":true},{"type":"text","text":"."}],"type":"paragraph"}],"kind":"content"}],"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"anchor":"Guides","generated":true,"title":"Guides"}],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","interfaceLanguage":"swift"},"metadata":{"role":"article","modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article","title":"Inserting Ads"},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/markPlayed(_:)":{"url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/markplayed(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"markPlayed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">)","kind":"text"}],"abstract":[],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","kind":"symbol","role":"symbol","title":"markPlay