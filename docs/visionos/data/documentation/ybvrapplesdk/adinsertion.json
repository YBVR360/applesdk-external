\/YBVRAdPlayback"},{"type":"text","text":" names the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak"},{"type":"text","text":", the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative"},{"type":"text","text":" on screen, and its index"},{"type":"text","text":" "},{"type":"text","text":"within the pod — enough to render “Ad 2 of 3”."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didBegin","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd"},{"type":"text","text":" fire once per break for"},{"text":" ","type":"text"},{"type":"text","text":"one-shot work such as hiding your transport controls:"}]},{"syntax":"swift","type":"codeListing","code":["player.ads.didBegin","    .receive(on: DispatchQueue.main)","    .sink { [weak self] _ in self?.hideControls() }","    .store(in: &cancellables)"]},{"anchor":"Progress-and-Skipping","level":3,"text":"Progress and Skipping","type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration","isActive":true,"type":"reference"},{"text":" track progress through the ad","type":"text"},{"text":" ","type":"text"},{"text":"on screen, in seconds, and are zero outside a break. Progress is break-relative when the break","type":"text"},{"text":" ","type":"text"},{"text":"declares a ","type":"text"},{"code":"maxDuration","type":"codeVoice"},{"text":" and creative-relative otherwise.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Drive a skip button from ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn","isActive":true,"type":"reference"},{"text":", and call","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()","isActive":true,"type":"reference"},{"text":" to act on it:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"]},{"type":"paragraph","inlineContent":[{"code":"cancelCurrentBreak()","type":"codeVoice"},{"text":" abandons the break and resumes the content where it was interrupted —","type":"text"},{"text":" ","type":"text"},{"text":"no content is skipped. It returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" when refused because the break’s ","type":"text"},{"code":"skipAfter","type":"codeVoice"},{"text":" offset","type":"text"},{"text":" ","type":"text"},{"text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the","type":"text"},{"text":" ","type":"text"},{"text":"button’s enabled state to ","type":"text"},{"code":"canSkip","type":"codeVoice"},{"text":" keeps the two in step.","type":"text"}]},{"text":"Seeks and Missed Mid-Rolls","type":"heading","level":3,"anchor":"Seeks-and-Missed-Mid-Rolls"},{"type":"paragraph","inlineContent":[{"text":"Interstitials fire when playback ","type":"text"},{"inlineContent":[{"type":"text","text":"crosses"}],"type":"emphasis"},{"text":" a cue point, so a seek can jump over one. By","type":"text"},{"text":" ","type":"text"},{"text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last","type":"text"},{"text":" ","type":"text"},{"text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["player.ads.playsMissedMidRollsOnSeek = false"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" while an ad re-armed by a seek is being fetched but","type":"text"},{"text":" ","type":"text"},{"text":"has not yet reached the screen — a good cue for a brief spinner.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true,"type":"reference"},{"text":" reports the breaks that have already played or been skipped,","type":"text"},{"text":" ","type":"text"},{"text":"which is what you need to draw timeline markers that distinguish consumed breaks from","type":"text"},{"text":" ","type":"text"},{"text":"upcoming ones.","type":"text"}]},{"text":"Resuming a Session on Another Player","type":"heading","level":3,"anchor":"Resuming-a-Session-on-Another-Player"},{"type":"paragraph","inlineContent":[{"text":"Which breaks have played lives in the manager that played them, and a schedule is armed","type":"text"},{"text":" ","type":"text"},{"text":"against the content that manager opened. Resuming the same content on a ","type":"text"},{"inlineContent":[{"type":"text","text":"new"}],"type":"emphasis"},{"text":" manager —","type":"text"},{"text":" ","type":"text"},{"text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed","type":"text"},{"text":" ","type":"text"},{"text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up","type":"text"},{"text":" ","type":"text"},{"text":"above reads as a viewer skipping them.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Carry the ids across and hand them over before the new manager opens its stream:"}],"type":"paragraph"},{"code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","isActive":true,"type":"reference"},{"type":"text","text":" drops those breaks from the schedule and takes them out of"},{"type":"text","text":" "},{"type":"text","text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine"},{"text":" ","type":"text"},{"type":"text","text":"content switch still plays its ads. See "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/switchContent(to:_:)":{"type":"topic","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"switchContent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK5VideoV","text":"Video"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK18SignalingInterfaceP","text":"SignalingInterface"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":