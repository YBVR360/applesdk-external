{"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions\/accessibleWhenPasscodeSetThisDeviceOnly","interfaceLanguage":"swift"},"abstract":[{"text":"The data in the keychain can only be accessed when the device is unlocked. Only available if a passcode is set on the device.","type":"text"}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibleWhenPasscodeSetThisDeviceOnly"}],"platforms":["visionOS"]}]},{"kind":"content","content":[{"level":2,"text":"Discussion","anchor":"discussion","type":"heading"},{"inlineContent":[{"text":"This is recommended for items that only need to be accessible while the application is in the foreground. Items with this attribute never migrate to a new device. After a backup is restored to a new device, these items are missing. No items can be stored in this class on devices without a passcode. Disabling the device passcode causes all items in this class to be deleted.","type":"text"}],"type":"paragraph"}]}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/keychainswiftaccessoptions\/accessiblewhenpasscodesetthisdeviceonly"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions"]]},"metadata":{"fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibleWhenPasscodeSetThisDeviceOnly"}],"modules":[{"name":"YBVRAppleSDK"}],"externalID":"s:12YBVRAppleSDK26KeychainSwiftAccessOptionsO39accessibleWhenPasscodeSetThisDeviceOnlyyA2CmF","role":"symbol","roleHeading":"Case","symbolKind":"case","title":"KeychainSwiftAccessOptions.accessibleWhenPasscodeSetThisDeviceOnly"},"kind":"symbol","references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/KeychainSwiftAccessOptions/accessibleWhenPasscodeSetThisDeviceOnly":{"title":"KeychainSwiftAccessOptions.accessibleWhenPasscodeSetThisDeviceOnly","role":"symbol","abstract":[{"type":"text","text":"The data in the keychain can only be accessed when the device is unlocked. Only available if a passcode is set on the device."}],"fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibleWhenPasscodeSetThisDeviceOnly"}],"kind":"symbol","type":"topic","url":"\/documentation\/ybvrapplesdk\/keychainswiftaccessoptions\/accessiblewhenpasscodesetthisdeviceonly","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions\/accessibleWhenPasscodeSetThisDeviceOnly"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/KeychainSwiftAccessOptions":{"title":"KeychainSwiftAccessOptions","kind":"symbol","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions","type":"topic","abstract":[],"url":"\/documentation\/ybvrapplesdk\/keychainswiftaccessoptions","fragments":[{"text":"enum","kind":"keyword"},{"text":" ","kind":"text"},{"text":"KeychainSwiftAccessOptions","kind":"identifier"}],"navigatorTitle":[{"text":"KeychainSwiftAccessOptions","kind":"identifier"}],"role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"type":"topic","title":"YBVRAppleSDK","url":"\/documentation\/ybvrapplesdk","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","kind":"symbol","role":"collection","abstract":[{"text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS.","type":"text"}]}}}