{"abstract":[{"type":"text","text":"The data in the keychain can only be accessed when the device is unlocked. Only available if a passcode is set on the device."}],"schemaVersion":{"major":0,"minor":3,"patch":0},"kind":"symbol","primaryContentSections":[{"kind":"declarations","declarations":[{"platforms":["visionOS"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibleWhenPasscodeSetThisDeviceOnly"}]}]},{"kind":"content","content":[{"text":"Discussion","type":"heading","anchor":"discussion","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"This is recommended for items that only need to be accessible while the application is in the foreground. Items with this attribute never migrate to a new device. After a backup is restored to a new device, these items are missing. No items can be stored in this class on devices without a passcode. Disabling the device passcode causes all items in this class to be deleted."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/keychainswiftaccessoptions\/accessiblewhenpasscodesetthisdeviceonly"]}],"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions\/accessibleWhenPasscodeSetThisDeviceOnly"},"metadata":{"externalID":"s:12YBVRAppleSDK26KeychainSwiftAccessOptionsO39accessibleWhenPasscodeSetThisDeviceOnlyyA2CmF","role":"symbol","symbolKind":"case","roleHeading":"Case","title":"KeychainSwiftAccessOptions.accessibleWhenPasscodeSetThisDeviceOnly","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibleWhenPasscodeSetThisDeviceOnly"}],"modules":[{"name":"YBVRAppleSDK"}]},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions"]]