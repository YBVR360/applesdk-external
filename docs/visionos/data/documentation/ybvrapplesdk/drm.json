{"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"title":"FairPlay DRM","role":"article","roleHeading":"Article"},"sections":[],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"],"title":"Related Documentation","anchor":"Related-Documentation"},{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"],"generated":true,"title":"Guides","anchor":"Guides"}],"abstract":[{"type":"text","text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is."}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"text":"The SDK plays FairPlay-protected HLS through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","type":"reference"},{"text":" — the thin wrapper around","type":"text"},{"text":" ","type":"text"},{"text":"AVFoundation that skips the YBVR signaling and geometry stack. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline behind ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","type":"reference"},{"text":" and the immersive renderers, has no DRM path at all:","type":"text"},{"text":" ","type":"text"},{"text":"nothing in it accepts a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig","type":"reference"},{"text":", so a protected stream opened through it fails to","type":"text"},{"text":" ","type":"text"},{"text":"decrypt.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"That split is not an oversight waiting to be wired up. It follows from how protected frames","type":"text"},{"text":" ","type":"text"},{"text":"reach the screen, which is covered below, and it decides which content can carry DRM at all.","type":"text"}]},{"type":"heading","text":"Where DRM Can Be Used","anchor":"Where-DRM-Can-Be-Used","level":2},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"text":"Playback path","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"How frames reach the screen","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Protected content","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer"},{"text":" on iOS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"AVPlayerLayer"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer"},{"text":" on visionOS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"RealityKit ","type":"text"},{"type":"codeVoice","code":"VideoPlayerComponent"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Yes, on device only","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" + ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Metal, from ","type":"text"},{"type":"codeVoice","code":"AVPlayerItemVideoOutput"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"VisionSurfaceContext"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Metal, via Compositor Services","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" + ","type":"text"},{"type":"codeVoice","code":"VideoPlayerComponentSurfaceContext"}],"type":"paragraph"}],[{"inlineContent":[{"text":"RealityKit ","type":"text"},{"type":"codeVoice","code":"VideoPlayerComponent"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Not available — no API to supply a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"The rule behind the table: FairPlay decodes into a protected path that the system can","type":"text"},{"text":" ","type":"text"},{"text":"composite but the app cannot read. Surfaces that hand the ","type":"text"},{"code":"AVPlayer","type":"codeVoice"},{"text":" to the system — an","type":"text"},{"text":" ","type":"text"},{"code":"AVPlayerLayer","type":"codeVoice"},{"text":", or a RealityKit ","type":"text"},{"code":"VideoPlayerComponent","type":"codeVoice"},{"text":" — therefore play protected content","type":"text"},{"text":" ","type":"text"},{"text":"fine. The YBVR geometry renderers do the opposite: they copy each decoded frame out with","type":"text"},{"text":" ","type":"text"},{"code":"AVPlayerItemVideoOutput.copyPixelBuffer","type":"codeVoice"},{"text":" and draw it onto a sphere, dome, fisheye, flat","type":"text"},{"text":" ","type":"text"},{"text":"panel, or control-room composition. No frames are handed out for protected content, so there","type":"text"},{"text":" ","type":"text"},{"text":"is nothing to texture the geometry with.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In content terms:","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"DRM is possible"}],"type":"strong"},{"text":" for material that plays as an ordinary AVFoundation item: flat or","type":"text"},{"text":" ","type":"text"},{"text":"rectilinear video, and immersive video whose projection is described by embedded metadata","type":"text"},{"text":" ","type":"text"},{"text":"the system itself understands (APMP, spatial, and the equirectangular kinds AVFoundation","type":"text"},{"text":" ","type":"text"},{"text":"recognises), which ","type":"text"},{"code":"DirectPlayerImmersiveScene","type":"codeVoice"},{"text":" in the visionOS demo app projects onto a","type":"text"},{"text":" ","type":"text"},{"code":"VideoPlayerComponent","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"DRM is not possible"}],"type":"strong"},{"text":" for anything that depends on YBVR-side rendering: custom geometry","type":"text"},{"text":" ","type":"text"},{"text":"from the signaling file, viewport-tiled streams, multi-camera control rooms, or camera","type":"text"},{"text":" ","type":"text"},{"text":"switching inside a single stream. Those need the pixel buffers FairPlay withholds.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"DRM is not possible over RTMP."}],"type":"strong"},{"text":" Low-latency streams play through ","type":"text"},{"code":"LowLatencyPlayer","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which is not AVFoundation-based and has no FairPlay path, so a ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" block on an RTMP","type":"text"},{"text":" ","type":"text"},{"text":"stream is reported but cannot be honoured.","type":"text"}]}]}],"type":"unorderedList"},{"type":"heading","text":"Configuring DRM","anchor":"Configuring-DRM","level":2},{"type":"paragraph","inlineContent":[{"text":"The signaling file identifies the key; the certificate and license endpoints come from the","type":"text"},{"text":" ","type":"text"},{"text":"host app. Both halves are required — a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","type":"reference"},{"text":" on its own does not configure","type":"text"},{"text":" ","type":"text"},{"text":"anything.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let player = DirectPlayer()","","player.drmConfig = DrmConfig(","    certificateURL: \"https:\/\/...\/fairplay.cer\",","    licenseURL: \"https:\/\/...\/AcquireLicense\",","    drmKeyManager: keyManager",")","","await player.open(url: streamURL)"]},{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/drmConfig","type":"reference"},{"text":" before ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/open(url:)","type":"reference"},{"text":". Assigning it builds the","type":"text"},{"text":" ","type":"text"},{"code":"DrmManager","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"open","type":"codeVoice"},{"text":" installs the platform key handler around the new item — on visionOS","type":"text"},{"text":" ","type":"text"},{"text":"the content key session is created there — so a config assigned afterwards does not apply to","type":"text"},{"text":" ","type":"text"},{"text":"the item already loaded.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When the stream follows the convention of a sibling signaling file, the two steps collapse","type":"text"},{"text":" ","type":"text"},{"text":"into one call that fetches the key material and opens the stream:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["try await player.open(","    url: streamURL,","    fetchingDrmFromSignalingWith: certificateURL,","    licenseURL: licenseURL",")"]},{"type":"heading","text":"Providers","anchor":"Providers","level":3},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager\/provider","type":"reference"},{"text":" selects the license flow: ","type":"text"},{"code":"\"axinom\"","type":"codeVoice"},{"text":" and ","type":"text"},{"code":"\"ybvr\"","type":"codeVoice"},{"text":" are recognised,","type":"text"},{"text":" ","type":"text"},{"text":"and any other value falls back to Axinom. Both currently resolve to the Axinom provider,","type":"text"},{"text":" ","type":"text"},{"text":"which mints a license JWT and sends it as ","type":"text"},{"code":"X-AxDRM-Message","type":"codeVoice"},{"text":" with the SPC.","type":"text"}]},{"style":"important","type":"aside","content":[{"inlineContent":[{"text":"That JWT is minted by ","type":"text"},{"type":"codeVoice","code":"DrmJWTRequest"},{"text":" against a hardcoded development XMS","type":"text"},{"text":" ","type":"text"},{"text":"backend, using OAuth client credentials compiled into the SDK. DRM therefore only works","type":"text"},{"text":" ","type":"text"},{"text":"today against that one environment, and the credentials ship inside any binary that links","type":"text"},{"text":" ","type":"text"},{"text":"the SDK. Treat production DRM as needing this made configurable first.","type":"text"}],"type":"paragraph"}],"name":"Important"},{"text":"How DRM Is Detected","anchor":"How-DRM-Is-Detected","level":2,"type":"heading"},{"inlineContent":[{"text":"Detection runs entirely off the signaling file, before playback starts. Nothing inspects the","type":"text"},{"text":" ","type":"text"},{"text":"media playlist, so an encrypted stream whose signaling omits ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" is indistinguishable from","type":"text"},{"text":" ","type":"text"},{"text":"clear content until AVFoundation asks for a key and fails.","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","type":"reference","isActive":true},{"type":"text","text":" resolves the signaling version from the"},{"type":"text","text":" "},{"type":"text","text":"video URL: a path containing "},{"code":"_signaling_v4.json","type":"codeVoice"},{"type":"text","text":" is v4, any other "},{"code":".json","type":"codeVoice"},{"type":"text","text":" path is v3, and"},{"type":"text","text":" "},{"type":"text","text":"a media URL is v2 — where the signaling file is the same URL with its extension swapped"},{"type":"text","text":" "},{"type":"text","text":"for "},{"code":".json","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The response is decoded into "},{"code":"Signaling","type":"codeVoice"},{"type":"text","text":" (v2), "},{"code":"SignalingV3","type":"codeVoice"},{"type":"text","text":", or "},{"code":"SignalingV4","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The caller asks the result for "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","type":"reference","isActive":true},{"type":"text","text":". A non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","type":"reference","isActive":true},{"type":"text","text":" means the content is protected, and both demo apps route it to"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","type":"reference","isActive":true},{"type":"text","text":" on that basis."}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"text":"Content with no ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" key — or with ","type":"text"},{"code":"\"drm\": null","type":"codeVoice"},{"text":" — is simply unprotected. The signaling","type":"text"},{"text":" ","type":"text"},{"text":"decodes normally, no DRM is reported, and the stream plays through the usual geometry","type":"text"},{"text":" ","type":"text"},{"text":"pipeline; this is the ordinary case for every clear title.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Decoding the block requires all three of ","type":"text"},{"code":"ekid","type":"codeVoice"},{"text":", ","type":"text"},{"code":"keyManagerUrl","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"drmProvider","type":"codeVoice"},{"text":". A block","type":"text"},{"text":" ","type":"text"},{"text":"that is present but missing any of them is dropped on every signaling version, leaving the","type":"text"},{"text":" ","type":"text"},{"text":"stream playable but reported as clear — so genuinely protected content then fails later at key","type":"text"},{"text":" ","type":"text"},{"text":"time with an opaque AVFoundation error rather than a DRM-specific one. Validate the block when","type":"text"},{"text":" ","type":"text"},{"text":"publishing. v4 logs the dropped block; v2 and v3 discard it silently.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"What each version reports today:","type":"text"}],"type":"paragraph"},{"rows":[[[{"inlineContent":[{"text":"Signaling version","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"drm","type":"codeVoice"},{"text":" in the file","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Reported by ","type":"text"},{"code":"drmKeyManager()","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"v2","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decoded","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The key manager","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"v3","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decoded","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The key manager","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"v4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decoded","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The key manager","type":"text"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"A signaling model that decodes ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" but does not implement","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","isActive":true},{"text":" inherits the protocol’s default of ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"silently reports protected content as clear — nothing fails to compile. ","type":"text"},{"code":"SignalingV4","type":"codeVoice"},{"text":" did","type":"text"},{"text":" ","type":"text"},{"text":"exactly that until its accessor was added, so DRM-protected v4 streams were routed to the","type":"text"},{"text":" ","type":"text"},{"text":"geometry pipeline where they cannot decrypt. Any new signaling version must implement that","type":"text"},{"text":" ","type":"text"},{"text":"requirement, and ","type":"text"},{"code":"SignalingDrmTests","type":"codeVoice"},{"text":" asserts detection through the protocol rather than the","type":"text"},{"text":" ","type":"text"},{"text":"concrete type to keep the path covered.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"Outside the manager, ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/fetchDrmKeyManager(forStreamURL:session:)","type":"reference"},{"text":" performs the","type":"text"},{"text":" ","type":"text"},{"text":"same lookup standalone: it swaps the stream URL’s extension for ","type":"text"},{"code":".json","type":"codeVoice"},{"text":", decodes the v2 shape,","type":"text"},{"text":" ","type":"text"},{"text":"and throws ","type":"text"},{"code":"DirectPlayerDrmError.noDrmInfoInSignaling","type":"codeVoice"},{"text":" when no ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" entry is present.","type":"text"}],"type":"paragraph"},{"text":"Platform Differences","anchor":"Platform-Differences","level":2,"type":"heading"},{"inlineContent":[{"text":"The SDK ships for iOS 17+ and visionOS 26+, and each uses the key-delivery API available to it.","type":"text"},{"text":" ","type":"text"},{"text":"Both share the same certificate fetch, license exchange, and ","type":"text"},{"code":"DrmProvider","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"type":"text","text":" uses the classic "},{"code":"skd:\/\/","type":"codeVoice"},{"type":"text","text":" resource-loader flow. "},{"code":"ApplePlayer","type":"codeVoice"},{"type":"text","text":" sets itself as the"},{"type":"text","text":" "},{"type":"text","text":"asset’s "},{"code":"AVAssetResourceLoaderDelegate","type":"codeVoice"},{"type":"text","text":" for every stream, protected or not, and forwards"},{"type":"text","text":" "},{"type":"text","text":"key requests to "},{"code":"DrmManager","type":"codeVoice"},{"type":"text","text":" only when a config was supplied. Without one the request goes"},{"type":"text","text":" "},{"type":"text","text":"unanswered and playback fails."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"visionOS"}],"type":"strong"},{"type":"text","text":" has never supported that flow and uses"},{"type":"text","text":" "},{"code":"AVContentKeySession(keySystem: .fairPlayStreaming)","type":"codeVoice"},{"type":"text","text":" with an "},{"code":"AVContentKeySessionDelegate","type":"codeVoice"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The session is built during "},{"code":"open","type":"codeVoice"},{"type":"text","text":" only when a config is present."}],"type":"paragraph"}]}],"type":"unorderedList"},{"style":"note","name":"Note","content":[{"inlineContent":[{"text":"FairPlay needs the Secure Enclave, so it does not work in the visionOS simulator —","type":"text"},{"text":" ","type":"text"},{"text":"constructing the content key session there raises an uncatchable exception. The SDK detects","type":"text"},{"text":" ","type":"text"},{"text":"the simulator, skips the session, and logs instead of trapping, which means protected","type":"text"},{"text":" ","type":"text"},{"text":"content will load but not decrypt. Verify DRM on a real Vision Pro.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"Failure Modes","anchor":"Failure-Modes","level":2,"type":"heading"},{"rows":[[[{"inlineContent":[{"text":"Symptom","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cause","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Protected stream plays black, or stalls at start","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Opened through ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"text":"; the geometry pipeline has no DRM path","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Content treated as clear despite a ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" block","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The block is missing ","type":"text"},{"code":"ekid","type":"codeVoice"},{"text":", ","type":"text"},{"code":"keyManagerUrl","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"drmProvider","type":"codeVoice"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"License request rejected"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"JWT minting failed; the error is swallowed and an empty "},{"code":"X-AxDRM-Message","type":"codeVoice"},{"type":"text","text":" is sent, so the CKC fetch fails"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Works on device, fails in the visionOS simulator"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expected — FairPlay is unavailable there"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" block is detected but never honoured"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The stream is RTMP, played by ","type":"text"},{"code":"LowLatencyPlayer","type":"codeVoice"},{"text":", which has no FairPlay path","type":"text"}]}]]],"header":"row","type":"table"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/drm"]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/ContentSwitching":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/