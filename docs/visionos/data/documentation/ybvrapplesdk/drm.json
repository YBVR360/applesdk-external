{"abstract":[{"text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is.","type":"text"}],"seeAlsoSections":[{"title":"Related Documentation","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"],"anchor":"Related-Documentation"},{"title":"Guides","generated":true,"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"],"anchor":"Guides"}],"kind":"article","sections":[],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/drm"]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"metadata":{"role":"article","modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article","title":"FairPlay DRM"},"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm","interfaceLanguage":"swift"},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"The SDK plays FairPlay-protected HLS through "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","isActive":true},{"type":"text","text":" — the thin wrapper around"},{"type":"text","text":" "},{"type":"text","text":"AVFoundation that skips the YBVR signaling and geometry stack. "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"pipeline behind "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","isActive":true},{"type":"text","text":" and the immersive renderers, has no DRM path at all:"},{"type":"text","text":" "},{"type":"text","text":"nothing in it accepts a "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig","isActive":true},{"type":"text","text":", so a protected stream opened through it fails to"},{"type":"text","text":" "},{"type":"text","text":"decrypt."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"That split is not an oversight waiting to be wired up. It follows from how protected frames"},{"type":"text","text":" "},{"type":"text","text":"reach the screen, which is covered below, and it decides which content can carry DRM at all."}],"type":"paragraph"},{"text":"Where DRM Can Be Used","type":"heading","level":2,"anchor":"Where-DRM-Can-Be-Used"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Playback path"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"How frames reach the screen"}]}],[{"inlineContent":[{"type":"text","text":"Protected content"}],"type":"paragraph"}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","type":"reference"},{"type":"text","text":" on iOS"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"code":"AVPlayerLayer","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","type":"reference","isActive":true},{"type":"text","text":" on visionOS"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RealityKit "},{"code":"VideoPlayerComponent","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, on device only"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true,"type":"reference"},{"type":"text","text":" + "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","isActive":true}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Metal, from "},{"code":"AVPlayerItemVideoOutput","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" + "},{"code":"VisionSurfaceContext","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Metal, via Compositor Services"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" + "},{"code":"VideoPlayerComponentSurfaceContext","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RealityKit "},{"code":"VideoPlayerComponent","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Not available — no API to supply a "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig","isActive":true}]}]]],"header":"row"},{"inlineContent":[{"type":"text","text":"The rule behind the table: FairPlay decodes into a protected path that the system can"},{"type":"text","text":" "},{"type":"text","text":"composite but the app cannot read. Surfaces that hand the "},{"code":"AVPlayer","type":"codeVoice"},{"type":"text","text":" to the system — an"},{"type":"text","text":" "},{"code":"AVPlayerLayer","type":"codeVoice"},{"type":"text","text":", or a RealityKit "},{"code":"VideoPlayerComponent","type":"codeVoice"},{"type":"text","text":" — therefore play protected content"},{"type":"text","text":" "},{"type":"text","text":"fine. The YBVR geometry renderers do the opposite: they copy each decoded frame out with"},{"type":"text","text":" "},{"code":"AVPlayerItemVideoOutput.copyPixelBuffer","type":"codeVoice"},{"type":"text","text":" and draw it onto a sphere, dome, fisheye, flat"},{"type":"text","text":" "},{"type":"text","text":"panel, or control-room composition. No frames are handed out for protected content, so there"},{"type":"text","text":" "},{"type":"text","text":"is nothing to texture the geometry with."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"In content terms:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"DRM is possible"}]},{"type":"text","text":" for material that plays as an ordinary AVFoundation item: flat or"},{"type":"text","text":" "},{"type":"text","text":"rectilinear video, and immersive video whose projection is described by embedded metadata"},{"type":"text","text":" "},{"type":"text","text":"the system itself understands (APMP, spatial, and the equirectangular kinds AVFoundation"},{"type":"text","text":" "},{"type":"text","text":"recognises), which a visionOS app projects onto a RealityKit "},{"code":"VideoPlayerComponent","type":"codeVoice"},{"type":"text","text":" "},{"type":"text","text":"through "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/avPlayer","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"DRM is not possible"}]},{"type":"text","text":" for anything that depends on YBVR-side rendering: custom geometry"},{"type":"text","text":" "},{"text":"from the signaling file, viewport-tiled streams, multi-camera control rooms, or camera","type":"text"},{"text":" ","type":"text"},{"text":"switching inside a single stream. Those need the pixel buffers FairPlay withholds.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"DRM is not possible over RTMP."}]},{"text":" Low-latency streams play through ","type":"text"},{"code":"LowLatencyPlayer","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which is not AVFoundation-based and has no FairPlay path, so a ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" block on an RTMP","type":"text"},{"text":" ","type":"text"},{"text":"stream is reported but cannot be honoured.","type":"text"}],"type":"paragraph"}]}]},{"text":"Configuring DRM","anchor":"Configuring-DRM","level":2,"type":"heading"},{"inlineContent":[{"text":"The signaling file identifies the key; the certificate and license endpoints come from the","type":"text"},{"text":" ","type":"text"},{"text":"host app. Both halves are required — a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager"},{"text":" on its own does not configure","type":"text"},{"text":" ","type":"text"},{"text":"anything.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let player = DirectPlayer()","","player.drmConfig = DrmConfig(","    certificateURL: \"https:\/\/...\/fairplay.cer\",","    licenseURL: \"https:\/\/...\/AcquireLicense\",","    drmKeyManager: keyManager",")","","await player.open(url: streamURL)"],"type":"codeListing"},{"inlineContent":[{"text":"Set ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/drmConfig"},{"text":" before ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/open(url:)"},{"text":". Assigning it builds the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DrmManager"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"open"},{"text":" installs the platform key handler around the new item — on visionOS","type":"text"},{"text":" ","type":"text"},{"text":"the content key session is created there — so a config assigned afterwards does not apply to","type":"text"},{"text":" ","type":"text"},{"text":"the item already loaded.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"When the stream follows the convention of a sibling signaling file, the two steps collapse","type":"text"},{"text":" ","type":"text"},{"text":"into one call that fetches the key material and opens the stream:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["try await player.open(","    url: streamURL,","    fetchingDrmFromSignalingWith: certificateURL,","    licenseURL: licenseURL",")"],"type":"codeListing"},{"text":"Providers","anchor":"Providers","level":3,"type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager\/provider"},{"text":" selects the license flow: ","type":"text"},{"type":"codeVoice","code":"\"axinom\""},{"text":" and ","type":"text"},{"type":"codeVoice","code":"\"ybvr\""},{"text":" are recognised,","type":"text"},{"text":" ","type":"text"},{"text":"and any other value falls back to Axinom. Both currently resolve to the Axinom provider,","type":"text"},{"text":" ","type":"text"},{"text":"which mints a license JWT and sends it as ","type":"text"},{"type":"codeVoice","code":"X-AxDRM-Message"},{"text":" with the SPC.","type":"text"}],"type":"paragraph"},{"name":"Important","style":"important","content":[{"inlineContent":[{"text":"That JWT is minted by ","type":"text"},{"code":"DrmJWTRequest","type":"codeVoice"},{"text":" against a hardcoded development XMS","type":"text"},{"text":" ","type":"text"},{"text":"backend, using OAuth client credentials compiled into the SDK. DRM therefore only works","type":"text"},{"text":" ","type":"text"},{"text":"today against that one environment, and the credentials ship inside any binary that links","type":"text"},{"text":" ","type":"text"},{"text":"the SDK. Treat production DRM as needing this made configurable first.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"text":"How DRM Is Detected","anchor":"How-DRM-Is-Detected","level":2,"type":"heading"},{"inlineContent":[{"text":"Detection runs entirely off the signaling file, before playback starts. Nothing inspects the","type":"text"},{"text":" ","type":"text"},{"text":"media playlist, so an encrypted stream whose signaling omits ","type":"text"},{"type":"codeVoice","code":"drm"},{"text":" is indistinguishable from","type":"text"},{"text":" ","type":"text"},{"text":"clear content until AVFoundation asks for a key and fails.","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","type":"reference"},{"type":"text","text":" resolves the signaling version from the"},{"type":"text","text":" "},{"type":"text","text":"video URL: a path containing "},{"code":"_signaling_v4.json","type":"codeVoice"},{"type":"text","text":" is v4, any other "},{"code":".json","type":"codeVoice"},{"type":"text","text":" path is v3, and"},{"type":"text","text":" "},{"type":"text","text":"a media URL is v2 — where the signaling file is the same URL with its extension swapped"},{"type":"text","text":" "},{"type":"text","text":"for "},{"code":".json","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The response is decoded into "},{"code":"Signaling","type":"codeVoice"},{"type":"text","text":" (v2), "},{"code":"SignalingV3","type":"codeVoice"},{"type":"text","text":", or "},{"code":"SignalingV4","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The caller asks the result for "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","type":"reference"},{"type":"text","text":". A non-"},{"code":"nil","type":"codeVoice"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","type":"reference"},{"type":"text","text":" means the content is protected: route it to "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","type":"reference"},{"type":"text","text":" on that"},{"type":"text","text":" "},{"type":"text","text":"basis."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"Content with no "},{"code":"drm","type":"codeVoice"},{"type":"text","text":" key — or with "},{"code":"\"drm\": null","type":"codeVoice"},{"type":"text","text":" — is simply unprotected. The signaling"},{"type":"text","text":" "},{"type":"text","text":"decodes normally, no DRM is reported, and the stream plays through the usual geometry"},{"type":"text","text":" "},{"type":"text","text":"pipeline; this is the ordinary case for every clear title."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Decoding the block requires all three of "},{"code":"ekid","type":"codeVoice"},{"type":"text","text":", "},{"code":"keyManagerUrl","type":"codeVoice"},{"type":"text","text":", and "},{"code":"drmProvider","type":"codeVoice"},{"type":"text","text":". A block"},{"type":"text","text":" "},{"type":"text","text":"that is present but missing any of them is dropped on every signaling version, leaving the"},{"type":"text","text":" "},{"type":"text","text":"stream playable but reported as clear — so genuinely protected content then fails later at key"},{"type":"text","text":" "},{"type":"text","text":"time with an opaque AVFoundation error rather than a DRM-specific one. Validate the block when"},{"type":"text","text":" "},{"type":"text","text":"publishing. v4 logs the dropped block; v2 and v3 discard it silently."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What each version reports today:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Signaling version"}]}],[{"type":"paragraph","inlineContent":[{"code":"drm","type":"codeVoice"},{"type":"text","text":" in the file"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reported by "},{"code":"drmKeyManager()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v2"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v3"}]}],[{"inlineContent":[{"type":"text","text":"Decoded"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The key manager"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"v4","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decoded","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]]],"header":"row"},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"A signaling model that decodes ","type":"text"},{"type":"codeVoice","code":"drm"},{"text":" but does not implement","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","isActive":true,"type":"reference"},{"text":" inherits the protocol’s default of ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"silently reports protected content as clear — nothing fails to compile. ","type":"text"},{"type":"codeVoice","code":"SignalingV4"},{"text":" did","type":"text"},{"text":" ","type":"text"},{"text":"exactly that until its accessor was added, so DRM-protected v4 streams were routed to the","type":"text"},{"text":" ","type":"text"},{"text":"geometry pipeline where they cannot decrypt. Any new signaling version must implement that","type":"text"},{"text":" ","type":"text"},{"text":"requirement, and ","type":"text"},{"type":"codeVoice","code":"SignalingDrmTests"},{"text":" asserts detection through the protocol rather than the","type":"text"},{"text":" ","type":"text"},{"text":"concrete type to keep the path covered.","type":"text"}],"type":"paragraph"}],"type":"aside"},{"type":"paragraph","inlineContent":[{"text":"Outside the manager, ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/fetchDrmKeyManager(forStreamURL:session:)","isActive":true,"type":"reference"},{"text":" performs the","type":"text"},{"text":" ","type":"text"},{"text":"same lookup standalone: it swaps the stream URL’s extension for ","type":"text"},{"type":"codeVoice","code":".json"},{"text":", decodes the v2 shape,","type":"text"},{"text":" ","type":"text"},{"text":"and throws ","type":"text"},{"type":"codeVoice","code":"DirectPlayerDrmError.noDrmInfoInSignaling"},{"text":" when no ","type":"text"},{"type":"codeVoice","code":"drm"},{"text":" entry is present.","type":"text"}]},{"level":2,"type":"heading","text":"Platform Differences","anchor":"Platform-Differences"},{"type":"paragraph","inlineContent":[{"text":"The SDK ships for iOS 17+ and visionOS 26+, and each uses the key-delivery API available to it.","type":"text"},{"text":" ","type":"text"},{"text":"Both share the same certificate fetch, license exchange, and ","type":"text"},{"type":"codeVoice","code":"DrmProvider"},{"text":".","type":"text"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"iOS"}]},{"text":" uses the classic ","type":"text"},{"code":"skd:\/\/","type":"codeVoice"},{"text":" resource-loader flow. ","type":"text"},{"code":"ApplePlayer","type":"codeVoice"},{"text":" sets itself as the","type":"text"},{"text":" ","type":"text"},{"text":"asset’s ","type":"text"},{"code":"AVAssetResourceLoaderDelegate","type":"codeVoice"},{"text":" for every stream, protected or not, and forwards","type":"text"},{"text":" ","type":"text"},{"text":"key requests to ","type":"text"},{"code":"DrmManager","type":"codeVoice"},{"text":" only when a config was supplied. Without one the request goes","type":"text"},{"text":" ","type":"text"},{"text":"unanswered and playback fails.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"visionOS"}]},{"text":" has never supported that flow and uses","type":"text"},{"text":" ","type":"text"},{"code":"AVContentKeySession(keySystem: .fairPlayStreaming)","type":"codeVoice"},{"text":" with an ","type":"text"},{"code":"AVContentKeySessionDelegate","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The session is built during ","type":"text"},{"code":"open","type":"codeVoice"},{"text":" only when a config is present.","type":"text"}]}]}],"type":"unorderedList"},{"style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"FairPlay needs the Secure Enclave, so it does not work in the visionOS simulator —"},{"type":"text","text":" "},{"type":"text","text":"constructing the content key session there raises an uncatchable exception. The SDK detects"},{"type":"text","text":" "},{"type":"text","text":"the simulator, skips the session, and logs instead of trapping, which means protected"},{"type":"text","text":" "},{"type":"text","text":"content will load but not decrypt. Verify DRM on a real Vision Pro."}],"type":"paragraph"}],"type":"aside"},{"level":2,"type":"heading","text":"Failure Modes","anchor":"Failure-Modes"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Symptom"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Cause"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Protected stream plays black, or stalls at start"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Opened through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":"; the geometry pipeline has no DRM path"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"Content treated as clear despite a "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" block"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The block is missing "},{"type":"codeVoice","code":"ekid"},{"type":"text","text":", "},{"type":"codeVoice","code":"keyManagerUrl"},{"type":"text","text":", or "},{"type":"codeVoice","code":"drmProvider"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"License request rejected"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"JWT minting failed; the error is swallowed and an empty "},{"code":"X-AxDRM-Message","type":"codeVoice"},{"type":"text","text":" is sent, so the CKC fetch fails"}]}]],[[{"inlineContent":[{"type":"text","text":"Works on device, fails in the visionOS simulator"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Expected — FairPlay is unavailable there"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"A "},{"code":"drm","type":"codeVoice"},{"type":"text","text":" block is detected but never honoured"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"The stream is RTMP, played by "},{"code":"LowLatencyPlayer","type":"codeVoice"},{"type":"text","text":", which has no FairPlay path"}],"type":"paragraph"}]]],"type":"table","header":"row"}],"kind":"content"}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK