{"variants":[{"paths":["\/documentation\/ybvrapplesdk\/drm"],"traits":[{"interfaceLanguage":"swift"}]}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"seeAlsoSections":[{"anchor":"Related-Documentation","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"],"title":"Related Documentation"},{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"],"title":"Guides"}],"kind":"article","identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm","interfaceLanguage":"swift"},"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK plays FairPlay-protected HLS through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer"},{"type":"text","text":" — the thin wrapper around"},{"type":"text","text":" "},{"type":"text","text":"AVFoundation that skips the YBVR signaling and geometry stack. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"pipeline behind "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView"},{"type":"text","text":" and the immersive renderers, has no DRM path at all:"},{"type":"text","text":" "},{"type":"text","text":"nothing in it accepts a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig"},{"type":"text","text":", so a protected stream opened through it fails to"},{"type":"text","text":" "},{"type":"text","text":"decrypt."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That split is not an oversight waiting to be wired up. It follows from how protected frames"},{"type":"text","text":" "},{"type":"text","text":"reach the screen, which is covered below, and it decides which content can carry DRM at all."}]},{"text":"Where DRM Can Be Used","type":"heading","level":2,"anchor":"Where-DRM-Can-Be-Used"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Playback path","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"How frames reach the screen","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Protected content","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","isActive":true},{"type":"text","text":" on iOS"}]}],[{"type":"paragraph","inlineContent":[{"code":"AVPlayerLayer","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Yes","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","isActive":true},{"type":"text","text":" on visionOS"}]}],[{"type":"paragraph","inlineContent":[{"text":"RealityKit ","type":"text"},{"code":"VideoPlayerComponent","type":"codeVoice"}]}],[{"inlineContent":[{"type":"text","text":"Yes, on device only"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true,"type":"reference"},{"type":"text","text":" + "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Metal, from "},{"type":"codeVoice","code":"AVPlayerItemVideoOutput"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" + "},{"type":"codeVoice","code":"VisionSurfaceContext"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Metal, via Compositor Services"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" + ","type":"text"},{"code":"VideoPlayerComponentSurfaceContext","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RealityKit "},{"type":"codeVoice","code":"VideoPlayerComponent"}]}],[{"type":"paragraph","inlineContent":[{"text":"Not available — no API to supply a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rule behind the table: FairPlay decodes into a protected path that the system can"},{"type":"text","text":" "},{"type":"text","text":"composite but the app cannot read. Surfaces that hand the "},{"type":"codeVoice","code":"AVPlayer"},{"type":"text","text":" to the system — an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVPlayerLayer"},{"type":"text","text":", or a RealityKit "},{"type":"codeVoice","code":"VideoPlayerComponent"},{"type":"text","text":" — therefore play protected content"},{"type":"text","text":" "},{"type":"text","text":"fine. The YBVR geometry renderers do the opposite: they copy each decoded frame out with"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVPlayerItemVideoOutput.copyPixelBuffer"},{"type":"text","text":" and draw it onto a sphere, dome, fisheye, flat"},{"type":"text","text":" "},{"type":"text","text":"panel, or control-room composition. No frames are handed out for protected content, so there"},{"type":"text","text":" "},{"text":"is nothing to texture the geometry with.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"In content terms:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"DRM is possible"}]},{"text":" for material that plays as an ordinary AVFoundation item: flat or","type":"text"},{"text":" ","type":"text"},{"text":"rectilinear video, and immersive video whose projection is described by embedded metadata","type":"text"},{"text":" ","type":"text"},{"text":"the system itself understands (APMP, spatial, and the equirectangular kinds AVFoundation","type":"text"},{"text":" ","type":"text"},{"text":"recognises), which ","type":"text"},{"type":"codeVoice","code":"DirectPlayerImmersiveScene"},{"text":" in the visionOS demo app projects onto a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"VideoPlayerComponent"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"DRM is not possible","type":"text"}]},{"text":" for anything that depends on YBVR-side rendering: custom geometry","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"from the signaling file, viewport-tiled streams, multi-camera control rooms, or camera"},{"text":" ","type":"text"},{"type":"text","text":"switching inside a single stream. Those need the pixel buffers FairPlay withholds."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"DRM is not possible over RTMP."}]},{"type":"text","text":" Low-latency streams play through "},{"type":"codeVoice","code":"LowLatencyPlayer"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which is not AVFoundation-based and has no FairPlay path, so a ","type":"text"},{"type":"codeVoice","code":"drm"},{"type":"text","text":" block on an RTMP"},{"text":" ","type":"text"},{"text":"stream is reported but cannot be honoured.","type":"text"}]}]}]},{"text":"Configuring DRM","type":"heading","level":2,"anchor":"Configuring-DRM"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The signaling file identifies the key; the certificate and license endpoints come from the"},{"text":" ","type":"text"},{"text":"host app. Both halves are required — a ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","isActive":true,"type":"reference"},{"text":" on its own does not configure","type":"text"},{"text":" ","type":"text"},{"text":"anything.","type":"text"}]},{"type":"codeListing","code":["let player = DirectPlayer()","","player.drmConfig = DrmConfig(","    certificateURL: \"https:\/\/...\/fairplay.cer\",","    licenseURL: \"https:\/\/...\/AcquireLicense\",","    drmKeyManager: keyManager",")","","await player.open(url: streamURL)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/drmConfig","isActive":true},{"text":" before ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/open(url:)"},{"text":". Assigning it builds the","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"DrmManager"},{"type":"text","text":", and "},{"type":"codeVoice","code":"open"},{"text":" installs the platform key handler around the new item — on visionOS","type":"text"},{"type":"text","text":" "},{"text":"the content key session is created there — so a config assigned afterwards does not apply to","type":"text"},{"text":" ","type":"text"},{"text":"the item already loaded.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When the stream follows the convention of a sibling signaling file, the two steps collapse","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"into one call that fetches the key material and opens the stream:"}]},{"syntax":"swift","type":"codeListing","code":["try await player.open(","    url: streamURL,","    fetchingDrmFromSignalingWith: certificateURL,","    licenseURL: licenseURL",")"]},{"level":3,"text":"Providers","type":"heading","anchor":"Providers"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager\/provider"},{"type":"text","text":" selects the license flow: "},{"type":"codeVoice","code":"\"axinom\""},{"type":"text","text":" and "},{"code":"\"ybvr\"","type":"codeVoice"},{"type":"text","text":" are recognised,"},{"text":" ","type":"text"},{"type":"text","text":"and any other value falls back to Axinom. Both currently resolve to the Axinom provider,"},{"text":" ","type":"text"},{"type":"text","text":"which mints a license JWT and sends it as "},{"type":"codeVoice","code":"X-AxDRM-Message"},{"text":" with the SPC.","type":"text"}]},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"That JWT is minted by ","type":"text"},{"type":"codeVoice","code":"DrmJWTRequest"},{"text":" against a hardcoded development XMS","type":"text"},{"text":" ","type":"text"},{"text":"backend, using OAuth client credentials compiled into the SDK. DRM therefore only works","type":"text"},{"text":" ","type":"text"},{"text":"today against that one environment, and the credentials ship inside any binary that links","type":"text"},{"text":" ","type":"text"},{"text":"the SDK. Treat production DRM as needing this made configurable first.","type":"text"}]}]},{"text":"How DRM Is Detected","type":"heading","level":2,"anchor":"How-DRM-Is-Detected"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Detection runs entirely off the signaling file, before playback starts. Nothing inspects the"},{"type":"text","text":" "},{"type":"text","text":"media playlist, so an encrypted stream whose signaling omits "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" is indistinguishable from"},{"type":"text","text":" "},{"type":"text","text":"clear content until AVFoundation asks for a key and fails."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)"},{"text":" resolves the signaling version from the","type":"text"},{"type":"text","text":" "},{"text":"video URL: a path containing ","type":"text"},{"type":"codeVoice","code":"_signaling_v4.json"},{"text":" is v4, any other ","type":"text"},{"code":".json","type":"codeVoice"},{"text":" path is v3, and","type":"text"},{"text":" ","type":"text"},{"text":"a media URL is v2 — where the signaling file is the same URL with its extension swapped","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"codeVoice","code":".json"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The response is decoded into "},{"code":"Signaling","type":"codeVoice"},{"text":" (v2), ","type":"text"},{"code":"SignalingV3","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"SignalingV4","type":"codeVoice"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller asks the result for "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","isActive":true,"type":"reference"},{"type":"text","text":". A non-"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","isActive":true,"type":"reference"},{"type":"text","text":" means the content is protected, and both demo apps route it to"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","isActive":true,"type":"reference"},{"type":"text","text":" on that basis."}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Content with no "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" key — or with "},{"type":"codeVoice","code":"\"drm\": null"},{"type":"text","text":" — is simply unprotected. The signaling"},{"text":" ","type":"text"},{"type":"text","text":"decodes normally, no DRM is reported, and the stream plays through the usual geometry"},{"text":" ","type":"text"},{"type":"text","text":"pipeline; this is the ordinary case for every clear title."}]},{"type":"paragraph","inlineContent":[{"text":"Decoding the block requires all three of ","type":"text"},{"type":"codeVoice","code":"ekid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"keyManagerUrl"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"drmProvider"},{"text":". A block","type":"text"},{"text":" ","type":"text"},{"text":"that is present but missing any of them is dropped on every signaling version, leaving the","type":"text"},{"text":" ","type":"text"},{"text":"stream playable but reported as clear — so genuinely protected content then fails later at key","type":"text"},{"type":"text","text":" "},{"text":"time with an opaque AVFoundation error rather than a DRM-specific one. Validate the block when","type":"text"},{"type":"text","text":" "},{"type":"text","text":"publishing. v4 logs the dropped block; v2 and v3 discard it silently."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What each version reports today:"}]},{"rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Signaling version"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"drm"},{"type":"text","text":" in the file"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reported by "},{"code":"drmKeyManager()","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v2"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v3"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"v4","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Decoded","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The key manager","type":"text"}]}]]],"type":"table","header":"row"},{"content":[{"type":"paragraph","inlineContent":[{"text":"A signaling model that decodes ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" but does not implement","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()"},{"text":" inherits the protocol’s default of ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"silently reports protected content as clear — nothing fails to compile. ","type":"text"},{"code":"SignalingV4","type":"codeVoice"},{"text":" did","type":"text"},{"text":" ","type":"text"},{"text":"exactly that until its accessor was added, so DRM-protected v4 streams were routed to the","type":"text"},{"text":" ","type":"text"},{"text":"geometry pipeline where they cannot decrypt. Any new signaling version must implement that","type":"text"},{"text":" ","type":"text"},{"text":"requirement, and ","type":"text"},{"code":"SignalingDrmTests","type":"codeVoice"},{"text":" asserts detection through the protocol rather than the","type":"text"},{"text":" ","type":"text"},{"text":"concrete type to keep the path covered.","type":"text"}]}],"type":"aside","style":"important","name":"Important"},{"inlineContent":[{"text":"Outside the manager, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/fetchDrmKeyManager(forStreamURL:session:)"},{"text":" performs the","type":"text"},{"text":" ","type":"text"},{"text":"same lookup standalone: it swaps the stream URL’s extension for ","type":"text"},{"type":"codeVoice","code":".json"},{"text":", decodes the v2 shape,","type":"text"},{"text":" ","type":"text"},{"text":"and throws ","type":"text"},{"type":"codeVoice","code":"DirectPlayerDrmError.noDrmInfoInSignaling"},{"text":" when no ","type":"text"},{"type":"codeVoice","code":"drm"},{"text":" entry is present.","type":"text"}],"type":"paragraph"},{"text":"Platform Differences","type":"heading","level":2,"anchor":"Platform-Differences"},{"inlineContent":[{"type":"text","text":"The SDK ships for iOS 17+ and visionOS 26+, and each uses the key-delivery API available to it."},{"type":"text","text":" "},{"type":"text","text":"Both share the same certificate fetch, license exchange, and "},{"code":"DrmProvider","type":"codeVoice"},{"type":"text","text":"."}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"text":" uses the classic ","type":"text"},{"code":"skd:\/\/","type":"codeVoice"},{"text":" resource-loader flow. ","type":"text"},{"code":"ApplePlayer","type":"codeVoice"},{"text":" sets itself as the","type":"text"},{"text":" ","type":"text"},{"text":"asset’s ","type":"text"},{"code":"AVAssetResourceLoaderDelegate","type":"codeVoice"},{"type":"text","text":" for every stream, protected or not, and forwards"},{"text":" ","type":"text"},{"type":"text","text":"key requests to "},{"code":"DrmManager","type":"codeVoice"},{"type":"text","text":" only when a config was supplied. Without one the request goes"},{"text":" ","type":"text"},{"type":"text","text":"unanswered and playback fails."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"visionOS","type":"text"}]},{"type":"text","text":" has never supported that flow and uses"},{"type":"text","text":" "},{"code":"AVContentKeySession(keySystem: .fairPlayStreaming)","type":"codeVoice"},{"text":" with an ","type":"text"},{"type":"codeVoice","code":"AVContentKeySessionDelegate"},{"text":".","type":"text"},{"type":"text","text":" "},{"type":"text","text":"The session is built during "},{"type":"codeVoice","code":"open"},{"type":"text","text":" only when a config is present."}]}]}],"type":"unorderedList"},{"content":[{"type":"paragraph","inlineContent":[{"text":"FairPlay needs the Secure Enclave, so it does not work in the visionOS simulator —","type":"text"},{"type":"text","text":" "},{"text":"constructing the content key session there raises an uncatchable exception. The SDK detects","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the simulator, skips the session, and logs instead of trapping, which means protected"},{"text":" ","type":"text"},{"type":"text","text":"content will load but not decrypt. Verify DRM on a real Vision Pro."}]}],"style":"note","type":"aside","name":"Note"},{"anchor":"Failure-Modes","level":2,"type":"heading","text":"Failure Modes"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Symptom","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cause","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Protected stream plays black, or stalls at start","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Opened through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":"; the geometry pipeline has no DRM path","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Content treated as clear despite a ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" block","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The block is missing ","type":"text"},{"code":"ekid","type":"codeVoice"},{"text":", ","type":"text"},{"code":"keyManagerUrl","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"drmProvider","type":"codeVoice"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"License request rejected","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"JWT minting failed; the error is swallowed and an empty ","type":"text"},{"code":"X-AxDRM-Message","type":"codeVoice"},{"text":" is sent, so the CKC fetch fails","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Works on device, fails in the visionOS simulator","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Expected — FairPlay is unavailable there","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" block is detected but never honoured","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"The stream is RTMP, played by ","type":"text"},{"code":"LowLatencyPlayer","type":"codeVoice"},{"text":", which has no FairPlay path","type":"text"}]}]]]}],"kind":"content"}],"schemaVersion":{"major":0,"minor":3,"patch":0},"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article","title":"FairPlay DRM","role":"article"},"abstract":[{"text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is.","type":"text"}],"sections":[],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/DrmConfig":{"abstract":[],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRApp