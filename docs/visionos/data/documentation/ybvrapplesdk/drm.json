{"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"kind":"article","variants":[{"paths":["\/documentation\/ybvrapplesdk\/drm"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"abstract":[{"type":"text","text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is."}],"metadata":{"roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}],"role":"article","title":"FairPlay DRM"},"schemaVersion":{"minor":3,"patch":0,"major":0},"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"],"generated":true,"anchor":"Guides","title":"Guides"}],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK plays FairPlay-protected HLS through "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","type":"reference","isActive":true},{"type":"text","text":" — the thin wrapper around"},{"type":"text","text":" "},{"type":"text","text":"AVFoundation that skips the YBVR signaling and geometry stack. "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference","isActive":true},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"pipeline behind "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","type":"reference","isActive":true},{"type":"text","text":" and the immersive renderers, has no DRM path at all:"},{"type":"text","text":" "},{"type":"text","text":"nothing in it accepts a "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig","type":"reference","isActive":true},{"type":"text","text":", so a protected stream opened through it fails to"},{"type":"text","text":" "},{"type":"text","text":"decrypt."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That split is not an oversight waiting to be wired up. It follows from how protected frames"},{"type":"text","text":" "},{"type":"text","text":"reach the screen, which is covered below, and it decides which content can carry DRM at all."}]},{"type":"heading","level":2,"anchor":"Where-DRM-Can-Be-Used","text":"Where DRM Can Be Used"},{"type":"table","header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Playback path"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"How frames reach the screen"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Protected content"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer"},{"type":"text","text":" on iOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"AVPlayerLayer"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer"},{"type":"text","text":" on visionOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"RealityKit "},{"type":"codeVoice","code":"VideoPlayerComponent"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes, on device only"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" + "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Metal, from "},{"type":"codeVoice","code":"AVPlayerItemVideoOutput"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" + "},{"type":"codeVoice","code":"VisionSurfaceContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Metal, via Compositor Services"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"No"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" + "},{"type":"codeVoice","code":"VideoPlayerComponentSurfaceContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"RealityKit "},{"type":"codeVoice","code":"VideoPlayerComponent"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Not available — no API to supply a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rule behind the table: FairPlay decodes into a protected path that the system can"},{"type":"text","text":" "},{"type":"text","text":"composite but the app cannot read. Surfaces that hand the "},{"code":"AVPlayer","type":"codeVoice"},{"type":"text","text":" to the system — an"},{"type":"text","text":" "},{"code":"AVPlayerLayer","type":"codeVoice"},{"type":"text","text":", or a RealityKit "},{"code":"VideoPlayerComponent","type":"codeVoice"},{"type":"text","text":" — therefore play protected content"},{"type":"text","text":" "},{"type":"text","text":"fine. The YBVR geometry renderers do the opposite: they copy each decoded frame out with"},{"type":"text","text":" "},{"code":"AVPlayerItemVideoOutput.copyPixelBuffer","type":"codeVoice"},{"type":"text","text":" and draw it onto a sphere, dome, fisheye, flat"},{"type":"text","text":" "},{"type":"text","text":"panel, or control-room composition. No frames are handed out for protected content, so there"},{"type":"text","text":" "},{"type":"text","text":"is nothing to texture the geometry with."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In content terms:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"DRM is possible"}],"type":"strong"},{"text":" for material that plays as an ordinary AVFoundation item: flat or","type":"text"},{"text":" ","type":"text"},{"text":"rectilinear video, and immersive video whose projection is described by embedded metadata","type":"text"},{"text":" ","type":"text"},{"text":"the system itself understands (APMP, spatial, and the equirectangular kinds AVFoundation","type":"text"},{"text":" ","type":"text"},{"text":"recognises), which ","type":"text"},{"code":"DirectPlayerImmersiveScene","type":"codeVoice"},{"text":" in the visionOS demo app projects onto a","type":"text"},{"text":" ","type":"text"},{"code":"VideoPlayerComponent","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"DRM is not possible"}],"type":"strong"},{"text":" for anything that depends on YBVR-side rendering: custom geometry","type":"text"},{"text":" ","type":"text"},{"text":"from the signaling file, viewport-tiled streams, multi-camera control rooms, or camera","type":"text"},{"text":" ","type":"text"},{"text":"switching inside a single stream. Those need the pixel buffers FairPlay withholds.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"DRM is not possible over RTMP."}],"type":"strong"},{"text":" Low-latency streams play through ","type":"text"},{"code":"LowLatencyPlayer","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which is not AVFoundation-based and has no FairPlay path, so a ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" block on an RTMP","type":"text"},{"text":" ","type":"text"},{"text":"stream is reported but cannot be honoured.","type":"text"}],"type":"paragraph"}]}]},{"type":"heading","level":2,"anchor":"Configuring-DRM","text":"Configuring DRM"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The signaling file identifies the key; the certificate and license endpoints come from the"},{"type":"text","text":" "},{"type":"text","text":"host app. Both halves are required — a "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","type":"reference","isActive":true},{"type":"text","text":" on its own does not configure"},{"type":"text","text":" "},{"type":"text","text":"anything."}]},{"type":"codeListing","code":["let player = DirectPlayer()","","player.drmConfig = DrmConfig(","    certificateURL: \"https:\/\/...\/fairplay.cer\",","    licenseURL: \"https:\/\/...\/AcquireLicense\",","    drmKeyManager: keyManager",")","","await player.open(url: streamURL)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/drmConfig","type":"reference","isActive":true},{"type":"text","text":" before "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/open(url:)","type":"reference","isActive":true},{"type":"text","text":". Assigning it builds the"},{"type":"text","text":" "},{"code":"DrmManager","type":"codeVoice"},{"type":"text","text":", and "},{"code":"open","type":"codeVoice"},{"type":"text","text":" installs the platform key handler around the new item — on visionOS"},{"type":"text","text":" "},{"type":"text","text":"the content key session is created there — so a config assigned afterwards does not apply to"},{"type":"text","text":" "},{"type":"text","text":"the item already loaded."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the stream follows the convention of a sibling signaling file, the two steps collapse"},{"type":"text","text":" "},{"type":"text","text":"into one call that fetches the key material and opens the stream:"}]},{"type":"codeListing","code":["try await player.open(","    url: streamURL,","    fetchingDrmFromSignalingWith: certificateURL,","    licenseURL: licenseURL",")"],"syntax":"swift"},{"type":"heading","level":3,"anchor":"Providers","text":"Providers"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager\/provider","type":"reference","isActive":true},{"type":"text","text":" selects the license flow: "},{"code":"\"axinom\"","type":"codeVoice"},{"type":"text","text":" and "},{"code":"\"ybvr\"","type":"codeVoice"},{"type":"text","text":" are recognised,"},{"type":"text","text":" "},{"type":"text","text":"and any other value falls back to Axinom. Both currently resolve to the Axinom provider,"},{"type":"text","text":" "},{"type":"text","text":"which mints a license JWT and sends it as "},{"code":"X-AxDRM-Message","type":"codeVoice"},{"type":"text","text":" with the SPC."}]},{"type":"aside","style":"important","content":[{"inlineContent":[{"type":"text","text":"That JWT is minted by "},{"type":"codeVoice","code":"DrmJWTRequest"},{"type":"text","text":" against a hardcoded development XMS"},{"type":"text","text":" "},{"type":"text","text":"backend, using OAuth client credentials compiled into the SDK. DRM therefore only works"},{"type":"text","text":" "},{"type":"text","text":"today against that one environment, and the credentials ship inside any binary that links"},{"type":"text","text":" "},{"type":"text","text":"the SDK. Treat production DRM as needing this made configurable first."}],"type":"paragraph"}],"name":"Important"},{"type":"heading","level":2,"anchor":"How-DRM-Is-Detected","text":"How DRM Is Detected"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Detection runs entirely off the signaling file, before playback starts. Nothing inspects the"},{"text":" ","type":"text"},{"type":"text","text":"media playlist, so an encrypted stream whose signaling omits "},{"code":"drm","type":"codeVoice"},{"type":"text","text":" is indistinguishable from"},{"type":"text","text":" "},{"type":"text","text":"clear content until AVFoundation asks for a key and fails."}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","isActive":true},{"type":"text","text":" resolves the signaling version from the"},{"type":"text","text":" "},{"type":"text","text":"video URL: a path containing "},{"type":"codeVoice","code":"_signaling_v4.json"},{"type":"text","text":" is v4, any other "},{"type":"codeVoice","code":".json"},{"type":"text","text":" path is v3, and"},{"type":"text","text":" "},{"type":"text","text":"a media URL is v2 — where the signaling file is the same URL with its extension swapped"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"codeVoice","code":".json"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The response is decoded into "},{"type":"codeVoice","code":"Signaling"},{"type":"text","text":" (v2), "},{"type":"codeVoice","code":"SignalingV3"},{"type":"text","text":", or "},{"type":"codeVoice","code":"SignalingV4"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The caller asks the result for "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","isActive":true},{"type":"text","text":". A non-"},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","isActive":true},{"type":"text","text":" means the content is protected, and both demo apps route it to"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","isActive":true},{"type":"text","text":" on that basis."}]}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Content with no "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" key — or with "},{"type":"codeVoice","code":"\"drm\": null"},{"type":"text","text":" — is simply unprotected. The signaling"},{"type":"text","text":" "},{"type":"text","text":"decodes normally, no DRM is reported, and the stream plays through the usual geometry"},{"type":"text","text":" "},{"type":"text","text":"pipeline; this is the ordinary case for every clear title."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Decoding the block requires all three of "},{"type":"codeVoice","code":"ekid"},{"type":"text","text":", "},{"type":"codeVoice","code":"keyManagerUrl"},{"type":"text","text":", and "},{"type":"codeVoice","code":"drmProvider"},{"type":"text","text":". A block"},{"type":"text","text":" "},{"type":"text","text":"that is present but missing any of them is dropped on every signaling version, leaving the"},{"type":"text","text":" "},{"type":"text","text":"stream playable but reported as clear — so genuinely protected content then fails later at key"},{"type":"text","text":" "},{"type":"text","text":"time with an opaque AVFoundation error rather than a DRM-specific one. Validate the block when"},{"type":"text","text":" "},{"type":"text","text":"publishing. v4 logs the dropped block; v2 and v3 discard it silently."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What each version reports today:"}],"type":"paragraph"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Signaling version"}]}],[{"inlineContent":[{"code":"drm","type":"codeVoice"},{"type":"text","text":" in the file"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reported by "},{"type":"codeVoice","code":"drmKeyManager()"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v2"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"v3","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]]],"header":"row"},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"A signaling model that decodes "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" but does not implement"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()"},{"text":" inherits the protocol’s default of ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":", and","type":"text"},{"text":" ","type":"text"},{"text":"silently reports protected content as clear — nothing fails to compile. ","type":"text"},{"type":"codeVoice","code":"SignalingV4"},{"text":" did","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"exactly that until its accessor was added, so DRM-protected v4 streams were routed to the"},{"text":" ","type":"text"},{"text":"geometry pipeline where they cannot decrypt. Any new signaling version must implement that","type":"text"},{"text":" ","type":"text"},{"text":"requirement, and ","type":"text"},{"type":"codeVoice","code":"SignalingDrmTests"},{"text":" asserts detection through the protocol rather than the","type":"text"},{"type":"text","text":" "},{"text":"concrete type to keep the path covered.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Outside the manager, "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/fetchDrmKeyManager(forStreamURL:session:)","isActive":true},{"type":"text","text":" performs the"},{"type":"text","text":" "},{"type":"text","text":"same lookup standalone: it swaps the stream URL’s extension for "},{"type":"codeVoice","code":".json"},{"type":"text","text":", decodes the v2 shape,"},{"type":"text","text":" "},{"type":"text","text":"and throws "},{"type":"codeVoice","code":"DirectPlayerDrmError.noDrmInfoInSignaling"},{"type":"text","text":" when no "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" entry is present."}]},{"type":"heading","level":2,"text":"Platform Differences","anchor":"Platform-Differences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK ships for iOS 17+ and visionOS 26+, and each uses the key-delivery API available to it."},{"type":"text","text":" "},{"type":"text","text":"Both share the same certificate fetch, license exchange, and "},{"type":"codeVoice","code":"DrmProvider"},{"type":"text","text":"."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"text":" uses the classic ","type":"text"},{"code":"skd:\/\/","type":"codeVoice"},{"text":" resource-loader flow. ","type":"text"},{"code":"ApplePlayer","type":"codeVoice"},{"text":" sets itself as the","type":"text"},{"text":" ","type":"text"},{"text":"asset’s ","type":"text"},{"code":"AVAssetResourceLoaderDelegate","type":"codeVoice"},{"text":" for every stream, protected or not, and forwards","type":"text"},{"text":" ","type":"text"},{"text":"key requests to ","type":"text"},{"code":"DrmManager","type":"codeVoice"},{"text":" only when a config was supplied. Without one the request goes","type":"text"},{"text":" ","type":"text"},{"text":"unanswered and playback fails.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"visionOS"}],"type":"strong"},{"text":" has never supported that flow and uses","type":"text"},{"text":" ","type":"text"},{"code":"AVContentKeySession(keySystem: .fairPlayStreaming)","type":"codeVoice"},{"text":" with an ","type":"text"},{"code":"AVContentKeySessionDelegate","type":"codeVoice"},{"text":".","type":"text"},{"text":" ","type":"text"},{"text":"The session is built during ","type":"text"},{"code":"open","type":"codeVoice"},{"text":" only when a config is present.","type":"text"}]}]}]},{"type":"aside","style":"note","name":"Note","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"FairPlay needs the Secure Enclave, so it does not work in the visionOS simulator —"},{"type":"text","text":" "},{"type":"text","text":"constructing the content key session there raises an uncatchable exception. The SDK detects"},{"type":"text","text":" "},{"type":"text","text":"the simulator, skips the session, and logs instead of trapping, which means protected"},{"type":"text","text":" "},{"type":"text","text":"content will load but not decrypt. Verify DRM on a real Vision Pro."}]}]},{"type":"heading","level":2,"text":"Failure Modes","anchor":"Failure-Modes"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Symptom","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Cause","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"Protected stream plays black, or stalls at start","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Opened through "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":"; the geometry pipeline has no DRM path"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Content treated as clear despite a "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" block"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The block is missing "},{"type":"codeVoice","code":"ekid"},{"type":"text","text":", "},{"type":"codeVoice","code":"keyManagerUrl"},{"type":"text","text":", or "},{"type":"codeVoice","code":"drmProvider"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"License request rejected"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"JWT minting failed; the error is swallowed and an empty "},{"type":"codeVoice","code":"X-AxDRM-Message"},{"type":"text","text":" is sent, so the CKC fetch fails"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Works on device, fails in the visionOS simulator"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expected — FairPlay is unavailable there"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" block is detected but never honoured"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The stream is RTMP, played by "},{"type":"codeVoice","code":"LowLatencyPlayer"},{"type":"text","text":", which has no FairPlay path"}]}]]],"header":"row"}]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/DirectPlayer":{"role":"symbol","navigatorTitle":[{"kind":"identifier","text":"DirectPlayer"}]