{"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"kind":"article","metadata":{"modules":[{"name":"YBVRAppleSDK"}],"title":"Switching Player Mode","role":"article","roleHeading":"Article"},"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Move a playback session between the immersive player and a window without losing the stream."}],"seeAlsoSections":[{"generated":true,"anchor":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"title":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"A ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true,"type":"reference"},{"text":" belongs to the rendering context it was built for. The context is","type":"text"},{"text":" ","type":"text"},{"text":"fixed at init through its ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SurfaceContext","isActive":true,"type":"reference"},{"text":": a Compositor Services layer for the fully","type":"text"},{"text":" ","type":"text"},{"text":"rendered immersive player, a RealityKit entity for ","type":"text"},{"type":"codeVoice","code":"VideoPlayerComponent"},{"text":" content, or no","type":"text"},{"text":" ","type":"text"},{"text":"context at all for the windowed Metal surface behind ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","isActive":true,"type":"reference"},{"text":". None of those can","type":"text"},{"text":" ","type":"text"},{"text":"follow the viewer into a different scene, so letting someone move a video from an immersive","type":"text"},{"text":" ","type":"text"},{"text":"space into a window means building a second manager for the new surface.","type":"text"}]},{"inlineContent":[{"type":"text","text":"What that costs you is everything the first manager was holding: the playhead, whether it was"},{"type":"text","text":" "},{"type":"text","text":"playing, the selected camera, the audio and subtitle languages, and which ad breaks have"},{"type":"text","text":" "},{"type":"text","text":"already been seen. The manager cannot carry them across — it is going away — so hold that"},{"type":"text","text":" "},{"type":"text","text":"state outside it, and put it back once the new manager is streaming. This guide covers the"},{"type":"text","text":" "},{"type":"text","text":"hand-over; "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","type":"reference"},{"type":"text","text":" is the different case of keeping one manager and changing"},{"type":"text","text":" "},{"type":"text","text":"the video underneath it."}],"type":"paragraph"},{"level":2,"type":"heading","anchor":"Ending-the-Old-Manager-Without-Ending-the-Content","text":"Ending the Old Manager Without Ending the Content"},{"type":"paragraph","inlineContent":[{"text":"Take the state you need off the old manager, then tear it down with","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/stop(notifyEnded:)","type":"reference","isActive":true},{"type":"text","text":". Pass "},{"code":"notifyEnded: false","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isVideoEnded","type":"reference","isActive":true},{"text":" stays quiet — the video","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"is not over, and a host that dismisses its player UI on that signal would close the scene you"},{"text":" ","type":"text"},{"type":"text","text":"are about to move into:"}]},{"type":"codeListing","syntax":"swift","code":["struct SessionState {","    let position: Double","    let isPlaying: Bool","    let cameraId: Int?","    let audioLanguage: String","    let subtitlesLanguage: String","    let playedAdBreakIds: Set<String>","}","","func snapshot(of player: YBVRPlayerManager) -> SessionState {","    SessionState(","        position: player.videoPosition.value,","        isPlaying: player.videoStatus.value != .paused,","        cameraId: player.currentCamera()?.id,","        audioLanguage: player.currentAudioLanguagePublisher.value,","        subtitlesLanguage: player.currentSubtitlesLanguagePublisher.value,","        playedAdBreakIds: player.ads.playedIds.value","    )","}","","pending = snapshot(of: player)","player.stop(notifyEnded: false)"]},{"level":2,"type":"heading","anchor":"Restoring-on-the-New-Manager","text":"Restoring on the New Manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build the new manager with the surface context for the scene you are moving into, then replay"},{"type":"text","text":" "},{"type":"text","text":"the snapshot once "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","type":"reference","isActive":true},{"type":"text","text":" has returned:"}]},{"code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: context)","player.ads.markPlayed(pending.playedAdBreakIds)","","try await player.startStream(video: video, signaling)","","if let camera = pending.cameraId.flatMap({ id in player.cameras().first { $0.id == id } }) {","    await player.selectCamera(camera: camera)","}","if pending.position > 0 {","    player.seek(to: CMTimeMakeWithSeconds(pending.position, preferredTimescale: 1000))","}","await player.setAudioLanguage(language: pending.audioLanguage)","await player.setSubtitlesLanguage(language: pending.subtitlesLanguage)","","pending.isPlaying ? player.play() : player.pause()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Seek once the stream is actually ready — waiting for "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/videoStatus","type":"reference","isActive":true},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"report "},{"code":".ready","type":"codeVoice"},{"type":"text","text":" is enough — or the seek lands on an item that has no seekable range yet."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Live content without time shifting cannot be resumed at a position; check"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video\/isTimeShiftingAllowed","isActive":true},{"type":"text","text":" before restoring one, and let the new player join at the live"},{"type":"text","text":" "},{"type":"text","text":"edge otherwise."}]},{"level":2,"type":"heading","anchor":"Ads-Across-the-Swap","text":"Ads Across the Swap"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","type":"reference","isActive":true},{"type":"text","text":" is the one restore step that has to happen "},{"type":"emphasis","inlineContent":[{"type":"text","text":"before"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"new manager opens its stream, so call it as soon as the manager exists."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Two things go wrong without it. A pre-roll is armed at position zero on the fresh manager and"},{"type":"text","text":" "},{"type":"text","text":"plays again the moment content starts. And the restore seek jumps forward over any mid-roll"},{"type":"text","text":" "},{"type":"text","text":"the viewer has already watched, which is indistinguishable from someone skipping over one —"},{"type":"text","text":" "},{"type":"text","text":"so "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","type":"reference","isActive":true},{"type":"text","text":" re-arms it and it plays a second time."},{"type":"text","text":" "},{"type":"text","text":"Marking the ids from "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true},{"type":"text","text":" drops those breaks from the schedule and"},{"type":"text","text":" "},{"type":"text","text":"takes them out of the catch-up."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The schedule itself does not survive either: hand the new manager its breaks with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","isActive":true},{"type":"text","text":" the same way you did the first one. Order does not matter —"},{"type":"text","text":" "},{"type":"text","text":"marking before or after scheduling both work, and so does marking before the stream opens."}]},{"level":2,"type":"heading","anchor":"Surfaces-Draw-Different-Things","text":"Surfaces Draw Different Things"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not every surface renders the same overlays, so what your UI has to supply changes with the"},{"type":"text","text":" "},{"type":"text","text":"mode. Ask the manager rather than assuming:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"No surface draws subtitles: the cue from ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/currentSubtitleCue","isActive":true,"type":"reference"},{"text":" is always","type":"text"},{"text":" ","type":"text"},{"text":"yours to place. In the immersive Compositor Services renderer, where no window can go, draw","type":"text"},{"text":" ","type":"text"},{"text":"it into the video with an ","type":"text"},{"code":"ImmersiveOverlayRenderer","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersControlRoomMiniScreens","isActive":true,"type":"reference"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/hitTestCRMiniScreen(rayDirection:)","type":"reference","isActive":true},{"type":"text","text":" do anything. Where it is "},{"code":"false","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"text":"build the mini screens from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"},{"text":" with","type":"text"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]}]},{"level":2,"type":"heading","anchor":"Re-binding-Your-Subscriptions","text":"Re-binding Your Subscriptions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every publisher you were observing belonged to the old manager. Cancel those subscriptions as"},{"type":"text","text":" "},{"type":"text","text":"part of the swap and re-subscribe to the new manager, exactly as you would around a content"},{"type":"text","text":" "},{"type":"text","text":"switch. Anything you cached — the surface controller from"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/getSurfaceController()","type":"reference","isActive":true},{"type":"text","text":", a control room view model, a renderer — has to"},{"type":"text","text":" "},{"type":"text","text":"be re-read too."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"A counter that increments on every swap makes this easy to drive from SwiftUI: observe it,"},{"type":"text","text":" "},{"type":"text","text":"and rebuild your bindings whenever it changes."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/switchingplayermode"]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","role":"symbol","type":"topic","navigatorTitle":[{"kind":"identifier","text":"YBVRPlayerManager"}],"title":"YBVRPlayerManager","kind":"symbol","abstract":[{"type":"text","text":"YBVRPlayer is an object that provides the interface to display videos inside custom geometries."}],"fragments":[{"kind":"keyword","text":"class"},{"kind":"text","text":" "},{"kind":"identifier","text":"YBVRPlayerManager"}],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/showCRMiniScreens(_:)":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/showcrminiscreens(_:)","title":"showCRMiniScreens(_:)","type":"topic","kind":"symbol","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"show