":"playedIds","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/AdInsertion":{"kind":"article","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","type":"topic","abstract":[{"type":"text","text":"Schedule ad breaks against the content timeline and drive your own ad UI."}],"title":"Inserting Ads","role":"article","url":"\/documentation\/ybvrapplesdk\/adinsertion"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/getSurfaceController()":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/getSurfaceController()","role":"symbol","type":"topic","title":"getSurfaceController()","kind":"symbol","abstract":[],"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"getSurfaceController"},{"text":"() -> ","kind":"text"},{"preciseIdentifier":"s:12YBVRAppleSDK20IOSSurfaceControllerC","kind":"typeIdentifier","text":"IOSSurfaceController"}],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/getsurfacecontroller()"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"url":"\/documentation\/ybvrapplesdk","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"type":"topic","title":"YBVRAppleSDK","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/surfaceRendersControlRoomMiniScreens":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersControlRoomMiniScreens","role":"symbol","type":"topic","title":"surfaceRendersControlRoomMiniScreens","abstract":[],"kind":"symbol","fragments":[{"text":"var","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"surfaceRen