,{"text":"ControlRoomView","kind":"identifier"}],"type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView","url":"\/documentation\/ybvrapplesdk\/controlroomview"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager":{"kind":"symbol","title":"YBVRPlayerManager","type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager","abstract":[{"type":"text","text":"YBVRPlayer is an object that provides the interface to display videos inside custom geometries."}],"role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YBVRPlayerManager","kind":"identifier"}],"navigatorTitle":[{"text":"YBVRPlayerManager","kind":"identifier"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/isVideoEnded":{"kind":"symbol","title":"isVideoEnded","abstract":[],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isVideoEnded","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/isvideoended","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVideoEnded"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Combine18PassthroughSubjectC","kind":"typeIdentifier","text":"PassthroughSubject"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"preciseIdentifier":"s:s5NeverO","kind":"typeIdentifier","text":"Never"},{"kind":"text","text":">"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/surfaceRendersSubtitles":{"abstract":[],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersSubtitles","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "