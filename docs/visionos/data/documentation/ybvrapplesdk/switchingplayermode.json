", "},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK18SignalingInterfaceP","text":"SignalingInterface"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"abstract":[{"text":"Opens ","type":"text"},{"code":"video","type":"codeVoice"},{"text":" and starts playing it.","type":"text"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","kind":"symbol","role":"symbol","type":"topic","title":"startStream(video:_:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/markPlayed(_:)":{"url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/markplayed(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"markPlayed","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Set","kind":"typeIdentifier","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">)","kind":"text"}],"abstract":[],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","kind":"symbol","role":"symbol","title":"markPlayed(_:)","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/isVideoEnded":{"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/isvideoended","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"isVideoEnded"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Combine18PassthroughSubjectC","text":"PassthroughSubject"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sb","text":"Bool"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO","text":"Never"},{"kind":"text","text":">"}],"abstract":[],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isVideoEnded","kind":"symbol","role":"symbol","type":"topic","title":"isVideoEnded"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/hitTestCRMiniScreen(rayDirection:)":{"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/hittestcrminiscreen(raydirection:)","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hitTestCRMiniScreen"},{"kind":"text","text":"("},{"kind":"externalParam","text":"rayDirection"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"c:@T@simd_float3","text":"simd_float3"},{"kind":"text","text":") -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:Si","text":"Int"},{"kind":"text","text":"?"}],"abstract":[{"type":"text","text":"Only a surface that draws its own mini screens answers - see "},{"type":"codeVoice","code":"surfaceRendersControlRoomMiniScreens"},{"type":"text","text":"."}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/hitTestCRMiniScreen(rayDirection:)","kind":"symbol","role":"symbol","type":"topic","title":"hitTestCRMiniScreen(rayDirection:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/ControlRoomView":{"abstract":[],"title":"ControlRoomView","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView","kind":"symbol","navigatorTitle":[{"text":"ControlRoomView","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ControlRoomView","kind":"identifier"}],"url":"\/documentation\/ybvrapplesdk\/controlroomview","type":"topic","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/AdInsertion":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","abstract":[{"text":"Schedule ad breaks against the content timeline and drive your own ad UI.","type":"text"}],"type":"topic","role":"article","url":"\/documentation\/ybvrapplesdk\/adinsertion","tit