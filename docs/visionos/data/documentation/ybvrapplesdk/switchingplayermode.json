ifier"},{"text":": ","kind":"text"},{"text":"CurrentValueSubject","kind":"typeIdentifier","preciseIdentifier":"s:7Combine19CurrentValueSubjectC"},{"text":"<","kind":"text"},{"text":"VideoStatus","kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK11VideoStatusO"},{"text":"?, ","kind":"text"},{"kind":"typeIdentifier","text":"Never","preciseIdentifier":"s:s5NeverO"},{"kind":"text","text":">"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/videoStatus","title":"videoStatus","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/videostatus","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/hitTestCRMiniScreen(rayDirection:)":{"fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"hitTestCRMiniScreen","kind":"identifier"},{"text":"(","kind":"text"},{"text":"rayDirection","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"simd_float3","kind":"typeIdentifier","preciseIdentifier":"c:@T@simd_float3"},{"text":") -> ","kind":"text"},{"text":"Int","kind":"typeIdentifier","preciseIdentifier":"s:Si"},{"text":"?","kind":"text"}],"kind":"symbol","type":"topic","title":"hitTestCRMiniScreen(rayDirection:)","role":"symbol","abstract":[{"type":"text","text":"Only a surface that draws its own mini screens answers - see "},{"type":"codeVoice","code":"surfaceRendersControlRoomMiniScreens"},{"type":"text","text":"."}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/hitTestCRMiniScreen(rayDirection:)","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/hittestcrminiscreen(raydirection:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/showCRMiniScreens(_:)":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)","title":"showCRMiniScreens(_:)","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/showcrminiscreens(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showCRMiniScreens","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"},{"text":")","kind":"text"}],"kind":"symbol","type":"topic","abstract":[],"role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Video/isTimeShiftingAllowed":{"type":"topic","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTimeShiftingAllowed"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video\/isTimeShiftingAllowed","title":"isTimeShiftingAllowed","url":"\/documentation\/ybvrapplesdk\/video\/istimeshiftingallowed","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Drm":{"kind":"article","title":"FairPlay DRM","type":"topic","role":"article","abstract":[{"text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is.","type":"text"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm","url":"\/documentation\/ybvrapplesdk\/drm"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/AdInsertion":{"kind":"article","title":"Inserting Ads","type":"topic","role":"article","abstract":[{"type":"text","text":"Schedule ad breaks against the content timeline and drive your own ad UI."}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","url":"\/documentation\/ybvrapplesdk\/adinsertion"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/startStream(video:_:)":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","title":"startStream(video:_:)","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/startstream(vid