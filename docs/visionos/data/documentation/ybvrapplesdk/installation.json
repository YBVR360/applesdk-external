{"abstract":[{"text":"Add YBVRAppleSDK to your iOS or visionOS project.","type":"text"}],"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"role":"article","roleHeading":"Article","title":"Installation"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"type":"text","text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"own repositories — YBVR provides you with a "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory containing everything"},{"type":"text","text":" "},{"type":"text","text":"required."}],"type":"paragraph"},{"anchor":"Requirements","level":3,"text":"Requirements","type":"heading"},{"rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum OS"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Xcode","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"17.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"16.2 or later"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"visionOS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26.0 or later"}],"type":"paragraph"}]]],"header":"row","type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An Apple silicon Mac is required to build."}]},{"type":"heading","text":"Step 1 — Obtain the SDK Package","anchor":"Step-1-Obtain-the-SDK-Package","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVR delivers the SDK as a "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory with this layout:"}]},{"code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"],"type":"codeListing","syntax":null},{"type":"paragraph","inlineContent":[{"text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package","type":"text"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}]},{"style":"important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the "},{"code":"frameworks","type":"codeVoice"},{"text":" directory next to ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":". The package refers to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution."}]}],"name":"Important"},{"type":"paragraph","inlineContent":[{"text":"Place the directory anywhere inside — or alongside — your project. A common choice is a","type":"text"},{"text":" ","type":"text"},{"code":"Vendor\/","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ThirdParty\/","type":"codeVoice"},{"text":" folder in your repository root.","type":"text"}]},{"type":"heading","text":"Step 2 — Add the Package to Your Project","anchor":"Step-2-Add-the-Package-to-Your-Project","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select "},{"inlineContent":[{"type":"text","text":"File ▸ Add Package Dependencies…"}],"type":"strong"}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Click "},{"type":"strong","inlineContent":[{"type":"text","text":"Add Local…"}]},{"type":"text","text":" in the bottom-left of the dialog."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Choose the ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory (the one containing ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":") and click"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Add Package"}]},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"text":"In the target chooser, add the ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" library product to your app target.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"To reference it from your own Swift package instead, declare it as a local path dependency:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"]},{"type":"paragraph","inlineContent":[{"text":"The product bundles every binary target the SDK needs, so this single dependency is","type":"text"},{"text":" ","type":"text"},{"text":"sufficient — you never list ","type":"text"},{"code":"KSPlayer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Yams","type":"codeVoice"},{"text":", or the FFmpeg targets yourself.","type":"text"}]},{"text":"Step 3 — Confirm the Link","anchor":"Step-3-Confirm-the-Link","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}],"type":"paragraph"},{"type":"codeListing","code":["import YBVRAppleSDK"],"syntax":"swift"},{"inlineContent":[{"text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need","type":"text"},{"type":"text","text":" "},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"text":" ","type":"text"},{"type":"text","text":"link time, the usual cause is that the"},{"type":"text","text":" "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"text":" library product was not added to the target in Step 2.4 — check","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content","type":"text"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Step 4 — Run a Demo App","level":2,"type":"heading","anchor":"Step-4-Run-a-Demo-App"},{"inlineContent":[{"text":"The delivered package includes working demo apps for both platforms under ","type":"text"},{"code":"Examples\/","type":"codeVoice"},{"text":". They","type":"text"},{"text":" ","type":"text"},{"text":"are the fastest way to confirm your setup and to see the integration patterns in context:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj"}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj"}],"type":"paragraph"}]}],"type":"unorderedList"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both projects already reference the delivered package by relative path, so they build as"},{"type":"text","text":" "},{"text":"delivered without further configuration — leave the ","type":"text"},{"code":"Examples","type":"codeVoice"},{"text":" directory inside the package.","type":"text"}]},{"level":2,"anchor":"Next-Steps","type":"heading","text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","type":"reference"},{"text":" — load configuration, create a player, and start streaming.","type":"text"}]}]}]}],"kind":"content"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"sections":[],"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation","interfaceLanguage":"swift"},"seeAlsoSections":[{"generated":true,"anchor":"Getting-Started","title":"Getting Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"]}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"url":"\/documentation\/ybvrapplesdk","type":"topic","abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"title":"YBVRAppleSDK","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","kind":"symbol","role":"collection"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","title":"Quick Start","kind":"article","abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"type":"topic","url":"\/documentation\/ybvrapplesdk\/quickstart","role":"article"}}}