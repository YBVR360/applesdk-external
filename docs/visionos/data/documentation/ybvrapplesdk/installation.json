{"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"sections":[],"seeAlsoSections":[{"anchor":"Getting-Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"title":"Getting Started","generated":true}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","anchor":"Overview","text":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"type":"text","text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"own repositories — YBVR provides you with a "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory containing everything"},{"type":"text","text":" "},{"type":"text","text":"required."}]},{"type":"heading","anchor":"Requirements","text":"Requirements","level":3},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Platform"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Minimum OS"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Xcode"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"iOS"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"17.0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"16.2 or later"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"26.0"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"26.0 or later"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An Apple silicon Mac is required to build."}]},{"type":"heading","anchor":"Step-1-Obtain-the-SDK-Package","text":"Step 1 — Obtain the SDK Package","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVR delivers the SDK as a "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory with this layout:"}]},{"type":"codeListing","syntax":null,"code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the "},{"type":"codeVoice","code":"frameworks"},{"type":"text","text":" directory next to "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":". The package refers to"},{"type":"text","text":" "},{"type":"text","text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution."}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Place the directory anywhere inside — or alongside — your project. A common choice is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Vendor\/"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ThirdParty\/"},{"type":"text","text":" folder in your repository root."}]},{"type":"heading","anchor":"Step-2-Add-the-Package-to-Your-Project","text":"Step 2 — Add the Package to Your Project","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select ","type":"text"},{"inlineContent":[{"type":"text","text":"File ▸ Add Package Dependencies…"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Click ","type":"text"},{"inlineContent":[{"text":"Add Local…","type":"text"}],"type":"strong"},{"text":" in the bottom-left of the dialog.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory (the one containing "},{"code":"Package.swift","type":"codeVoice"},{"text":") and click","type":"text"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Add Package","type":"text"}]},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the target chooser, add the ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" library product to your app target.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To reference it from your own Swift package instead, declare it as a local path dependency:"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The product bundles every binary target the SDK needs, so this single dependency is"},{"type":"text","text":" "},{"type":"text","text":"sufficient — you never list "},{"type":"codeVoice","code":"KSPlayer"},{"type":"text","text":", "},{"type":"codeVoice","code":"Yams"},{"type":"text","text":", or the FFmpeg targets yourself."}]},{"type":"heading","anchor":"Step-3-Confirm-the-Link","text":"Step 3 — Confirm the Link","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}]},{"type":"codeListing","syntax":"swift","code":["import YBVRAppleSDK"]},{"type":"paragraph","inlineContent":[{"text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"text":" ","type":"text"},{"type":"text","text":"link time, the usual cause is that the"},{"text":" ","type":"text"},{"type":"codeVoice","code":"YBVRAppleSDK"},{"text":" library product was not added to the target in Step 2.4 — check","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content","type":"text"}]},{"text":".","type":"text"}]},{"type":"heading","anchor":"Step-4-Run-a-Demo-App","text":"Step 4 — Run a Demo App","level":2},{"type":"paragraph","inlineContent":[{"text":"The delivered package includes working demo apps for both platforms under ","type":"text"},{"type":"codeVoice","code":"Examples\/"},{"text":". They","type":"text"},{"text":" ","type":"text"},{"text":"are the fastest way to confirm your setup and to see the integration patterns in context:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both projects already reference the delivered package by relative path, so they build as"},{"type":"text","text":" "},{"type":"text","text":"delivered without further configuration — leave the "},{"type":"codeVoice","code":"Examples"},{"type":"text","text":" directory inside the package."}]},{"type":"heading","anchor":"Next-Steps","text":"Next Steps","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","isActive":true},{"text":" — load configuration, create a player, and start streaming.","type":"text"}]}]}]}]}],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Add YBVRAppleSDK to your iOS or visionOS project."}],"schemaVersion":{"patch":0,"major":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}],"role":"article","title":"Installation"},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"kind":"article","role":"article","abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"type":"topic","title":"Quick Start","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","url":"\/documentation\/ybvrapplesdk\/quickstart"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"kind":"symbol","abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"url":"\/documentation\/ybvrapplesdk","type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","title":"YBVRAppleSDK","role":"collection"}}}