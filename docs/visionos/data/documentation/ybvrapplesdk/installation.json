{"sections":[],"seeAlsoSections":[{"anchor":"Getting-Started","title":"Getting Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"generated":true}],"kind":"article","identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"patch":0,"minor":3},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"abstract":[{"text":"Add YBVRAppleSDK to your iOS or visionOS project.","type":"text"}],"primaryContentSections":[{"content":[{"text":"Overview","type":"heading","level":2,"anchor":"Overview"},{"inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"type":"text","text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"own repositories — YBVR provides you with a "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory containing everything"},{"type":"text","text":" "},{"type":"text","text":"required."}],"type":"paragraph"},{"text":"Requirements","type":"heading","level":3,"anchor":"Requirements"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum OS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Xcode"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"17.0"}]}],[{"inlineContent":[{"text":"16.2 or later","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"visionOS"}]}],[{"inlineContent":[{"text":"26.0","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"26.0 or later"}]}]]],"header":"row"},{"inlineContent":[{"text":"An Apple silicon Mac is required to build.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Step 1 — Obtain the SDK Package","anchor":"Step-1-Obtain-the-SDK-Package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVR delivers the SDK as a "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory with this layout:"}]},{"syntax":null,"type":"codeListing","code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS Sample Scene apps","│   ├── Shared               \/\/ playback code and UI both apps share","│   ├── iOS\/SampleScene","│   └── visionOS\/SampleScene","└── docs\/                    \/\/ offline copy of this reference"]},{"inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}],"type":"paragraph"},{"content":[{"inlineContent":[{"type":"text","text":"Keep the "},{"code":"frameworks","type":"codeVoice"},{"type":"text","text":" directory next to "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":". The package refers to"},{"type":"text","text":" "},{"type":"text","text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution."}],"type":"paragraph"}],"name":"Important","type":"aside","style":"important"},{"inlineContent":[{"type":"text","text":"Place the directory anywhere inside — or alongside — your project. A common choice is a"},{"type":"text","text":" "},{"code":"Vendor\/","type":"codeVoice"},{"type":"text","text":" or "},{"code":"ThirdParty\/","type":"codeVoice"},{"type":"text","text":" folder in your repository root."}],"type":"paragraph"},{"text":"Step 2 — Add the Package to Your Project","type":"heading","level":2,"anchor":"Step-2-Add-the-Package-to-Your-Project"},{"inlineContent":[{"type":"text","text":"In Xcode:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Select ","type":"text"},{"inlineContent":[{"type":"text","text":"File ▸ Add Package Dependencies…"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Click ","type":"text"},{"inlineContent":[{"type":"text","text":"Add Local…"}],"type":"strong"},{"text":" in the bottom-left of the dialog.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the ","type":"text"},{"type":"codeVoice","code":"YBVRAppleSDK"},{"text":" directory (the one containing ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":") and click","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Add Package"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In the target chooser, add the ","type":"text"},{"type":"codeVoice","code":"YBVRAppleSDK"},{"text":" library product to your app target.","type":"text"}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"To reference it from your own Swift package instead, declare it as a local path dependency:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"]},{"inlineContent":[{"type":"text","text":"The product bundles every binary target the SDK needs, so this single dependency is"},{"type":"text","text":" "},{"type":"text","text":"sufficient — you never list "},{"code":"KSPlayer","type":"codeVoice"},{"type":"text","text":", "},{"code":"Yams","type":"codeVoice"},{"type":"text","text":", or the FFmpeg targets yourself."}],"type":"paragraph"},{"text":"Step 3 — Confirm the Link","type":"heading","level":2,"anchor":"Step-3-Confirm-the-Link"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}]},{"code":["import YBVRAppleSDK"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need"},{"type":"text","text":" "},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"type":"text","text":" "},{"type":"text","text":"link time, the usual cause is that the"},{"type":"text","text":" "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"text":" library product was not added to the target in Step 2.4 — check","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Step 4 — Run a Sample Scene","type":"heading","level":2,"anchor":"Step-4-Run-a-Sample-Scene"},{"inlineContent":[{"type":"text","text":"The delivered package includes a working Sample Scene app for both platforms under"},{"type":"text","text":" "},{"code":"Examples\/","type":"codeVoice"},{"type":"text","text":". They are the fastest way to confirm your setup and to see the integration"},{"type":"text","text":" "},{"type":"text","text":"patterns in context:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Examples\/iOS\/SampleScene\/SampleScene-iOS.xcodeproj"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Examples\/visionOS\/SampleScene\/SampleScene-VisionOS.xcodeproj"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Both projects already reference the delivered package by relative path, so they build as","type":"text"},{"type":"text","text":" "},{"text":"delivered without further configuration — leave the ","type":"text"},{"type":"codeVoice","code":"Examples"},{"text":" directory inside the package.","type":"text"}]},{"level":2,"type":"heading","anchor":"Next-Steps","text":"Next Steps"},{"items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","type":"reference","isActive":true},{"text":" — load configuration, create a player, and start streaming.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"metadata":{"role":"article","modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article","title":"Installation"},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"url":"\/documentation\/ybvrapplesdk","kind":"symbol","role":"collection","abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"type":"topic","title":"YBVRAppleSDK","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"kind":"article","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","type":"topic","abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"title":"Quick Start","role":"article","url":"\/documentation\/ybvrapplesdk\/quickstart"}}}