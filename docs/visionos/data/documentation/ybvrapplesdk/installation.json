e":"text"}]},{"level":2,"text":"Step 1 — Obtain the SDK Package","type":"heading","anchor":"Step-1-Obtain-the-SDK-Package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVR delivers the SDK as a "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory with this layout:"}]},{"code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"],"type":"codeListing","syntax":null},{"inlineContent":[{"text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package","type":"text"},{"text":" ","type":"text"},{"text":"serves every build configuration.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the "},{"code":"frameworks","type":"codeVoice"},{"type":"text","text":" directory next to "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":". The package refers to"},{"type":"text","text":" "},{"type":"text","text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution."}]}],"style":"important","type":"aside","name":"Important"},{"type":"paragraph","inlineContent":[{"text":"Place the directory anywhere inside — or alongside — your project. A common choice is a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"Vendor\/"},{"text":" or ","type":"text"},{"code":"ThirdParty\/","type":"codeVoice"},{"text":" folder in your repository root.","type":"text"}]},{"level":2,"t