{"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s","type":"text"},{"text":" ","type":"text"},{"text":"own repositories — YBVR provides you with a ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory containing everything","type":"text"},{"text":" ","type":"text"},{"text":"required.","type":"text"}]},{"text":"Requirements","anchor":"Requirements","type":"heading","level":3},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum OS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Xcode"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"17.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"16.2 or later"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"visionOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26.0 or later"}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"text":"An Apple silicon Mac is required to build.","type":"text"}]},{"text":"Step 1 — Obtain the SDK Package","anchor":"Step-1-Obtain-the-SDK-Package","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"YBVR delivers the SDK as a ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory with this layout:","type":"text"}]},{"syntax":null,"code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Keep the ","type":"text"},{"type":"codeVoice","code":"frameworks"},{"text":" directory next to ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":". The package refers to","type":"text"},{"text":" ","type":"text"},{"text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution.","type":"text"}]}],"style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Place the directory anywhere inside — or alongside — your project. A common choice is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Vendor\/"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ThirdParty\/"},{"type":"text","text":" folder in your repository root."}]},{"text":"Step 2 — Add the Package to Your Project","anchor":"Step-2-Add-the-Package-to-Your-Project","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select "},{"inlineContent":[{"type":"text","text":"File ▸ Add Package Dependencies…"}],"type":"strong"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click "},{"inlineContent":[{"type":"text","text":"Add Local…"}],"type":"strong"},{"type":"text","text":" in the bottom-left of the dialog."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory (the one containing "},{"code":"Package.swift","type":"codeVoice"},{"type":"text","text":") and click"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Add Package"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"In the target chooser, add the "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" library product to your app target."}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"To reference it from your own Swift package instead, declare it as a local path dependency:"}]},{"syntax":"swift","code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The product bundles every binary target the SDK needs, so this single dependency is"},{"type":"text","text":" "},{"type":"text","text":"sufficient — you never list "},{"code":"KSPlayer","type":"codeVoice"},{"type":"text","text":", "},{"code":"Yams","type":"codeVoice"},{"type":"text","text":", or the FFmpeg targets yourself."}]},{"text":"Step 3 — Confirm the Link","anchor":"Step-3-Confirm-the-Link","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}]},{"syntax":"swift","code":["import YBVRAppleSDK"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need"},{"type":"text","text":" "},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"type":"text","text":" "},{"type":"text","text":"link time, the usual cause is that the"},{"type":"text","text":" "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" library product was not added to the target in Step 2.4 — check"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"type":"text","text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content"}]},{"type":"text","text":"."}]},{"text":"Step 4 — Run a Demo App","anchor":"Step-4-Run-a-Demo-App","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delivered package includes working demo apps for both platforms under "},{"code":"Examples\/","type":"codeVoice"},{"type":"text","text":". They"},{"type":"text","text":" "},{"type":"text","text":"are the fastest way to confirm your setup and to see the integration patterns in context:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Both projects already reference the delivered package by relative path, so they build as"},{"type":"text","text":" "},{"type":"text","text":"delivered without further configuration — leave the "},{"code":"Examples","type":"codeVoice"},{"type":"text","text":" directory inside the package."}]},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","isActive":true},{"type":"text","text":" — load configuration, create a player, and start streaming."}]}]}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},"abstract":[{"text":"Add YBVRAppleSDK to your iOS or visionOS project.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"kind":"article","metadata":{"role":"article","title":"Installation","modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article"},"sections":[],"seeAlsoSections":[{"title":"Getting Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"anchor":"Getting-Started","generated":true}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"title":"Quick Start","url":"\/documentation\/ybvrapplesdk\/quickstart","role":"article","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"kind":"article","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"abstract":[{"text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS.","type":"text"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","role":"collection","url":"\/documentation\/ybvrapplesdk","kind":"symbol","title":"YBVRAppleSDK","type":"topic"}}}