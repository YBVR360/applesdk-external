e":"codeVoice"},{"text":", or the FFmpeg targets yourself.","type":"text"}]},{"anchor":"Step-3-Confirm-the-Link","text":"Step 3 — Confirm the Link","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}]},{"syntax":"swift","code":["import YBVRAppleSDK"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need"},{"text":" ","type":"text"},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"text":" ","type":"text"},{"text":"link time, the usual cause is that the","type":"text"},{"type":"text","text":" "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" library product was not added to the target in Step 2.4 — check"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":"."}]},{"anchor":"Step-4-Run-a-Demo-App","text":"Step 4 — Run a Demo App","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The delivered package includes working demo apps for both platforms under "},{"code":"Examples\/","type":"codeVoice"},{"type":"text","text":". They"},{"type":"text","text":" "},{"type":"text","text":"are the fastest way to confirm your setup and to see the integration patterns in context:"}]},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj"}]}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both projects already reference the delivered package by relative path, so they build as"},{"type":"text","text":" "},{"type":"text","