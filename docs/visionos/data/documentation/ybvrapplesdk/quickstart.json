{"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"seeAlsoSections":[{"anchor":"Getting-Started","title":"Getting Started","generated":true,"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"This guide walks through the minimum steps to load the SDK configuration, create a player, and start streaming a 360° video. Follow the iOS section for a standard SwiftUI app, or the VisionOS section for an immersive spatial experience."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you have not added the SDK to your project yet, start with "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Step 1 — Load the App Configuration","anchor":"Step-1-Load-the-App-Configuration","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Before creating a player, fetch your app’s remote configuration using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader"},{"text":". This is an async call — do it once at app launch and store the result.","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Wire it into your SwiftUI entry point:"}],"type":"paragraph"},{"code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"tip","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development","isActive":true,"type":"reference"},{"text":" or ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test","isActive":true,"type":"reference"},{"text":" during integration to target non-production backends.","type":"text"}],"type":"paragraph"}],"name":"Tip","type":"aside"},{"text":"Step 2 — Create a Player","anchor":"Step-2-Create-a-Player","level":2,"type":"heading"},{"inlineContent":[{"text":"Instantiate ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference"},{"text":" once you have the configuration. Always use ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig","type":"reference"},{"text":" unless you have specific requirements.","type":"text"}],"type":"paragraph"},{"text":"iOS","anchor":"iOS","level":3,"type":"heading"},{"inlineContent":[{"text":"On iOS no surface context is needed — the SDK manages rendering internally.","type":"text"}],"type":"paragraph"},{"code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"syntax":"swift","type":"codeListing"},{"text":"VisionOS — Flat Window","anchor":"VisionOS-Flat-Window","level":3,"type":"heading"},{"inlineContent":[{"text":"For standard 2D window playback on VisionOS, use ","type":"text"},{"code":"surfaceContext: nil","type":"codeVoice"},{"text":" just like iOS:","type":"text"}],"type":"paragraph"},{"code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"syntax":"swift","type":"codeListing"},{"text":"VisionOS — Immersive (CompositorLayer)","anchor":"VisionOS-Immersive-CompositorLayer","level":3,"type":"heading"},{"inlineContent":[{"text":"For a fully immersive experience, create a ","type":"text"},{"code":"VisionSurfaceContext","type":"codeVoice"},{"text":" from the ","type":"text"},{"code":"LayerRenderer","type":"codeVoice"},{"text":" provided by ","type":"text"},{"code":"CompositorLayer","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift","type":"codeListing"},{"text":"VisionOS — Immersive (RealityKit \/ APMP)","anchor":"VisionOS-Immersive-RealityKit--APMP","level":3,"type":"heading"},{"inlineContent":[{"text":"For RealityKit-based spatial playback, attach the context to a RealityKit ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 3 — Set Up Analytics (Optional)","anchor":"Step-3-Set-Up-Analytics-Optional","level":2,"type":"heading"},{"inlineContent":[{"text":"If your ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration","type":"reference"},{"text":" includes analytics, attach a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker","type":"reference"},{"text":" to the player right after creation:","type":"text"}],"type":"paragraph"},{"code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 4 — Start Streaming","anchor":"Step-4-Start-Streaming","level":2,"type":"heading"},{"inlineContent":[{"text":"Call ","type":"text"},{"code":"startStream(video:_:)","type":"codeVoice"},{"text":" with the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","type":"reference"},{"text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling ","type":"text"},{"code":"startStream","type":"codeVoice"},{"text":" speeds up player initialization by avoiding network request inside the SDK.","type":"text"}],"type":"paragraph"},{"code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:","type":"text"}],"type":"paragraph"},{"code":["player.getRenderer()?.startRenderLoop()"],"syntax":"swift","type":"codeListing"},{"text":"Step 5 — Embed the Player View","anchor":"Step-5-Embed-the-Player-View","level":2,"type":"heading"},{"text":"iOS and VisionOS Flat — GeometryVideoView","anchor":"iOS-and-VisionOS-Flat-GeometryVideoView","level":3,"type":"heading"},{"inlineContent":[{"text":"Wrap ","type":"text"},{"code":"GeometryVideoView","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"GeometryReader","type":"codeVoice"},{"text":" to maintain the correct aspect ratio:","type":"text"}],"type":"paragraph"},{"code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"VisionOS — RealityView (APMP)","anchor":"VisionOS-RealityView-APMP","level":3,"type":"heading"},{"code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":3,"text":"VisionOS — CompositorLayer","anchor":"VisionOS-CompositorLayer"},{"type":"codeListing","syntax":"swift","code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"]},{"type":"heading","level":2,"text":"Step 6 — Observe Player State","anchor":"Step-6-Observe-Player-State"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference"},{"text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use ","type":"text"},{"code":"[weak self]","type":"codeVoice"},{"text":" captures.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"]},{"text":"Step 7 — Multi-Audio and Subtitles","type":"heading","level":2,"anchor":"Step-7-Multi-Audio-and-Subtitles"},{"type":"paragraph","inlineContent":[{"text":"Retrieve available languages from the player and filter them per active camera for control room streams:","type":"text"}]},{"syntax":"swift","code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"],"type":"codeListing"},{"text":"Step 8 — Handle Errors","type":"heading","level":2,"anchor":"Step-8-Handle-Errors"},{"type":"paragraph","inlineContent":[{"text":"Errors thrown by ","type":"text"},{"code":"startStream(video:_:)","type":"codeVoice"},{"text":" cover setup failures: a signaling file that cannot be","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fetched or decoded, signaling that offers no camera to play ("},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera","isActive":true,"type":"reference"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"and a stream that cannot be opened. ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","isActive":true,"type":"reference"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"text":"the same signaling errors when you pre-fetch. ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError","isActive":true,"type":"reference"},{"text":" conforms to ","type":"text"},{"code":"LocalizedError","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" is fit to show.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Once playback is under way, failures arrive on ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"syntax":"swift","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in self?.loadFailure = error.localizedDescription }","    .store(in: &cancellables)"],"type":"codeListing"},{"text":"Next Steps","type":"heading","level":2,"anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true,"type":"reference"},{"type":"text","text":" — move a live player to another video with"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true,"type":"reference"},{"type":"text","text":" instead of rebuilding it, and chain items with"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true,"type":"reference"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","isActive":true,"type":"reference"},{"type":"text","text":" — schedule ad breaks through "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true,"type":"reference"},{"type":"text","text":" and drive your own ad UI."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle control room camera switching via "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","isActive":true,"type":"reference"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recenter the camera with "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/recenterCameraPosition()","isActive":true,"type":"reference"}]}]}]}]}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/quickstart"],"traits":[{"interfaceLan