{"metadata":{"roleHeading":"Article","title":"Quick Start","modules":[{"name":"YBVRAppleSDK"}],"role":"article"},"abstract":[{"text":"Get up and running with YBVR video playback in your iOS or VisionOS app.","type":"text"}],"seeAlsoSections":[{"generated":true,"title":"Getting Started","anchor":"Getting-Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"]}],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"type":"text","text":"This guide walks through the minimum steps to load the SDK configuration, create a player, and start streaming a 360° video. Follow the iOS section for a standard SwiftUI app, or the VisionOS section for an immersive spatial experience."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"If you have not added the SDK to your project yet, start with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},{"text":".","type":"text"}]},{"anchor":"Step-1-Load-the-App-Configuration","type":"heading","level":2,"text":"Step 1 — Load the App Configuration"},{"inlineContent":[{"type":"text","text":"Before creating a player, fetch your app’s remote configuration using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader"},{"type":"text","text":". This is an async call — do it once at app launch and store the result."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Wire it into your SwiftUI entry point:","type":"text"}]},{"code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"type":"aside","name":"Tip","style":"tip","content":[{"inlineContent":[{"type":"text","text":"Use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development"},{"text":" or ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test"},{"type":"text","text":" during integration to target non-production backends."}],"type":"paragraph"}]},{"level":2,"type":"heading","anchor":"Step-2-Create-a-Player","text":"Step 2 — Create a Player"},{"inlineContent":[{"type":"text","text":"Instantiate "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" once you have the configuration. Always use "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig","isActive":true},{"type":"text","text":" unless you have specific requirements."}],"type":"paragraph"},{"type":"heading","level":3,"text":"iOS","anchor":"iOS"},{"inlineContent":[{"text":"On iOS no surface context is needed — the SDK manages rendering internally.","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"type":"codeListing"},{"type":"heading","level":3,"text":"VisionOS — Flat Window","anchor":"VisionOS-Flat-Window"},{"inlineContent":[{"text":"For standard 2D window playback on VisionOS, use ","type":"text"},{"code":"surfaceContext: nil","type":"codeVoice"},{"text":" just like iOS:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"type":"codeListing"},{"type":"heading","anchor":"VisionOS-Immersive-CompositorLayer","level":3,"text":"VisionOS — Immersive (CompositorLayer)"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a fully immersive experience, create a "},{"code":"VisionSurfaceContext","type":"codeVoice"},{"type":"text","text":" from the "},{"code":"LayerRenderer","type":"codeVoice"},{"type":"text","text":" provided by "},{"code":"CompositorLayer","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift"},{"anchor":"VisionOS-Immersive-RealityKit--APMP","level":3,"text":"VisionOS — Immersive (RealityKit \/ APMP)","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For RealityKit-based spatial playback, attach the context to a RealityKit "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":":"}]},{"code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 3 — Set Up Analytics (Optional)","anchor":"Step-3-Set-Up-Analytics-Optional"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration"},{"text":" includes analytics, attach a ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker","isActive":true},{"text":" to the player right after creation:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"]},{"type":"heading","text":"Step 4 — Start Streaming","anchor":"Step-4-Start-Streaming","level":2},{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"startStream(video:_:)"},{"type":"text","text":" with the "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","type":"reference","isActive":true},{"type":"text","text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling "},{"type":"codeVoice","code":"startStream"},{"type":"text","text":" speeds up player initialization by avoiding network request inside the SDK."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"]},{"inlineContent":[{"type":"text","text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["player.getRenderer()?.startRenderLoop()"]},{"type":"heading","level":2,"text":"Step 5 — Embed the Player View","anchor":"Step-5-Embed-the-Player-View"},{"type":"heading","level":3,"text":"iOS and VisionOS Flat — GeometryVideoView","anchor":"iOS-and-VisionOS-Flat-GeometryVideoView"},{"inlineContent":[{"text":"Wrap ","type":"text"},{"code":"GeometryVideoView","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"GeometryReader","type":"codeVoice"},{"text":" to maintain the correct aspect ratio:","type":"text"}],"type":"paragraph"},{"code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"],"syntax":"swift","type":"codeListing"},{"text":"VisionOS — RealityView (APMP)","anchor":"VisionOS-RealityView-APMP","level":3,"type":"heading"},{"code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"level":3,"anchor":"VisionOS-CompositorLayer","text":"VisionOS — CompositorLayer","type":"heading"},{"code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-6-Observe-Player-State","text":"Step 6 — Observe Player State","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use ","type":"text"},{"type":"codeVoice","code":"[weak self]"},{"text":" captures.","type":"text"}],"type":"paragraph"},{"code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"anchor":"Step-7-Multi-Audio-and-Subtitles","text":"Step 7 — Multi-Audio and Subtitles","type":"heading"},{"inlineContent":[{"text":"Retrieve available languages from the player and filter them per active camera for control room streams:","type":"text"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"]},{"text":"Step 8 — Handle Errors","anchor":"Step-8-Handle-Errors","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Errors thrown by "},{"type":"codeVoice","code":"startStream(video:_:)"},{"type":"text","text":" cover setup failures: a signaling file that cannot be"},{"type":"text","text":" "},{"type":"text","text":"fetched or decoded, signaling that offers no camera to play ("},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and a stream that cannot be opened. "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"text","text":"the same signaling errors when you pre-fetch. "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError","isActive":true},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"LocalizedError"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is fit to show."}],"type":"paragraph"},{"inlineContent":[{"text":"Once playback is under way, failures arrive on ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true,"type":"reference"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in self?.loadFailure = error.localizedDescription }","    .store(in: &cancellables)"]},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true,"type":"reference"},{"text":" — move a live player to another video with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true,"type":"reference"},{"text":" instead of rebuilding it, and chain items with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","isActive":true},{"text":" — schedule ad breaks through ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true},{"text":" and drive your own ad UI.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handle control room camera switching via ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","type":"reference","isActive":true}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Recenter the camera with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/recenterCameraPosition()","type":"reference"}]}]}]}]}],"sections":[],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/quickstart"],"traits":[{"interfaceLanguage":"swift"}]}],"kind":"article","schemaV