{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide walks through the minimum steps to load the SDK configuration, create a player, and start streaming a 360° video. Follow the iOS section for a standard SwiftUI app, or the VisionOS section for an immersive spatial experience."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have not added the SDK to your project yet, start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},{"type":"text","text":"."}]},{"level":2,"text":"Step 1 — Load the App Configuration","type":"heading","anchor":"Step-1-Load-the-App-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before creating a player, fetch your app’s remote configuration using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader"},{"type":"text","text":". This is an async call — do it once at app launch and store the result."}]},{"type":"codeListing","syntax":"swift","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wire it into your SwiftUI entry point:"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"]},{"type":"aside","name":"Tip","content":[{"inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test"},{"text":" during integration to target non-production backends.","type":"text"}],"type":"paragraph"}],"style":"tip"},{"text":"Step 2 — Create a Player","anchor":"Step-2-Create-a-Player","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Instantiate "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" once you have the configuration. Always use "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig"},{"text":" unless you have specific requirements.","type":"text"}]},{"level":3,"type":"heading","text":"iOS","anchor":"iOS"},{"inlineContent":[{"text":"On iOS no surface context is needed — the SDK manages rendering internally.","type":"text"}],"type":"paragraph"},{"code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"type":"codeListing","syntax":"swift"},{"anchor":"VisionOS-Flat-Window","text":"VisionOS — Flat Window","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"For standard 2D window playback on VisionOS, use "},{"code":"surfaceContext: nil","type":"codeVoice"},{"text":" just like iOS:","type":"text"}]},{"code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"syntax":"swift","type":"codeListing"},{"text":"VisionOS — Immersive (CompositorLayer)","anchor":"VisionOS-Immersive-CompositorLayer","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"For a fully immersive experience, create a ","type":"text"},{"code":"VisionSurfaceContext","type":"codeVoice"},{"text":" from the ","type":"text"},{"code":"LayerRenderer","type":"codeVoice"},{"text":" provided by ","type":"text"},{"code":"CompositorLayer","type":"codeVoice"},{"text":":","type":"text"}]},{"code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift","type":"codeListing"},{"text":"VisionOS — Immersive (RealityKit \/ APMP)","anchor":"VisionOS-Immersive-RealityKit--APMP","level":3,"type":"heading"},{"inlineContent":[{"text":"For RealityKit-based spatial playback, attach the context to a RealityKit ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 3 — Set Up Analytics (Optional)","anchor":"Step-3-Set-Up-Analytics-Optional","level":2,"type":"heading"},{"inlineContent":[{"text":"If your ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration"},{"text":" includes analytics, attach a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker"},{"type":"text","text":" to the player right after creation:"}],"type":"paragraph"},{"code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 4 — Start Streaming","anchor":"Step-4-Start-Streaming","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Call "},{"code":"startStream(video:_:)","type":"codeVoice"},{"type":"text","text":" with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video"},{"type":"text","text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling "},{"code":"startStream","type":"codeVoice"},{"type":"text","text":" speeds up player initialization by avoiding network request inside the SDK."}],"type":"paragraph"},{"code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:"}],"type":"paragraph"},{"code":["player.getRenderer()?.startRenderLoop()"],"syntax":"swift","type":"codeListing"},{"text":"Step 5 — Embed the Player View","anchor":"Step-5-Embed-the-Player-View","level":2,"type":"heading"},{"level":3,"type":"heading","text":"iOS and VisionOS Flat — GeometryVideoView","anchor":"iOS-and-VisionOS-Flat-GeometryVideoView"},{"inlineContent":[{"text":"Wrap ","type":"text"},{"code":"GeometryVideoView","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"GeometryReader","type":"codeVoice"},{"text":" to maintain the correct aspect ratio:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"],"syntax":"swift"},{"type":"heading","text":"VisionOS — RealityView (APMP)","anchor":"VisionOS-RealityView-APMP","level":3},{"type":"codeListing","code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"VisionOS — CompositorLayer","anchor":"VisionOS-CompositorLayer","level":3},{"type":"codeListing","code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"],"syntax":"swift"},{"type":"heading","text":"Step 6 — Observe Player State","anchor":"Step-6-Observe-Player-State","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use "},{"code":"[weak self]","type":"codeVoice"},{"type":"text","text":" captures."}]},{"type":"codeListing","code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"],"syntax":"swift"},{"text":"Step 7 — Multi-Audio and Subtitles","anchor":"Step-7-Multi-Audio-and-Subtitles","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"Retrieve available languages from the player and filter them per active camera for control room streams:"}],"type":"paragraph"},{"code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"],"syntax":"swift","type":"codeListing"},{"text":"Step 8 — Handle Errors","anchor":"Step-8-Handle-Errors","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"text":"Errors thrown by ","type":"text"},{"code":"startStream(video:_:)","type":"codeVoice"},{"text":" cover setup failures: a signaling file that cannot be","type":"text"},{"text":" ","type":"text"},{"text":"fetched or decoded, signaling that offers no camera to play (","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera","type":"reference","isActive":true},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"and a stream that cannot be opened. ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","type":"reference","isActive":true},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"text":"the same signaling errors when you pre-fetch. ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError","type":"reference","isActive":true},{"text":" conforms to ","type":"text"},{"code":"LocalizedError","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so ","type":"text"},{"code":"localizedDescription","type":"codeVoice"},{"text":" is fit to show.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Once playback is under way, failures arrive on ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in self?.loadFailure = error.localizedDescription }","    .store(in: &cancellables)"]},{"type":"heading","anchor":"Next-Steps","level":2,"text":"Next Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},{"text":" — move a live player to another video with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"text":" instead of rebuilding it, and chain items with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},{"text":" — schedule ad breaks through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads"},{"text":" and drive your own ad UI.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Handle control room camera switching via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Recenter the camera with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/recenterCameraPosition()"}],"type":"paragraph"}]}]}]}],"seeAlsoSections":[{"title":"Getting Started","anchor":"Getting-Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"],"generated":true}],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","interfaceLanguage":"swift"},"schemaVersion":{"patch":0,"major":0,"minor":3},"abstract":[{"text":"Get up and running with YBVR video playback in your iOS or VisionOS app.","type":"text"}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/quickstart"],"traits":[{"interfaceLan