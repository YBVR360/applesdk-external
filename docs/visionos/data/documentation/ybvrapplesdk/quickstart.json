{"metadata":{"role":"article","modules":[{"name":"YBVRAppleSDK"}],"title":"Quick Start","roleHeading":"Article"},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"sections":[],"kind":"article","seeAlsoSections":[{"title":"Getting Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"],"anchor":"Getting-Started","generated":true}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","interfaceLanguage":"swift"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"inlineContent":[{"type":"text","text":"This guide walks through the minimum steps to load the SDK configuration, create a player, and start streaming a 360° video. Follow the iOS section for a standard SwiftUI app, or the VisionOS section for an immersive spatial experience."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you have not added the SDK to your project yet, start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Step-1-Load-the-App-Configuration","type":"heading","level":2,"text":"Step 1 — Load the App Configuration"},{"inlineContent":[{"type":"text","text":"Before creating a player, fetch your app’s remote configuration using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader"},{"type":"text","text":". This is an async call — do it once at app launch and store the result."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"]},{"inlineContent":[{"type":"text","text":"Wire it into your SwiftUI entry point:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test","isActive":true},{"type":"text","text":" during integration to target non-production backends."}]}],"style":"tip","type":"aside","name":"Tip"},{"anchor":"Step-2-Create-a-Player","type":"heading","level":2,"text":"Step 2 — Create a Player"},{"inlineContent":[{"type":"text","text":"Instantiate "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" once you have the configuration. Always use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig"},{"type":"text","text":" unless you have specific requirements."}],"type":"paragraph"},{"anchor":"iOS","type":"heading","level":3,"text":"iOS"},{"inlineContent":[{"type":"text","text":"On iOS no surface context is needed — the SDK manages rendering internally."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"]},{"anchor":"VisionOS-Flat-Window","type":"heading","level":3,"text":"VisionOS — Flat Window"},{"inlineContent":[{"type":"text","text":"For standard 2D window playback on VisionOS, use "},{"type":"codeVoice","code":"surfaceContext: nil"},{"type":"text","text":" just like iOS:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"]},{"anchor":"VisionOS-Immersive-CompositorLayer","type":"heading","level":3,"text":"VisionOS — Immersive (CompositorLayer)"},{"inlineContent":[{"type":"text","text":"For a fully immersive experience, create a "},{"type":"codeVoice","code":"VisionSurfaceContext"},{"type":"text","text":" from the "},{"type":"codeVoice","code":"LayerRenderer"},{"type":"text","text":" provided by "},{"type":"codeVoice","code":"CompositorLayer"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"]},{"anchor":"VisionOS-Immersive-RealityKit--APMP","type":"heading","level":3,"text":"VisionOS — Immersive (RealityKit \/ APMP)"},{"inlineContent":[{"type":"text","text":"For RealityKit-based spatial playback, attach the context to a RealityKit "},{"type":"codeVoice","code":"Entity"},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"]},{"anchor":"Step-3-Set-Up-Analytics-Optional","type":"heading","level":2,"text":"Step 3 — Set Up Analytics (Optional)"},{"inlineContent":[{"type":"text","text":"If your "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration","isActive":true},{"type":"text","text":" includes analytics, attach a "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker","isActive":true},{"type":"text","text":" to the player right after creation:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"]},{"anchor":"Step-4-Start-Streaming","type":"heading","level":2,"text":"Step 4 — Start Streaming"},{"inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"startStream(video:_:)"},{"type":"text","text":" with the "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","isActive":true},{"type":"text","text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling "},{"type":"codeVoice","code":"startStream"},{"type":"text","text":" speeds up player initialization by avoiding network request inside the SDK."}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"]},{"inlineContent":[{"type":"text","text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["player.getRenderer()?.startRenderLoop()"]},{"anchor":"Step-5-Embed-the-Player-View","type":"heading","level":2,"text":"Step 5 — Embed the Player View"},{"anchor":"iOS-and-VisionOS-Flat-GeometryVideoView","type":"heading","level":3,"text":"iOS and VisionOS Flat — GeometryVideoView"},{"type":"paragraph","inlineContent":[{"text":"Wrap ","type":"text"},{"code":"GeometryVideoView","type":"codeVoice"},{"text":" in a ","type":"text"},{"code":"GeometryReader","type":"codeVoice"},{"text":" to maintain the correct aspect ratio:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"]},{"type":"heading","level":3,"text":"VisionOS — RealityView (APMP)","anchor":"VisionOS-RealityView-APMP"},{"type":"codeListing","syntax":"swift","code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"]},{"type":"heading","level":3,"text":"VisionOS — CompositorLayer","anchor":"VisionOS-CompositorLayer"},{"type":"codeListing","syntax":"swift","code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"]},{"type":"heading","level":2,"text":"Step 6 — Observe Player State","anchor":"Step-6-Observe-Player-State"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use "},{"type":"codeVoice","code":"[weak self]"},{"type":"text","text":" captures."}]},{"type":"codeListing","syntax":"swift","code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"]},{"type":"heading","level":2,"text":"Step 7 — Multi-Audio and Subtitles","anchor":"Step-7-Multi-Audio-and-Subtitles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve available languages from the player and filter them per active camera for control room streams:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"]},{"type":"heading","level":2,"text":"Step 8 — Handle Errors","anchor":"Step-8-Handle-Errors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors thrown by "},{"type":"codeVoice","code":"startStream(video:_:)"},{"type":"text","text":" cover setup failures: a signaling file that cannot be"},{"type":"text","text":" "},{"type":"text","text":"fetched or decoded, signaling that offers no camera to play ("},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera"},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and a stream that cannot be opened. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"text","text":"the same signaling errors when you pre-fetch. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"LocalizedError"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is fit to show."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once playback is under way, failures arrive on "},{"type":"reference","isActive":t