{"sections":[],"seeAlsoSections":[{"generated":true,"anchor":"Getting-Started","title":"Getting Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"]}],"kind":"article","identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","interfaceLanguage":"swift"},"schemaVersion":{"major":0,"minor":3,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/quickstart"]}],"abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"This guide walks through the minimum steps to load the SDK configuration, create a player, and start streaming a 360° video. Follow the iOS section for a standard SwiftUI app, or the VisionOS section for an immersive spatial experience."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If you have not added the SDK to your project yet, start with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Step-1-Load-the-App-Configuration","level":2,"text":"Step 1 — Load the App Configuration","type":"heading"},{"inlineContent":[{"type":"text","text":"Before creating a player, fetch your app’s remote configuration using "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader"},{"type":"text","text":". This is an async call — do it once at app launch and store the result."}],"type":"paragraph"},{"syntax":"swift","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Wire it into your SwiftUI entry point:"}],"type":"paragraph"},{"syntax":"swift","code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"],"type":"codeListing"},{"name":"Tip","content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test"},{"text":" during integration to target non-production backends.","type":"text"}]}],"style":"tip","type":"aside"},{"anchor":"Step-2-Create-a-Player","level":2,"text":"Step 2 — Create a Player","type":"heading"},{"inlineContent":[{"type":"text","text":"Instantiate "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" once you have the configuration. Always use "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig"},{"type":"text","text":" unless you have specific requirements."}],"type":"paragraph"},{"anchor":"iOS","level":3,"text":"iOS","type":"heading"},{"inlineContent":[{"type":"text","text":"On iOS no surface context is needed — the SDK manages rendering internally."}],"type":"paragraph"},{"syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"type":"codeListing"},{"anchor":"VisionOS-Flat-Window","level":3,"text":"VisionOS — Flat Window","type":"heading"},{"inlineContent":[{"type":"text","text":"For standard 2D window playback on VisionOS, use "},{"type":"codeVoice","code":"surfaceContext: nil"},{"type":"text","text":" just like iOS:"}],"type":"paragraph"},{"syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"type":"codeListing"},{"anchor":"VisionOS-Immersive-CompositorLayer","level":3,"text":"VisionOS — Immersive (CompositorLayer)","type":"heading"},{"inlineContent":[{"type":"text","text":"For a fully immersive experience, create a "},{"type":"codeVoice","code":"VisionSurfaceContext"},{"type":"text","text":" from the "},{"type":"codeVoice","code":"LayerRenderer"},{"type":"text","text":" provided by "},{"type":"codeVoice","code":"CompositorLayer"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift"},{"type":"heading","text":"VisionOS — Immersive (RealityKit \/ APMP)","level":3,"anchor":"VisionOS-Immersive-RealityKit--APMP"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For RealityKit-based spatial playback, attach the context to a RealityKit "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift"},{"type":"heading","text":"Step 3 — Set Up Analytics (Optional)","level":2,"anchor":"Step-3-Set-Up-Analytics-Optional"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration","isActive":true,"type":"reference"},{"type":"text","text":" includes analytics, attach a "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker","isActive":true,"type":"reference"},{"type":"text","text":" to the player right after creation:"}]},{"type":"codeListing","code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"],"syntax":"swift"},{"type":"heading","text":"Step 4 — Start Streaming","level":2,"anchor":"Step-4-Start-Streaming"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"code":"startStream(video:_:)","type":"codeVoice"},{"type":"text","text":" with the "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","isActive":true,"type":"reference"},{"type":"text","text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling "},{"code":"startStream","type":"codeVoice"},{"type":"text","text":" speeds up player initialization by avoiding network request inside the SDK."}]},{"type":"codeListing","code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:"}]},{"type":"codeListing","code":["player.getRenderer()?.startRenderLoop()"],"syntax":"swift"},{"type":"heading","text":"Step 5 — Embed the Player View","level":2,"anchor":"Step-5-Embed-the-Player-View"},{"type":"heading","text":"iOS and VisionOS Flat — GeometryVideoView","level":3,"anchor":"iOS-and-VisionOS-Flat-GeometryVideoView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap "},{"code":"GeometryVideoView","type":"codeVoice"},{"type":"text","text":" in a "},{"code":"GeometryReader","type":"codeVoice"},{"type":"text","text":" to maintain the correct aspect ratio:"}]},{"type":"codeListing","code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"],"syntax":"swift"},{"type":"heading","text":"VisionOS — RealityView (APMP)","level":3,"anchor":"VisionOS-RealityView-APMP"},{"type":"codeListing","code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"],"syntax":"swift"},{"type":"heading","text":"VisionOS — CompositorLayer","level":3,"anchor":"VisionOS-CompositorLayer"},{"type":"codeListing","code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"],"syntax":"swift"},{"type":"heading","text":"Step 6 — Observe Player State","level":2,"anchor":"Step-6-Observe-Player-State"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true,"type":"reference"},{"type":"text","text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use "},{"code":"[weak self]","type":"codeVoice"},{"type":"text","text":" captures."}]},{"type":"codeListing","code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"],"syntax":"swift"},{"anchor":"Step-7-Multi-Audio-and-Subtitles","level":2,"text":"Step 7 — Multi-Audio and Subtitles","type":"heading"},{"inlineContent":[{"type":"text","text":"Retrieve available languages from the player and filter them per active camera for control room streams:"}],"type":"paragraph"},{"syntax":"swift","code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"],"type":"codeListing"},{"anchor":"Drawing-Subtitles","level":3,"text":"Drawing Subtitles","type":"heading"},{"inlineContent":[{"type":"text","text":"The SDK does not draw subtitles on any surface. It publishes the current cue on"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/currentSubtitleCue"},{"type":"text","text":" and leaves rendering it to you, so subtitles look and"},{"type":"text","text":" "},{"type":"text","text":"sit wherever your app wants them. Over the iOS video, or beside your controls in a visionOS"},{"type":"text","text":" "},{"type":"text","text":"window, a SwiftUI "},{"type":"codeVoice","code":"Text"},{"type":"text","text":" is enough."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Inside the visionOS immersive video, where no window can go, pass your own"},{"type":"text","text":" "},{"type":"codeVoice","code":"ImmersiveOverlayRenderer"},{"type":"text","text":" when building the surface. The SDK calls it for each eye, every"},{"type":"text","text":" "},{"type":"text","text":"frame, after drawing the video:"}],"type":"paragraph"},{"type":"codeListing","code":["final class SubtitleOverlay: ImmersiveOverlayRenderer {","    \/\/\/ Written from the main actor as cues arrive, read on the render thread.","    private let cue = OSAllocatedUnfairLock<String?>(initialState: nil)","    ","    func update(cue newCue: String?) { cue.withLock { $0 = newCue } }","    ","    func draw(in context: ImmersiveOverlayContext) {","        guard let text = cue.withLock({ $0 }) else { return }","        \/\/ Build the pipeline once, from context.device and the context's pixel formats, then","        \/\/ encode a textured quad with context.encoder, placed with context.projectionMatrix","        \/\/ (and context.viewMatrix, to fix it in the world rather than to the head).","    }","}","","let overlay = SubtitleOverlay()","let surface = VisionSurfaceContext(layerRenderer: layerRenderer, overlayRenderers: [overlay])","let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surface)","","player.currentSubtitleCue","    .receive(on: DispatchQueue.main)","    .sink { overlay.update(cue: $0) }","    .store(in: &cancellables)"],"syntax":"swift"},{"type":"heading","text":"Step 8 — Handle Errors","level":2,"anchor":"Step-8-Handle-Errors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors thrown by "},{"code":"startStream(video:_:)","type":"codeVoice"},{"type":"text","text":" cover setup failures: a signaling file that cannot be"},{"type":"text","text":" "},{"type":"text","text":"fetched or decoded, signaling that offers no camera to play ("},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera","type":"reference"},{"type":"text","text":"),"},{"type":"text","text":" "},{"text":"and a stream that cannot be opened. ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","type":"reference"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"the same signaling errors when you pre-fetch. "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError","isActive":true,"type":"reference"},{"text":" conforms to ","type":"text"},{"code":"LocalizedError","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"so "},{"code":"localizedDescription","type":"codeVoice"},{"text":" is fit to show.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Once playback is under way, failures arrive on ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true,"type":"reference"},{"text":":","type":"text"}]},{"type":"codeListing","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in self?.loadFailure = error.localizedDescription }","    .store(in: &cancellables)"],"syntax":"swift"},{"type":"heading","text":"Next Steps","level":2,"anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true,"type":"reference"},{"type":"text","text":" — move a live player to another video with"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true,"type":"reference"},{"type":"text","text":" instead of rebuilding it, and chain items with"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true,"type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","isActive":true,"type":"reference"},{"type":"text","text":" — schedule ad breaks through "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true,"type":"reference"},{"type":"text","text":" and drive your own ad UI."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Handle control room camera switching via "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoo