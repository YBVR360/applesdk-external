{"abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"kind":"article","primaryContentSections":[{"content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"This guide walks through the minimum steps to load the SDK configuration, create a player, and start streaming a 360° video. Follow the iOS section for a standard SwiftUI app, or the VisionOS section for an immersive spatial experience."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If you have not added the SDK to your project yet, start with "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation","isActive":true},{"type":"text","text":"."}]},{"type":"heading","level":2,"text":"Step 1 — Load the App Configuration","anchor":"Step-1-Load-the-App-Configuration"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before creating a player, fetch your app’s remote configuration using "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader","isActive":true},{"type":"text","text":". This is an async call — do it once at app launch and store the result."}]},{"type":"codeListing","syntax":"swift","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wire it into your SwiftUI entry point:"}]},{"type":"codeListing","syntax":"swift","code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"]},{"name":"Tip","type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development","isActive":true},{"type":"text","text":" or "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test","isActive":true},{"type":"text","text":" during integration to target non-production backends."}]}],"style":"tip"},{"type":"heading","level":2,"text":"Step 2 — Create a Player","anchor":"Step-2-Create-a-Player"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Instantiate "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" once you have the configuration. Always use "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig","isActive":true},{"type":"text","text":" unless you have specific requirements."}]},{"type":"heading","level":3,"text":"iOS","anchor":"iOS"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS no surface context is needed — the SDK manages rendering internally."}]},{"type":"codeListing","syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"]},{"type":"heading","level":3,"text":"VisionOS — Flat Window","anchor":"VisionOS-Flat-Window"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For standard 2D window playback on VisionOS, use "},{"code":"surfaceContext: nil","type":"codeVoice"},{"type":"text","text":" just like iOS:"}]},{"type":"codeListing","syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"]},{"type":"heading","level":3,"text":"VisionOS — Immersive (CompositorLayer)","anchor":"VisionOS-Immersive-CompositorLayer"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For a fully immersive experience, create a "},{"code":"VisionSurfaceContext","type":"codeVoice"},{"type":"text","text":" from the "},{"code":"LayerRenderer","type":"codeVoice"},{"type":"text","text":" provided by "},{"code":"CompositorLayer","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"]},{"type":"heading","level":3,"text":"VisionOS — Immersive (RealityKit \/ APMP)","anchor":"VisionOS-Immersive-RealityKit--APMP"},{"type":"paragraph","inlineContent":[{"type":"text","text":"For RealityKit-based spatial playback, attach the context to a RealityKit "},{"code":"Entity","type":"codeVoice"},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"]},{"type":"heading","level":2,"text":"Step 3 — Set Up Analytics (Optional)","anchor":"Step-3-Set-Up-Analytics-Optional"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration","isActive":true},{"type":"text","text":" includes analytics, attach a "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker","isActive":true},{"type":"text","text":" to the player right after creation:"}]},{"type":"codeListing","syntax":"swift","code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"]},{"type":"heading","level":2,"text":"Step 4 — Start Streaming","anchor":"Step-4-Start-Streaming"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"code":"startStream(video:_:)","type":"codeVoice"},{"type":"text","text":" with the "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","isActive":true},{"type":"text","text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling "},{"code":"startStream","type":"codeVoice"},{"type":"text","text":" speeds up player initialization by avoiding network request inside the SDK."}]},{"type":"codeListing","syntax":"swift","code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:"}]},{"type":"codeListing","syntax":"swift","code":["player.getRenderer()?.startRenderLoop()"]},{"type":"heading","level":2,"text":"Step 5 — Embed the Player View","anchor":"Step-5-Embed-the-Player-View"},{"type":"heading","level":3,"text":"iOS and VisionOS Flat — GeometryVideoView","anchor":"iOS-and-VisionOS-Flat-GeometryVideoView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap "},{"code":"GeometryVideoView","type":"codeVoice"},{"type":"text","text":" in a "},{"code":"GeometryReader","type":"codeVoice"},{"type":"text","text":" to maintain the correct aspect ratio:"}]},{"type":"codeListing","syntax":"swift","code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"]},{"type":"heading","level":3,"text":"VisionOS — RealityView (APMP)","anchor":"VisionOS-RealityView-APMP"},{"type":"codeListing","syntax":"swift","code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"]},{"type":"heading","level":3,"text":"VisionOS — CompositorLayer","anchor":"VisionOS-CompositorLayer"},{"type":"codeListing","syntax":"swift","code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"]},{"type":"heading","level":2,"text":"Step 6 — Observe Player State","anchor":"Step-6-Observe-Player-State"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use "},{"code":"[weak self]","type":"codeVoice"},{"type":"text","text":" captures."}]},{"type":"codeListing","syntax":"swift","code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"]},{"type":"heading","level":2,"text":"Step 7 — Multi-Audio and Subtitles","anchor":"Step-7-Multi-Audio-and-Subtitles"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Retrieve available languages from the player and filter them per active camera for control room streams:"}]},{"type":"codeListing","syntax":"swift","code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"]},{"type":"heading","level":2,"text":"Step 8 — Handle Errors","anchor":"Step-8-Handle-Errors"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Errors thrown by "},{"code":"startStream(video:_:)","type":"codeVoice"},{"type":"text","text":" cover setup failures: a signaling file that cannot be"},{"type":"text","text":" "},{"type":"text","text":"fetched or decoded, signaling that offers no camera to play ("},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and a stream that cannot be opened. "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","isActive":true},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"text","text":"the same signaling errors when you pre-fetch. "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError","isActive":true},{"type":"text","text":" conforms to "},{"code":"LocalizedError","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so "},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" is fit to show."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once playback is under way, failures arrive on "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true},{"type":"text","text":":"}]},{"type":"codeListing","syntax":"swift","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in self?.loadFailure = error.localizedDescription }","    .store(in: &cancellables)"]},{"type":"heading","level":2,"text":"Next Steps","anchor":"Next-Steps"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},{"type":"text","text":" — move a live player to another video with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"type":"text","text":" instead of rebuilding it, and chain items with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd"},{"type":"text","text":"."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},{"type":"text","text":" — schedule ad breaks through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads"},{"type":"text","text":" and drive your own ad UI."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle control room camera switching via "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Recenter the camera with "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/recenterCameraPosition()"}]}]}]}],"kind":"content"}],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"role":"article","roleHeading":"Article","title":"Quick Start"},"variants":[{"paths":["\/documentation\/ybvrapplesdk\/quickstart"],"traits":[{"interfaceLanguage":"swift"}]}],"sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"seeAlsoSections":[{"generated":true,"anchor":"Getting-Started","title":"Getting Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRSDKError":{"type":"topic","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"enum"},{"kind":"text","text":" "},{"kind":"identifier","text":"YBVRSDKError"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError","title":"YBVRSDKError","navigatorTitle":[{"kind":"identifier","text":"YBVRSDKError"}],"url":"\/documentation\/ybvrapplesdk\/ybvrsdkerror","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAppConfiguration":{"abstract":[],"title":"YBVRAppConfiguration","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"YBVRAppConfiguration","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YBVRAppConfiguration","kind":"identifier"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration","url":"\/documentation\/ybvrapplesdk\/ybvrappconfiguration","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/VideoConfig/defaultConfig":{"type":"topic","abstract":[{"text":"Default configuration","type":"text"}],"kind":"symbol","fragments":[{"kind":"keyword","text":"static"},{"kind":"text","text":" "},{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"defaultConfig"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK11VideoConfigV","text":"VideoConfig"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig","title":"defaultConfig","url":"\/documentation\/ybvrapplesdk\/videoconfig\/defaultconfig","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/controlRoomSelectorViewModel()":{"type":"topic","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"controlRoomSelectorViewModel"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK28ControlRoomSelectorViewModelC","text":"ControlRoomSelectorViewModel"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","title":"controlRoomSelectorViewModel()","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/controlroomselectorviewmodel()","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Tracker":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker","title":"Tracker","url":"\/documentation\/ybvrapplesdk\/tracker","fragments":[{"kind":"keyword","text":"actor"},{"kind":"text","text":" "},{"kind":"identifier","text":"Tracker"}],"kind":"symbol","navigatorTitle":[{"kind":"identifier","text":"Tracker"}],"abstract":[{"type":"text","text":"Actor that handles all the Analytics tracking in the SDK"},{"type":"text","text":" "},{"type":"text","text":"Tracking events are sent in batches of 20 events to the backend."}],"type":"topic","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/ContentSwitching":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","title":"Switching Content","url":"\/documentation\/ybvrapplesdk\/contentswitching","kind":"article","abstract":[{"type":"text","text":"Move an existing player from one video to another without tearing it down."}],"type":"topic","role":"article"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Installation":{"type":"topic","abstract":[{"text":"Add YBVRAppleSDK to your iOS or visionOS project.","type":"text"}],"kind":"article","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation","title":"Installation","url":"\/documentation\/ybvrapplesdk\/installation","role":"article"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/switchContent(to:_:)":{"type":"topic","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"switchContent"},{"kind":"text","text":"("},{"kind":"externalParam","text":"to"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK5VideoV","text":"Video"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK18SignalingInterfaceP","text":"SignalingInterface"},{"kind":"text","text":"?) "},{"kind":"keyword","text":"async"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","title":"switchContent(to:_:)","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/switchcontent(to:_:)","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAppConfigurationLoader":{"abstract":[],"title":"YBVRAppConfigurationLoader","kind":"symbol","role":"symbol","navigatorTitle":[{"text":"YBVRAppConfigurationLoader","kind":"identifier"}],"fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YBVRAppConfigurationLoader","kind":"identifier"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader","url":"\/documentation\/ybvrapplesdk\/ybvrappconfigurationloader","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/XmsEnvironment/development":{"type":"topic","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"development"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/developmen