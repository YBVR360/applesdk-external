{"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSlider","interfaceLanguage":"swift"},"abstract":[{"type":"text","text":"The seek and volume slider, with optional ad-break markers on its track."}],"schemaVersion":{"minor":3,"major":0,"patch":0},"topicSections":[{"anchor":"Structures","title":"Structures","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSlider\/AdMarker"],"generated":true},{"anchor":"Initializers","title":"Initializers","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSlider\/init(value:maxValue:seekingValue:trackHeight:thumbSize:minimumTrackTintColor:maximumTrackTintColor:adMarkers:onScrubBegan:onScrubEnded:)"],"generated":true},{"anchor":"Instance-Properties","title":"Instance Properties","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSlider\/body"],"generated":true},{"anchor":"Default-Implementations","title":"Default Implementations","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSlider\/View-Implementations"],"generated":true}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YBVRSlider","kind":"identifier"}],"platforms":["visionOS"],"languages":["swift"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Overview","level":2,"anchor":"overview"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Dragging moves the thumb from where it is, by as much as the drag - it does not jump to the touch."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"seekingValue","type":"codeVoice"},{"type":"text","text":" follows the drag continuously, between "},{"code":"onScrubBegan","type":"codeVoice"},{"type":"text","text":" and "},{"code":"onS