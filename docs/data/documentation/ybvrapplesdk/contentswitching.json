{"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"schemaVersion":{"major":0,"minor":3,"patch":0},"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","interfaceLanguage":"swift"},"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article","role":"article","title":"Switching Content"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/contentswitching"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"anchor":"Guides","title":"Guides","generated":true}],"kind":"article","abstract":[{"text":"Move an existing player from one video to another without tearing it down.","type":"text"}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"type":"text","text":" replaces the content playing in a live player. It"},{"type":"text","text":" "},{"type":"text","text":"keeps the player, the rendering surface, and the immersive space intact, which makes it the"},{"type":"text","text":" "},{"type":"text","text":"right call for “up next” rails, recommendation panels, and channel switching. Creating a new"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" per video would instead drop and rebuild the surface — on visionOS that"},{"type":"text","text":" "},{"type":"text","text":"means visibly leaving and re-entering the immersive space."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"If the player has not started anything yet, "},{"code":"switchContent(to:_:)","type":"codeVoice"},{"type":"text","text":" falls back to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)"},{"type":"text","text":", so it is safe to call as the single entry point"},{"type":"text","text":" "},{"type":"text","text":"for playback."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Changing the "},{"type":"emphasis","inlineContent":[{"text":"player","type":"text"}]},{"type":"text","text":" rather than the video — moving a session from an immersive space into a"},{"type":"text","text":" "},{"type":"text","text":"window, say — is the opposite trade and needs a new manager: see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"},{"type":"text","text":"."}],"type":"paragraph"},{"level":2,"text":"Switching","anchor":"Switching","type":"heading"},{"inlineContent":[{"type":"text","text":"As with "},{"code":"startStream","type":"codeVoice"},{"type":"text","text":", pre-fetching the signaling file removes a network round trip from"},{"type":"text","text":" "},{"type":"text","text":"inside the switch:"}],"type":"paragraph"},{"syntax":"swift","code":["func switchTo(video newVideo: Video) async {","    guard newVideo != currentVideo else { return }","","    do {","        let signaling = try await player.fetchSignalingFile(video: newVideo)","        try await player.switchContent(to: newVideo, signaling)","    } catch {","        loadFailure = error.localizedDescription","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch tears down the previous item, stops analytics tracking for it, resolves the new"},{"type":"text","text":" "},{"type":"text","text":"item’s signaling, and starts the new stream. Analytics restart automatically for the new"},{"type":"text","text":" "},{"type":"text","text":"content."}]},{"level":2,"text":"Reflecting the Transition in Your UI","type":"heading","anchor":"Reflecting-the-Transition-in-Your-UI"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isSwitchingContent","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the duration of the call. Drive a"},{"type":"text","text":" "},{"type":"text","text":"loading state from it, and disable the controls that would race the switch:"}]},{"code":["player.isSwitchingContent","    .receive(on: DispatchQueue.main)","    .sink { [weak self] switching in","        self?.isSwitchingContent = switching","    }","    .store(in: &cancellables)"],"syntax":"swift","type":"codeListing"},{"code":["Button(\"Play\") { … }","    .disabled(vm.isSwitchingContent)"],"syntax":"swift","type":"codeListing"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Re-bind your player subscriptions around a switch rather than reusing them.","type":"text"},{"text":" ","type":"text"},{"text":"Which bindings apply depends on the content — a control room item exposes a camera selector","type":"text"},{"text":" ","type":"text"},{"text":"and per-camera language sets that a flat item does not. Cancel your subscriptions, call","type":"text"},{"text":" ","type":"text"},{"code":"switchContent","type":"codeVoice"},{"text":", then re-subscribe and re-read","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"},{"text":".","type":"text"}]}],"type":"aside","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reset your own transport state as part of the switch too: position, duration, subtitle cue,"},{"type":"text","text":" "},{"type":"text","text":"and the selected audio and subtitle languages all belong to the outgoing item."}]},{"level":2,"text":"Reacting to Playback Ending","type":"heading","anchor":"Reacting-to-Playback-Ending"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true},{"type":"text","text":" publishes the "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","isActive":true},{"type":"text","text":" that just finished. Use it to chain"},{"type":"text","text":" "},{"type":"text","text":"straight into the next item rather than dismissing the player:"}]},{"code":["player.itemDidEnd","    .receive(on: DispatchQueue.main)","    .sink { [weak self] finished in","        guard let next = self?.nextUp(after: finished) else { return }","        Task { await self?.switchTo(video: next) }","    }","    .store(in: &cancellables)"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Handling Failures","type":"heading","anchor":"Handling-Failures"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true},{"type":"text","text":" reports errors that surface after playback has begun, as"},{"type":"text","text":" "},{"type":"text","text":"distinct from the error thrown by the "},{"type":"codeVoice","code":"switchContent"},{"type":"text","text":" call itself:"}]},{"code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in","        self?.loadFailure = error.localizedDescription","    }","    .store(in: &cancellables)"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Ads and Switching","type":"heading","anchor":"Ads-and-Switching"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A schedule set through "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true},{"type":"text","text":" belongs to the content it was scheduled"},{"type":"text","text":" "},{"type":"text","text":"against and is cleared when the content changes. Schedule the new item’s breaks after the"},{"type":"text","text":" "},{"type":"text","text":"switch completes — see "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","isActive":true},{"type":"text","text":"."}]}]}],"sections":[],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/SwitchingPlayerMode":{"title":"Switching Player Mode","type":"topic","abstract":[{"text":"Move a playback session between the immersive player and a window without losing the stream.","type":"text"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","kind":"article","url":"\/documentation\/ybvrapplesdk\/switchingplayermode","role":"article"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/AdInsertion":{"title":"Inserting Ads","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","kind":"article","role":"article","type":"topic","url":"\/documentation\/ybvrapplesdk\/adinsertion","abstract":[{"text":"Schedule ad breaks against the content timeline and drive your own ad UI.","type":"text"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Video":{"title":"Video","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","type":"topic","abstract":[],"kind":"symbol","url":"\/documentation\/ybvrapplesdk\/video","role":"symbol","navigatorTitle":[{"text":"Video","kind":"identifier"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"Video","kind":"identifier"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Drm":{"title":"FairPlay 