{"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"kind":"article","sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}],"role":"article","title":"Switching Content"},"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"anchor":"Guides","title":"Guides","generated":true}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/contentswitching"]}],"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","type":"heading","level":2,"text":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"type":"text","text":" replaces the content playing in a live player. It"},{"type":"text","text":" "},{"type":"text","text":"keeps the player, the rendering surface, and the immersive space intact, which makes it the"},{"type":"text","text":" "},{"type":"text","text":"right call for “up next” rails, recommendation panels, and channel switching. Creating a new"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" per video would instead drop and rebuild the surface — on visionOS that"},{"type":"text","text":" "},{"type":"text","text":"means visibly leaving and re-entering the immersive space."}]},{"type":"paragraph","inlineContent":[{"text":"If the player has not started anything yet, ","type":"text"},{"type":"codeVoice","code":"switchContent(to:_:)"},{"text":" falls back to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","type":"reference","isActive":true},{"text":", so it is safe to call as the single entry point","type":"text"},{"text":" ","type":"text"},{"text":"for playback.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Changing the ","type":"text"},{"inlineContent":[{"type":"text","text":"player"}],"type":"emphasis"},{"text":" rather than the video — moving a session from an immersive space into a","type":"text"},{"text":" ","type":"text"},{"text":"window, say — is the opposite trade and needs a new manager: see ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","isActive":true,"type":"reference"},{"type":"text","text":"."}]},{"anchor":"Switching","level":2,"text":"Switching","type":"heading"},{"inlineContent":[{"type":"text","text":"As with "},{"type":"codeVoice","code":"startStream"},{"type":"text","text":", pre-fetching the signaling file removes a network round trip from"},{"type":"text","text":" "},{"type":"text","text":"inside the switch:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["func switchTo(video newVideo: Video) async {","    guard newVideo != currentVideo else { return }","","    do {","        let signaling = try await player.fetchSignalingFile(video: newVideo)","        try await player.switchContent(to: newVideo, signaling)","    } catch {","        loadFailure = error.localizedDescription","    }","}"]},{"inlineContent":[{"text":"The switch tears down the previous item, stops analytics tracking for it, resolves the new","type":"text"},{"text":" ","type":"text"},{"text":"item’s signaling, and starts the new stream. Analytics restart automatically for the new","type":"text"},{"text":" ","type":"text"},{"text":"content.","type":"text"}],"type":"paragraph"},{"anchor":"Reflecting-the-Transition-in-Your-UI","level":2,"text":"Reflecting the Transition in Your UI","type":"heading"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isSwitchingContent","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the duration of the call. Drive a"},{"type":"text","text":" "},{"type":"text","text":"loading state from it, and disable the controls that would race the switch:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["player.isSwitchingContent","    .receive(on: DispatchQueue.main)","    .sink { [weak self] switching in","        self?.isSwitchingContent = switching","    }","    .store(in: &cancellables)"]},{"syntax":"swift","type":"codeListing","code":["Button(\"Play\") { … }","    .disabled(vm.isSwitchingContent)"]},{"name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Re-bind your player subscriptions around a switch rather than reusing them.","type":"text"},{"text":" ","type":"text"},{"text":"Which bindings apply depends on the content — a control room item exposes a camera selector","type":"text"},{"text":" ","type":"text"},{"text":"and per-camera language sets that a flat item does not. Cancel your subscriptions, call","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"switchContent"},{"text":", then re-subscribe and re-read","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"},{"type":"text","text":"."}]}],"type":"aside","style":"important"},{"inlineContent":[{"type":"text","text":"Reset your own transport state as part of the switch too: position, duration, subtitle cue,"},{"type":"text","text":" "},{"type":"text","text":"and the selected audio and subtitle languages all belong to the outgoing item."}],"type":"paragraph"},{"anchor":"Reacting-to-Playback-Ending","type":"heading","level":2,"text":"Reacting to Playback Ending"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true},{"type":"text","text":" publishes the "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","isActive":true},{"type":"text","text":" that just finished. Use it to chain"},{"type":"text","text":" "},{"type":"text","text":"straight into the next item rather than dismissing the player:"}],"type":"paragraph"},{"code":["player.itemDidEnd","    .receive(on: DispatchQueue.main)","    .sink { [weak self] finished in","        guard let next = self?.nextUp(after: finished) else { return }","        Task { await self?.switchTo(video: next) }","    }","    .store(in: &cancellables)"],"syntax":"swift","type":"codeListing"},{"anchor":"Handling-Failures","type":"heading","level":2,"text":"Handling Failures"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true,"type":"reference"},{"text":" reports errors that surface after playback has begun, as","type":"text"},{"text":" ","type":"text"},{"text":"distinct from the error thrown by the ","type":"text"},{"type":"codeVoice","code":"switchContent"},{"text":" call itself:","type":"text"}],"type":"paragraph"},{"code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in","        self?.loadFailure = error.localizedDescription","    }","    .store(in: &cancellables)"],"syntax":"swift","type":"codeListing"},{"anchor":"Ads-and-Switching","type":"heading","level":2,"text":"Ads and Switching"},{"inlineContent":[{"type":"text","text":"A schedule set through "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","type":"reference","isActive":true},{"type":"text","text":" belongs to the content it was scheduled"},{"type":"text","text":" "},{"type":"text","text":"against and is cleared when the content changes. Schedule the new item’s breaks after the"},{"type":"text","text":" "},{"type":"text","text":"switch completes — see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},{"type":"text","text":"."}],"type":"paragraph"}]}],"abstract":[{"type":"text","text":"Move an existing player from one video to another without tearing it down."}],"schemaVersion":{"patch":0,"minor":3,"major":0},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"title":"YBVRAppleSDK","type":"topic","role":"collection","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","url":"\/documentation\/ybvrapplesdk","kind":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Drm":{"url":"\/documentation\/ybvrapplesdk\/drm","title":"FairPlay DRM","kind":"article","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm","type":"topic","abstract":[{"text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is.","type":"text"}],"role":"article"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/SwitchingPlayerMode":{"url":"\/documentation\/ybvrapplesdk\/switchingplayermode","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","kind":"article","title":"Switching Player Mode","type":"topic","abstract":[{"type":"text","text":"Move a playback session between the immersive player and a window without losing the stream."}],"role":"article"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/ads":{"kind":"symbol","abstract":[{"type":"text","text":"Ad breaks: the schedule, the skip control, 