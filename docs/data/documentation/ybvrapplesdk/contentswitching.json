{"kind":"article","primaryContentSections":[{"kind":"content","content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"type":"text","text":" replaces the content playing in a live player. It"},{"type":"text","text":" "},{"type":"text","text":"keeps the player, the rendering surface, and the immersive space intact, which makes it the"},{"type":"text","text":" "},{"type":"text","text":"right call for “up next” rails, recommendation panels, and channel switching. Creating a new"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" per video would instead drop and rebuild the surface — on visionOS that"},{"type":"text","text":" "},{"type":"text","text":"means visibly leaving and re-entering the immersive space."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"If the player has not started anything yet, "},{"type":"codeVoice","code":"switchContent(to:_:)"},{"type":"text","text":" falls back to"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)"},{"type":"text","text":", so it is safe to call as the single entry point"},{"type":"text","text":" "},{"type":"text","text":"for playback."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Changing the "},{"type":"emphasis","inlineContent":[{"type":"text","text":"player"}]},{"type":"text","text":" rather than the video — moving a session from an immersive space into a"},{"type":"text","text":" "},{"type":"text","text":"window, say — is the opposite trade and needs a new manager: see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"},{"type":"text","text":"."}]},{"type":"heading","text":"Switching","anchor":"Switching","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"As with "},{"type":"codeVoice","code":"startStream"},{"type":"text","text":", pre-fetching the signaling file removes a network round trip from"},{"type":"text","text":" "},{"type":"text","text":"inside the switch:"}]},{"syntax":"swift","type":"codeListing","code":["func switchTo(video newVideo: Video) async {","    guard newVideo != currentVideo else { return }","","    do {","        let signaling = try await player.fetchSignalingFile(video: newVideo)","        try await player.switchContent(to: newVideo, signaling)","    } catch {","        loadFailure = error.localizedDescription","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The switch tears down the previous item, stops analytics tracking for it, resolves the new"},{"type":"text","text":" "},{"type":"text","text":"item’s signaling, and starts the new stream. Analytics restart automatically for the new"},{"type":"text","text":" "},{"type":"text","text":"content."}]},{"type":"heading","text":"Reflecting the Transition in Your UI","anchor":"Reflecting-the-Transition-in-Your-UI","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isSwitchingContent"},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" for the duration of the call. Drive a"},{"type":"text","text":" "},{"type":"text","text":"loading state from it, and disable the controls that would race the switch:"}]},{"syntax":"swift","type":"codeListing","code":["player.isSwitchingContent","    .receive(on: DispatchQueue.main)","    .sink { [weak self] switching in","        self?.isSwitchingContent = switching","    }","    .store(in: &cancellables)"]},{"syntax":"swift","type":"codeListing","code":["Button(\"Play\") { … }","    .disabled(vm.isSwitchingContent)"]},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Re-bind your player subscriptions around a switch rather than reusing them."},{"type":"text","text":" "},{"type":"text","text":"Which bindings apply depends on the content — a control room item exposes a camera selector"},{"type":"text","text":" "},{"type":"text","text":"and per-camera language sets that a flat item does not. Cancel your subscriptions, call"},{"type":"text","text":" "},{"type":"codeVoice","code":"switchContent"},{"type":"text","text":", then re-subscribe and re-read"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","type":"reference","isActive":true},{"type":"text","text":"."}]}],"style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Reset your own transport state as part of the switch too: position, duration, subtitle cue,"},{"type":"text","text":" "},{"type":"text","text":"and the selected audio and subtitle languages all belong to the outgoing item."}]},{"type":"heading","text":"Reacting to Playback Ending","anchor":"Reacting-to-Playback-Ending","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd"},{"type":"text","text":" publishes the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video"},{"type":"text","text":" that just finished. Use it to chain"},{"type":"text","text":" "},{"type":"text","text":"straight into the next item rather than dismissing the player:"}]},{"syntax":"swift","type":"codeListing","code":["player.itemDidEnd","    .receive(on: DispatchQueue.main)","    .sink { [weak self] finished in","        guard let next = self?.nextUp(after: finished) else { return }","        Task { await self?.switchTo(video: next) }","    }","    .store(in: &cancellables)"]},{"type":"heading","text":"Handling Failures","anchor":"Handling-Failures","level":2},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError"},{"type":"text","text":" reports errors that surface after playback has begun, as"},{"type":"text","text":" "},{"type":"text","text":"distinct from the error thrown by the "},{"type":"codeVoice","code":"switchContent"},{"type":"text","text":" call itself:"}]},{"syntax":"swift","type":"codeListing","code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in","        self?.loadFailure = error.localizedDescription","    }","    .store(in: &cancellables)"]},{"type":"heading","text":"Ads and Switching","anchor":"Ads-and-Switching","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A schedule set through "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads"},{"type":"text","text":" belongs to the content it was scheduled"},{"type":"text","text":" "},{"type":"text","text":"against and is cleared when the content changes. Schedule the new item’s breaks after the"},{"type":"text","text":" "},{"type":"text","text":"switch completes — see "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},{"type":"text","text":"."}]}]}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"title":"Guides","anchor":"Guides"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/contentswitching"]}],"metadata":{"roleHeading":"Article","role":"article","modules":[{"name":"YBVRAppleSDK"}],"title":"Switching Content"},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},"abstract":[{"type":"text","text":"Move an existing player from one video to another without tearing it down."}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/playbackError":{"abstract":[],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/playbackerror","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"playbackError"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Combine18PassthroughSubjectC","kind":"typeIdentifier","text":"PassthroughSubject"},{"kind":"text","text":"<any "},{"preciseIdentifier":"s:s5ErrorP","kind":"typeIdentifier","text":"Error"},{"kind":"text","text":", "},{"preciseIdentifier":"s:s5NeverO","kind":"typeIdentifier","text":"Never"},{"text":">","kind":"text"}],"type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","kind":"symbol","title":"playbackError"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/SwitchingPlayerMode":{"kind":"article","role":"article","url":"\/documentation\/ybvrapplesdk\/switchingplayermode","title":"Switching Player Mode","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","abstract":[{"text":"Move a playback session between the immersive player and a window without losing the stream.","type":"text"}],"type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/AdInsertion