{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},"kind":"article","seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"anchor":"Guides"}],"metadata":{"title":"Inserting Ads","roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}],"role":"article"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController"},{"type":"text","text":", reached through "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true},{"type":"text","text":", inserts ad breaks as HLS"},{"type":"text","text":" "},{"type":"text","text":"interstitials. That has two consequences worth knowing up front:"}]},{"items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No manifest support is needed."}]},{"type":"text","text":" The content playlist does not have to carry"},{"type":"text","text":" "},{"code":"EXT-X-DATERANGE","type":"codeVoice"},{"type":"text","text":" tags — the cue points come from the schedule you supply."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"Resuming is seamless."}],"type":"strong"},{"text":" The content item stays buffered across a break, so nothing of the","type":"text"},{"text":" ","type":"text"},{"text":"content is lost or skipped when an ad plays.","type":"text"}]}]}],"type":"unorderedList"},{"type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Ads require the HLS player. Low-latency RTMP streams have no interstitial"},{"type":"text","text":" "},{"type":"text","text":"mechanism, and a schedule set on one is ignored."}]}],"style":"important"},{"level":2,"type":"heading","text":"Scheduling Breaks","anchor":"Scheduling-Breaks"},{"inlineContent":[{"type":"text","text":"Build an "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak"},{"type":"text","text":" from a cue point and the creatives to play there, then hand the whole"},{"type":"text","text":" "},{"type":"text","text":"schedule to "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)"},{"type":"text","text":". Each call replaces the previous schedule:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let breaks = [","    YBVRAdBreak(","        id: \"pre\",","        cue: .preRoll,","        creatives: [YBVRAdCreative(urlString: preRollURL)]","    ),","    YBVRAdBreak(","        id: \"mid-1\",","        cue: .midRoll(120),","        creatives: [","            YBVRAdCreative(urlString: firstInPodURL),","            YBVRAdCreative(urlString: secondInPodURL)","        ],","        skipAfter: 5","    ),","    YBVRAdBreak(","        id: \"post\",","        cue: .postRoll,","        creatives: [YBVRAdCreative(urlString: postRollURL)]","    )","]","","player.ads.schedule(breaks)"]},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCue","type":"reference"},{"text":" places the break: ","type":"text"},{"code":".preRoll","type":"codeVoice"},{"text":" before the content, ","type":"text"},{"code":".midRoll(seconds)","type":"codeVoice"},{"text":" at a point","type":"text"},{"text":" ","type":"text"},{"text":"on the content timeline, ","type":"text"},{"code":".postRoll","type":"codeVoice"},{"text":" after it. Listing several creatives in one break plays","type":"text"},{"text":" ","type":"text"},{"text":"them back to back as a pod. Creatives with unusable URLs are dropped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/skipAfter","type":"reference"},{"type":"text","text":" sets how many seconds must play before the break can be skipped, and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/maxDuration","type":"reference"},{"type":"text","text":" caps the break. "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/scheduled","type":"reference"},{"type":"text","text":" reads back what is"},{"type":"text","text":" "},{"type":"text","text":"currently scheduled, and "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()","type":"reference"},{"type":"text","text":" drops it — though a break already"},{"type":"text","text":" "},{"text":"on screen plays to its end.","type":"text"}],"type":"paragraph"},{"content":[{"inlineContent":[{"text":"Schedules are per content item. Re-apply them after","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","type":"reference"},{"text":"; see ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"style":"note","name":"Note","type":"aside"},{"level":3,"text":"Immersive Creatives","type":"heading","anchor":"Immersive-Creatives"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A creative renders as a flat 2D panel by default. Pass "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative\/geometry","isActive":true},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"creative authored for an immersive geometry, and the surface switches for that creative and is"},{"type":"text","text":" "},{"type":"text","text":"restored to the content’s geometry when the break ends:"}]},{"code":["YBVRAdCreative(urlString: sphericalAdURL, geometry: .nsEquirectangularMono)"],"type":"codeListing","syntax":"swift"},{"level":2,"text":"Observing Ad Playback","type":"heading","anchor":"Observing-Ad-Playback"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playback","type":"reference"},{"text":" carries a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback","type":"reference"},{"text":" while an ad is on screen and ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"while content plays — the simplest signal for “am I in an ad right now”:","type":"text"}]},{"code":["player.ads.playback","    .receive(on: DispatchQueue.main)","    .sink { [weak self] playback in","        self?.adPlayback = playback","        self?.isPlayingAd = playback != nil","    }","    .store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback","isActive":true,"type":"reference"},{"type":"text","text":" names the "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","type":"reference"},{"text":", the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative","type":"reference"},{"type":"text","text":" on screen, and its index"},{"type":"text","text":" "},{"type":"text","text":"within the pod — enough to render “Ad 2 of 3”."}]},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didBegin","isActive":true},{"type":"text","text":" and "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd","isActive":true},{"type":"text","text":" fire once per break for"},{"type":"text","text":" "},{"type":"text","text":"one-shot work such as hiding your transport controls:"}]},{"syntax":"swift","code":["player.ads.didBegin","    .receive(on: DispatchQueue.main)","    .sink { [weak self] _ in self?.hideControls() }","    .store(in: &cancellables)"],"type":"codeListing"},{"level":3,"anchor":"Progress-and-Skipping","type":"heading","text":"Progress and Skipping"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration","isActive":true,"type":"reference"},{"text":" track progress through the ad","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"on screen, in seconds, and are zero outside a break. Progress is break-relative when the break"},{"type":"text","text":" "},{"type":"text","text":"declares a "},{"type":"codeVoice","code":"maxDuration"},{"type":"text","text":" and creative-relative otherwise."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive a skip button from "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn","type":"reference","isActive":true},{"type":"text","text":", and call"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()","type":"reference","isActive":true},{"type":"text","text":" to act on it:"}]},{"type":"codeListing","code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"],"syntax":"swift"},{"inlineContent":[{"type":"codeVoice","code":"cancelCurrentBreak()"},{"type":"text","text":" abandons the break and resumes the content where it was interrupted —"},{"type":"text","text":" "},{"type":"text","text":"no content is skipped. It returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when refused because the break’s "},{"type":"codeVoice","code":"skipAfter"},{"type":"text","text":" offset"},{"type":"text","text":" "},{"type":"text","text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the"},{"type":"text","text":" "},{"type":"text","text":"button’s enabled state to "},{"type":"codeVoice","code":"canSkip"},{"type":"text","text":" keeps the two in step."}],"type":"paragraph"},{"level":3,"anchor":"Seeks-and-Missed-Mid-Rolls","text":"Seeks and Missed Mid-Rolls","type":"heading"},{"inlineContent":[{"type":"text","text":"Interstitials fire when playback "},{"type":"emphasis","inlineContent":[{"type":"text","text":"crosses"}]},{"type":"text","text":" a cue point, so a seek can jump over one. By"},{"type":"text","text":" "},{"type":"text","text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last"},{"type":"text","text":" "},{"type":"text","text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","isActive":true},{"type":"text","text":":"}],"type":"paragraph"},{"syntax":"swift","code":["player.ads.playsMissedMidRollsOnSeek = false"],"type":"codeListing"},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","isActive":true},{"type":"text","text":" is "},{"type":"codeVoice","code":"true"},{"type":"text","text":" while an ad re-armed by a seek is being fetched but"},{"type":"text","text":" "},{"type":"text","text":"has not yet reached the screen — a good cue for a brief spinner."},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true},{"type":"text","text":" reports the breaks that have already played or been skipped,"},{"type":"text","text":" "},{"type":"text","text":"which is what you need to draw timeline markers that distinguish consumed breaks from"},{"type":"text","text":" "},{"type":"text","text":"upcoming ones."}],"type":"paragraph"},{"type":"heading","anchor":"Resuming-a-Session-on-Another-Player","text":"Resuming a Session on Another Player","level":3},{"type":"paragraph","inlineContent":[{"type":"text","text":"Which breaks have played lives in the manager that played them, and a schedule is armed"},{"type":"text","text":" "},{"type":"text","text":"against the content that manager opened. Resuming the same content on a "},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"type":"text","text":" manager —"},{"type":"text","text":" "},{"type":"text","text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed"},{"type":"text","text":" "},{"type":"text","text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up"},{"type":"text","text":" "},{"type":"text","text":"above reads as a viewer skipping them."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Carry the ids across and hand them over before the new manager opens its stream:"}]},{"type":"codeListing","code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)"},{"type":"text","text":" drops those breaks from the schedule and takes them out of"},{"type":"text","text":" "},{"type":"text","text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine"},{"type":"text","text":" "},{"type":"text","text":"content switch still plays its ads. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"},{"type":"text","text":"."}]}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"text":"Schedule ad breaks against the content timeline and drive your own ad UI.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/adinsertion"]}],"sections":[],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/didEnd":{"role":"symbol","kind":"symbol","title":"didEnd","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/didend","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd","abstract":[{"type":"text","text":"Fires once when an ad break finishes and content resumes."}],"type":"topic","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"didEnd"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Combine18PassthroughSubjectC","text":"PassthroughSubject"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK11YBVRAdBreakV","text":"YBVRAdBreak"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier":"s:s5NeverO","text":"Never"},{"kind":"text","text":">"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/clearSchedule()":{"title":"clearSchedule()","kind":"symbol","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/clearschedule()","abstract":[{"type":"text","text":"Drop the schedule. A break already on screen plays to its end - use"},{"type":"text","text":" "},{"code":"cancelCurrentBreak()","type":"codeVoice"},{"type":"text","text":" to end that one."}],"type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"clearSchedule","kind":"identifier"},{"text":"()","kind":"text"}],"role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/position":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position","type":"topic","abstract":[{"type":"text","text":"Progress through the ad on screen, in seconds; zero outside a break. Break-relative when"},{"type":"text","text":" "},{"type":"text","text":"the break declares a "},{"type":"codeVoice","code":"maxDuration"},{"type":"text","text":", creative-relative otherwise."}],"url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/position","role":"symbol","kind":"symbol","title":"position","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"position"},{"kind":"text","text":": "},{"kind":"typeIdentifier","preciseIdentifier":"s:7Combine19CurrentValueSubjectC","text":"CurrentValueSubject"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","preciseIdentifier":"s:Sd","text":"Double"},{"kind":"text","text":", "},{"kind":"typeIdentifier","preciseIdentifier"