":"text"},{"text":"schedule","kind":"identifier"},{"text":"([","kind":"text"},{"text":"YBVRAdBreak","kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK11YBVRAdBreakV"},{"text":"])","kind":"text"}],"url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/schedule(_:)","type":"topic","title":"schedule(_:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/canSkip":{"type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"canSkip","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CurrentValueSubject","kind":"typeIdentifier","preciseIdentifier":"s:7Combine19CurrentValueSubjectC"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"},{"kind":"text","text":", "},{"kind":"typeIdentifier","text":"Never","preciseIdentifier":"s:s5NeverO"},{"text":">","kind":"text"}],"title":"canSkip","kind":"symbol","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/canskip","role":"symbol","abstract":[],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/isPreparing":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","abstract":[{"code":"true","type":"codeVoice"},{"text":" while an ad re-armed after a seek is being fetched, before it reaches the screen.","type":"text"}],"kind":"symbol","title":"isPreparing","type":"topic","role":"symbol","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/ispreparing","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"text":"isPreparing","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"CurrentValueSubject","preciseIdentifier":"s:7Combine19CurrentValueSubjectC"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":", "},{"text":"Never","kind