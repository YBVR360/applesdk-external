{"primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController"},{"text":", reached through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads"},{"text":", inserts ad breaks as HLS","type":"text"},{"text":" ","type":"text"},{"text":"interstitials. That has two consequences worth knowing up front:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"No manifest support is needed."}]},{"type":"text","text":" The content playlist does not have to carry"},{"type":"text","text":" "},{"code":"EXT-X-DATERANGE","type":"codeVoice"},{"type":"text","text":" tags — the cue points come from the schedule you supply."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"Resuming is seamless."}]},{"type":"text","text":" The content item stays buffered across a break, so nothing of the"},{"type":"text","text":" "},{"type":"text","text":"content is lost or skipped when an ad plays."}]}]}],"type":"unorderedList"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Ads require the HLS player. Low-latency RTMP streams have no interstitial","type":"text"},{"text":" ","type":"text"},{"text":"mechanism, and a schedule set on one is ignored.","type":"text"}]}],"style":"important","name":"Important","type":"aside"},{"level":2,"text":"Scheduling Breaks","anchor":"Scheduling-Breaks","type":"heading"},{"inlineContent":[{"text":"Build an ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak"},{"text":" from a cue point and the creatives to play there, then hand the whole","type":"text"},{"text":" ","type":"text"},{"text":"schedule to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)"},{"text":". Each call replaces the previous schedule:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let breaks = [","    YBVRAdBreak(","        id: \"pre\",","        cue: .preRoll,","        creatives: [YBVRAdCreative(urlString: preRollURL)]","    ),","    YBVRAdBreak(","        id: \"mid-1\",","        cue: .midRoll(120),","        creatives: [","            YBVRAdCreative(urlString: firstInPodURL),","            YBVRAdCreative(urlString: secondInPodURL)","        ],","        skipAfter: 5","    ),","    YBVRAdBreak(","        id: \"post\",","        cue: .postRoll,","        creatives: [YBVRAdCreative(urlString: postRollURL)]","    )","]","","player.ads.schedule(breaks)"],"type":"codeListing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCue"},{"text":" places the break: ","type":"text"},{"code":".preRoll","type":"codeVoice"},{"text":" before the content, ","type":"text"},{"code":".midRoll(seconds)","type":"codeVoice"},{"text":" at a point","type":"text"},{"text":" ","type":"text"},{"text":"on the content timeline, ","type":"text"},{"code":".postRoll","type":"codeVoice"},{"text":" after it. Listing several creatives in one break plays","type":"text"},{"text":" ","type":"text"},{"text":"them back to back as a pod. Creatives with unusable URLs are dropped.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/skipAfter"},{"text":" sets how many seconds must play before the break can be skipped, and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/maxDuration"},{"text":" caps the break. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/scheduled"},{"text":" reads back what is","type":"text"},{"text":" ","type":"text"},{"text":"currently scheduled, and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()"},{"text":" drops it — though a break already","type":"text"},{"text":" ","type":"text"},{"text":"on screen plays to its end.","type":"text"}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"text":"Schedules are per content item. Re-apply them after","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true},{"text":"; see ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true},{"text":".","type":"text"}]}],"style":"note","name":"Note","type":"aside"},{"level":3,"text":"Immersive Creatives","anchor":"Immersive-Creatives","type":"heading"},{"inlineContent":[{"text":"A creative renders as a flat 2D panel by default. Pass ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative\/geometry"},{"text":" for a","type":"text"},{"text":" ","type":"text"},{"text":"creative authored for an immersive geometry, and the surface switches for that creative and is","type":"text"},{"text":" ","type":"text"},{"text":"restored to the content’s geometry when the break ends:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["YBVRAdCreative(urlString: sphericalAdURL, geometry: .nsEquirectangularMono)"],"type":"codeListing"},{"level":2,"text":"Observing Ad Playback","anchor":"Observing-Ad-Playback","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playback"},{"text":" carries a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback"},{"text":" while an ad is on screen and ","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"text":"while content plays — the simplest signal for “am I in an ad right now”:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["player.ads.playback","    .receive(on: DispatchQueue.main)","    .sink { [weak self] playback in","        self?.adPlayback = playback","        self?.isPlayingAd = playback != nil","    }","    .store(in: &cancellables)"],"type":"codeListing"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback"},{"text":" names the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak"},{"text":", the ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative"},{"text":" on screen, and its index","type":"text"},{"text":" ","type":"text"},{"text":"within the pod — enough to render “Ad 2 of 3”.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didBegin"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd"},{"text":" fire once per break for","type":"text"},{"text":" ","type":"text"},{"text":"one-shot work such as hiding your transport controls:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["player.ads.didBegin","    .receive(on: DispatchQueue.main)","    .sink { [weak self] _ in self?.hideControls() }","    .store(in: &cancellables)"],"type":"codeListing"},{"level":3,"text":"Progress and Skipping","anchor":"Progress-and-Skipping","type":"heading"},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration"},{"text":" track progress through the ad","type":"text"},{"text":" ","type":"text"},{"text":"on screen, in seconds, and are zero outside a break. Progress is break-relative when the break","type":"text"},{"text":" ","type":"text"},{"text":"declares a ","type":"text"},{"code":"maxDuration","type":"codeVoice"},{"text":" and creative-relative otherwise.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Drive a skip button from ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn"},{"text":", and call","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()"},{"text":" to act on it:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"],"type":"codeListing"},{"inlineContent":[{"code":"cancelCurrentBreak()","type":"codeVoice"},{"text":" abandons the break and resumes the content where it was interrupted —","type":"text"},{"text":" ","type":"text"},{"text":"no content is skipped. It returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" when refused because the break’s ","type":"text"},{"code":"skipAfter","type":"codeVoice"},{"text":" offset","type":"text"},{"text":" ","type":"text"},{"text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the","type":"text"},{"text":" ","type":"text"},{"text":"button’s enabled state to ","type":"text"},{"code":"canSkip","type":"codeVoice"},{"text":" keeps the two in step.","type":"text"}],"type":"paragraph"},{"text":"Seeks and Missed Mid-Rolls","type":"heading","anchor":"Seeks-and-Missed-Mid-Rolls","level":3},{"inlineContent":[{"type":"text","text":"Interstitials fire when playback "},{"inlineContent":[{"text":"crosses","type":"text"}],"type":"emphasis"},{"type":"text","text":" a cue point, so a seek can jump over one. By"},{"type":"text","text":" "},{"type":"text","text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last"},{"type":"text","text":" "},{"text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","type":"reference","isActive":true},{"text":":","type":"text"}],"type":"paragraph"},{"code":["player.ads.playsMissedMidRollsOnSeek = false"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","type":"reference","isActive":true},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" while an ad re-armed by a seek is being fetched but"},{"text":" ","type":"text"},{"text":"has not yet reached the screen — a good cue for a brief spinner.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","type":"reference"},{"text":" reports the breaks that have already played or been skipped,","type":"text"},{"text":" ","type":"text"},{"text":"which is what you need to draw timeline markers that distinguish consumed breaks from","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"upcoming ones."}],"type":"paragraph"},{"text":"Resuming a Session on Another Player","type":"heading","anchor":"Resuming-a-Session-on-Another-Player","level":3},{"inlineContent":[{"type":"text","text":"Which breaks have played lives in the manager that played them, and a schedule is armed"},{"text":" ","type":"text"},{"type":"text","text":"against the content that manager opened. Resuming the same content on a "},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"text":" manager —","type":"text"},{"text":" ","type":"text"},{"text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed","type":"text"},{"text":" ","type":"text"},{"text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up","type":"text"},{"text":" ","type":"text"},{"text":"above reads as a viewer skipping them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Carry the ids across and hand them over before the new manager opens its stream:","type":"text"}],"type":"paragraph"},{"code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","type":"reference"},{"text":" drops those breaks from the schedule and takes them out of","type":"text"},{"text":" ","type":"text"},{"text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine","type":"text"},{"text":" ","type":"text"},{"text":"content switch still plays its ads. See ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","interfaceLanguage":"swift"},"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"title":"Guides","generated":true,"anchor":"Guides"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"metadata":{"role":"article","title":"Inserting Ads","roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}]},"sections":[],"schemaVersion":{"minor":3,"patch":0,"major":0},"variants":[{"paths":["\/documentation\/ybvrapplesdk\/adinsertion"],"traits":[{"interfaceLanguage":"swift"}]}],"abstract":[{"text":"Schedule ad breaks against the content timeline and drive your own ad UI.","type":"text"}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdCreative/geometry":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative\/geometry","kind":"symbol","abstract":[],"url":"\/documentation\/ybvrapplesdk\/ybvradcreative\/geometry","type":"topic","role":"symbol","fragments":[{"kind":"keyword","text":"let"},{"text":" ","kind":"text"},{"kind":"identifier","text":"geometry"},{"text":": ","kind":"text"},{"text":"SignalingVersion","preciseIdentifier":"s:12YBVRAppleSDK16SignalingVersionO","kind":"typeIdentifier"},{"kind":"text","text":"?"}],"title":"geometry"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRA