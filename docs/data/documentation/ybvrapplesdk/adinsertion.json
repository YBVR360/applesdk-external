{"abstract":[{"type":"text","text":"Schedule ad breaks against the content timeline and drive your own ad UI."}],"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"kind":"article","metadata":{"roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}],"role":"article","title":"Inserting Ads"},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"anchor":"Guides","generated":true,"title":"Guides"}],"primaryContentSections":[{"content":[{"anchor":"Overview","text":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController","isActive":true,"type":"reference"},{"type":"text","text":", reached through "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","isActive":true,"type":"reference"},{"type":"text","text":", inserts ad breaks as HLS"},{"type":"text","text":" "},{"type":"text","text":"interstitials. That has two consequences worth knowing up front:"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"text":"No manifest support is needed.","type":"text"}],"type":"strong"},{"text":" The content playlist does not have to carry","type":"text"},{"text":" ","type":"text"},{"code":"EXT-X-DATERANGE","type":"codeVoice"},{"text":" tags — the cue points come from the schedule you supply.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Resuming is seamless.","type":"text"}],"type":"strong"},{"text":" The content item stays buffered across a break, so nothing of the","type":"text"},{"text":" ","type":"text"},{"text":"content is lost or skipped when an ad plays.","type":"text"}],"type":"paragraph"}]}]},{"style":"important","type":"aside","name":"Important","content":[{"inlineContent":[{"text":"Ads require the HLS player. Low-latency RTMP streams have no interstitial","type":"text"},{"text":" ","type":"text"},{"text":"mechanism, and a schedule set on one is ignored.","type":"text"}],"type":"paragraph"}]},{"type":"heading","level":2,"anchor":"Scheduling-Breaks","text":"Scheduling Breaks"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build an "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","isActive":true,"type":"reference"},{"type":"text","text":" from a cue point and the creatives to play there, then hand the whole"},{"type":"text","text":" "},{"type":"text","text":"schedule to "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","isActive":true,"type":"reference"},{"type":"text","text":". Each call replaces the previous schedule:"}]},{"type":"codeListing","syntax":"swift","code":["let breaks = [","    YBVRAdBreak(","        id: \"pre\",","        cue: .preRoll,","        creatives: [YBVRAdCreative(urlString: preRollURL)]","    ),","    YBVRAdBreak(","        id: \"mid-1\",","        cue: .midRoll(120),","        creatives: [","            YBVRAdCreative(urlString: firstInPodURL),","            YBVRAdCreative(urlString: secondInPodURL)","        ],","        skipAfter: 5","    ),","    YBVRAdBreak(","        id: \"post\",","        cue: .postRoll,","        creatives: [YBVRAdCreative(urlString: postRollURL)]","    )","]","","player.ads.schedule(breaks)"]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCue","isActive":true,"type":"reference"},{"type":"text","text":" places the break: "},{"code":".preRoll","type":"codeVoice"},{"type":"text","text":" before the content, "},{"code":".midRoll(seconds)","type":"codeVoice"},{"type":"text","text":" at a point"},{"type":"text","text":" "},{"type":"text","text":"on the content timeline, "},{"code":".postRoll","type":"codeVoice"},{"type":"text","text":" after it. Listing several creatives in one break plays"},{"type":"text","text":" "},{"type":"text","text":"them back to back as a pod. Creatives with unusable URLs are dropped."}]},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/skipAfter","isActive":true,"type":"reference"},{"type":"text","text":" sets how many seconds must play before the break can be skipped, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/maxDuration","isActive":true,"type":"reference"},{"type":"text","text":" caps the break. "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/scheduled","isActive":true,"type":"reference"},{"type":"text","text":" reads back what is"},{"type":"text","text":" "},{"type":"text","text":"currently scheduled, and "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()","isActive":true,"type":"reference"},{"type":"text","text":" drops it — though a break already"},{"type":"text","text":" "},{"type":"text","text":"on screen plays to its end."}]},{"style":"note","type":"aside","name":"Note","content":[{"inlineContent":[{"text":"Schedules are per content item. Re-apply them after","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"text":"; see ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},{"text":".","type":"text"}],"type":"paragraph"}]},{"type":"heading","level":3,"anchor":"Immersive-Creatives","text":"Immersive Creatives"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A creative renders as a flat 2D panel by default. Pass "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative\/geometry"},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"creative authored for an immersive geometry, and the surface switches for that creative and is"},{"type":"text","text":" "},{"type":"text","text":"restored to the content’s geometry when the break ends:"}]},{"type":"codeListing","syntax":"swift","code":["YBVRAdCreative(urlString: sphericalAdURL, geometry: .nsEquirectangularMono)"]},{"type":"heading","level":2,"anchor":"Observing-Ad-Playback","text":"Observing Ad Playback"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playback"},{"type":"text","text":" carries a "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback"},{"type":"text","text":" while an ad is on screen and "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"text","text":"while content plays — the simplest signal for “am I in an ad right now”:"}]},{"type":"codeListing","syntax":"swift","code":["player.ads.playback","    .receive(on: DispatchQueue.main)","    .sink { [weak self] playback in","        self?.adPlayback = playback","        self?.isPlayingAd = playback != nil","    }","    .store(in: &cancellables)"]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback"},{"type":"text","text":" names the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak"},{"type":"text","text":", the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative"},{"type":"text","text":" on screen, and its index"},{"type":"text","text":" "},{"type":"text","text":"within the pod — enough to render “Ad 2 of 3”."}]},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didBegin"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd"},{"type":"text","text":" fire once per break for"},{"type":"text","text":" "},{"type":"text","text":"one-shot work such as hiding your transport controls:"}]},{"type":"codeListing","syntax":"swift","code":["player.ads.didBegin","    .receive(on: DispatchQueue.main)","    .sink { [weak self] _ in self?.hideControls() }","    .store(in: &cancellables)"]},{"type":"heading","level":3,"anchor":"Progress-and-Skipping","text":"Progress and Skipping"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position"},{"type":"text","text":" and "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration"},{"type":"text","text":" track progress through the ad"},{"type":"text","text":" "},{"type":"text","text":"on screen, in seconds, and are zero outside a break. Progress is break-relative when the break"},{"type":"text","text":" "},{"type":"text","text":"declares a "},{"type":"codeVoice","code":"maxDuration"},{"type":"text","text":" and creative-relative otherwise."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Drive a skip button from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn"},{"type":"text","text":", and call"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()"},{"type":"text","text":" to act on it:"}]},{"type":"codeListing","syntax":"swift","code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"]},{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"cancelCurrentBreak()"},{"type":"text","text":" abandons the break and resumes the content where it was interrupted —"},{"type":"text","text":" "},{"type":"text","text":"no content is skipped. It returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when refused because the break’s "},{"type":"codeVoice","code":"skipAfter"},{"type":"text","text":" offset"},{"type":"text","text":" "},{"type":"text","text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the"},{"type":"text","text":" "},{"type":"text","text":"button’s enabled state to "},{"type":"codeVoice","code":"canSkip"},{"type":"text","text":" keeps the two in step."}]},{"type":"heading","level":3,"anchor":"Seeks-and-Missed-Mid-Rolls","text":"Seeks and Missed Mid-Rolls"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Interstitials fire when playback "},{"inlineContent":[{"text":"crosses","type":"text"}],"type":"emphasis"},{"type":"text","text":" a cue point, so a seek can jump over one. By"},{"type":"text","text":" "},{"type":"text","text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last"},{"text":" ","type":"text"},{"type":"text","text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","isActive":true,"type":"reference"},{"type":"text","text":":"}]},{"code":["player.ads.playsMissedMidRollsOnSeek = false"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","isActive":true,"type":"reference"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"text":" while an ad re-armed by a seek is being fetched but","type":"text"},{"text":" ","type":"text"},{"text":"has not yet reached the screen — a good cue for a brief spinner.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true,"type":"reference"},{"text":" reports the breaks that have already played or been skipped,","type":"text"},{"text":" ","type":"text"},{"text":"which is what you need to draw timeline markers that distinguish consumed breaks from","type":"text"},{"text":" ","type":"text"},{"text":"upcoming ones.","type":"text"}],"type":"paragraph"},{"anchor":"Resuming-a-Session-on-Another-Player","level":3,"text":"Resuming a Session on Another Player","type":"heading"},{"inlineContent":[{"type":"text","text":"Which breaks have played lives in the manager that played them, and a schedule is armed"},{"text":" ","type":"text"},{"text":"against the content that manager opened. Resuming the same content on a ","type":"text"},{"inlineContent":[{"text":"new","type":"text"}],"type":"emphasis"},{"text":" manager —","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed"},{"text":" ","type":"text"},{"text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up","type":"text"},{"text":" ","type":"text"},{"text":"above reads as a viewer skipping them.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Carry the ids across and hand them over before the new manager opens its stream:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"type":"codeListing"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","isActive":true,"type":"reference"},{"type":"text","text":" drops those breaks from the schedule and takes them out of"},{"text":" ","type":"text"},{"text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine","type":"text"},{"text":" ","type":"text"},{"text":"content switch still plays its ads. See ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}],"kind":"content"}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},"variants":[{"paths":["\/documentation\/ybvrapplesdk\/adinsertion"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController":{"navigatorTitle":[{"text":"YBVRAdController","kind":"identifier"}],"title":"YBVRAdController","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller","abstract":[{"type":"text","text":"Breaks are inserted as HLS interstitials, which means:"}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"class","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YBVRAdController","kind":"identifier"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdCreative/geometry":{"ur