{"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},"abstract":[{"text":"Schedule ad breaks against the content timeline and drive your own ad UI.","type":"text"}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"generated":true,"anchor":"Guides"}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","type":"heading","anchor":"Overview","level":2},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController"},{"text":", reached through ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads"},{"type":"text","text":", inserts ad breaks as HLS"},{"type":"text","text":" "},{"type":"text","text":"interstitials. That has two consequences worth knowing up front:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"No manifest support is needed."}],"type":"strong"},{"type":"text","text":" The content playlist does not have to carry"},{"type":"text","text":" "},{"type":"codeVoice","code":"EXT-X-DATERANGE"},{"type":"text","text":" tags — the cue points come from the schedule you supply."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"Resuming is seamless.","type":"text"}]},{"type":"text","text":" The content item stays buffered across a break, so nothing of the"},{"type":"text","text":" "},{"type":"text","text":"content is lost or skipped when an ad plays."}]}]}]},{"type":"aside","style":"important","name":"Important","content":[{"inlineContent":[{"text":"Ads require the HLS player. Low-latency RTMP streams have no interstitial","type":"text"},{"text":" ","type":"text"},{"text":"mechanism, and a schedule set on one is ignored.","type":"text"}],"type":"paragraph"}]},{"type":"heading","level":2,"text":"Scheduling Breaks","anchor":"Scheduling-Breaks"},{"inlineContent":[{"type":"text","text":"Build an "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","type":"reference","isActive":true},{"type":"text","text":" from a cue point and the creatives to play there, then hand the whole"},{"type":"text","text":" "},{"type":"text","text":"schedule to "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","type":"reference","isActive":true},{"type":"text","text":". Each call replaces the previous schedule:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["let breaks = [","    YBVRAdBreak(","        id: \"pre\",","        cue: .preRoll,","        creatives: [YBVRAdCreative(urlString: preRollURL)]","    ),","    YBVRAdBreak(","        id: \"mid-1\",","        cue: .midRoll(120),","        creatives: [","            YBVRAdCreative(urlString: firstInPodURL),","            YBVRAdCreative(urlString: secondInPodURL)","        ],","        skipAfter: 5","    ),","    YBVRAdBreak(","        id: \"post\",","        cue: .postRoll,","        creatives: [YBVRAdCreative(urlString: postRollURL)]","    )","]","","player.ads.schedule(breaks)"]},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCue","type":"reference","isActive":true},{"type":"text","text":" places the break: "},{"type":"codeVoice","code":".preRoll"},{"type":"text","text":" before the content, "},{"type":"codeVoice","code":".midRoll(seconds)"},{"type":"text","text":" at a point"},{"type":"text","text":" "},{"type":"text","text":"on the content timeline, "},{"type":"codeVoice","code":".postRoll"},{"type":"text","text":" after it. Listing several creatives in one break plays"},{"type":"text","text":" "},{"type":"text","text":"them back to back as a pod. Creatives with unusable URLs are dropped."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/skipAfter","type":"reference","isActive":true},{"type":"text","text":" sets how many seconds must play before the break can be skipped, and"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/maxDuration","type":"reference","isActive":true},{"type":"text","text":" caps the break. "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/scheduled","type":"reference","isActive":true},{"type":"text","text":" reads back what is"},{"type":"text","text":" "},{"type":"text","text":"currently scheduled, and "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()"},{"type":"text","text":" drops it — though a break already"},{"type":"text","text":" "},{"type":"text","text":"on screen plays to its end."}],"type":"paragraph"},{"type":"aside","style":"note","name":"Note","content":[{"inlineContent":[{"type":"text","text":"Schedules are per content item. Re-apply them after"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"type":"text","text":"; see "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},{"type":"text","text":"."}],"type":"paragraph"}]},{"type":"heading","level":3,"text":"Immersive Creatives","anchor":"Immersive-Creatives"},{"inlineContent":[{"type":"text","text":"A creative renders as a flat 2D panel by default. Pass "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative\/geometry","type":"reference","isActive":true},{"type":"text","text":" for a"},{"text":" ","type":"text"},{"type":"text","text":"creative authored for an immersive geometry, and the surface switches for that creative and is"},{"text":" ","type":"text"},{"type":"text","text":"restored to the content’s geometry when the break ends:"}],"type":"paragraph"},{"code":["YBVRAdCreative(urlString: sphericalAdURL, geometry: .nsEquirectangularMono)"],"syntax":"swift","type":"codeListing"},{"type":"heading","level":2,"text":"Observing Ad Playback","anchor":"Observing-Ad-Playback"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playback","type":"reference","isActive":true},{"text":" carries a ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback","type":"reference","isActive":true},{"type":"text","text":" while an ad is on screen and "},{"type":"codeVoice","code":"nil"},{"type":"text","text":" "},{"type":"text","text":"while content plays — the simplest signal for “am I in an ad right now”:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["player.ads.playback","    .receive(on: DispatchQueue.main)","    .sink { [weak self] playback in","        self?.adPlayback = playback","        self?.isPlayingAd = playback != nil","    }","    .store(in: &cancellables)"]},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback","type":"reference","isActive":true},{"type":"text","text":" names the "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","type":"reference","isActive":true},{"type":"text","text":", the "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative","type":"reference","isActive":true},{"type":"text","text":" on screen, and its index"},{"type":"text","text":" "},{"type":"text","text":"within the pod — enough to render “Ad 2 of 3”."}],"type":"paragraph"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didBegin","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd","type":"reference","isActive":true},{"type":"text","text":" fire once per break for"},{"type":"text","text":" "},{"type":"text","text":"one-shot work such as hiding your transport controls:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["player.ads.didBegin","    .receive(on: DispatchQueue.main)","    .sink { [weak self] _ in self?.hideControls() }","    .store(in: &cancellables)"]},{"type":"heading","level":3,"text":"Progress and Skipping","anchor":"Progress-and-Skipping"},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position","type":"reference","isActive":true},{"type":"text","text":" and "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration","type":"reference","isActive":true},{"type":"text","text":" track progress through the ad"},{"type":"text","text":" "},{"type":"text","text":"on screen, in seconds, and are zero outside a break. Progress is break-relative when the break"},{"type":"text","text":" "},{"type":"text","text":"declares a "},{"type":"codeVoice","code":"maxDuration"},{"type":"text","text":" and creative-relative otherwise."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Drive a skip button from "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip","type":"reference","isActive":true},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn"},{"type":"text","text":", and call"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()"},{"type":"text","text":" to act on it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"]},{"inlineContent":[{"type":"codeVoice","code":"cancelCurrentBreak()"},{"type":"text","text":" abandons the break and resumes the content where it was interrupted —"},{"type":"text","text":" "},{"type":"text","text":"no content is skipped. It returns "},{"type":"codeVoice","code":"false"},{"type":"text","text":" when refused because the break’s "},{"type":"codeVoice","code":"skipAfter"},{"type":"text","text":" offset"},{"type":"text","text":" "},{"type":"text","text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the"},{"type":"text","text":" "},{"type":"text","text":"button’s enabled state to "},{"type":"codeVoice","code":"canSkip"},{"type":"text","text":" keeps the two in step."}],"type":"paragraph"},{"level":3,"anchor":"Seeks-and-Missed-Mid-Rolls","text":"Seeks and Missed Mid-Rolls","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Interstitials fire when playback "},{"inlineContent":[{"text":"crosses","type":"text"}],"type":"emphasis"},{"type":"text","text":" a cue point, so a seek can jump over one. By"},{"type":"text","text":" "},{"type":"text","text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last"},{"type":"text","text":" "},{"type":"text","text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek"},{"type":"text","text":":"}]},{"code":["player.ads.playsMissedMidRollsOnSeek = false"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","isActive":true,"type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" while an ad re-armed by a seek is being fetched but","type":"text"},{"text":" ","type":"text"},{"text":"has not yet reached the screen — a good cue for a brief spinner.","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true,"type":"reference"},{"text":" reports the breaks that have already played or been skipped,","type":"text"},{"text":" ","type":"text"},{"text":"which is what you need to draw timeline markers that distinguish consumed breaks from","type":"text"},{"text":" ","type":"text"},{"text":"upcoming ones.","type":"text"}]},{"text":"Resuming a Session on Another Player","type":"heading","anchor":"Resuming-a-Session-on-Another-Player","level":3},{"type":"paragraph","inlineContent":[{"text":"Which breaks have played lives in the manager that played them, and a schedule is armed","type":"text"},{"text":" ","type":"text"},{"text":"against the content that manager opened. Resuming the same content on a ","type":"text"},{"inlineContent":[{"type":"text","text":"new"}],"type":"emphasis"},{"text":" manager —","type":"text"},{"text":" ","type":"text"},{"text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed","type":"text"},{"text":" ","type":"text"},{"text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up","type":"text"},{"text":" ","type":"text"},{"text":"above reads as a viewer skipping them.","type":"text"}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Carry the ids across and hand them over before the new manager opens its stream:"}]},{"type":"codeListing","code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)"},{"type":"text","text":" drops those breaks from the schedule and takes them out of"},{"type":"text","text":" "},{"type":"text","text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine"},{"type":"text","text":" "},{"type":"text","text":"content switch still plays its ads. See "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"},{"type":"text","text":"."}]}]}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/adinsertion"]}],"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","modules":[{"name":"YBVRAppleSDK"}],"title":"Inserting Ads","roleHeading":"Article"},"kind":"article","references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/canSkip":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip","abstract":[],"title":"canSkip","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/canskip","role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"canSkip","kind":"identifier"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:7Combine19CurrentValueSubjectC","text":"CurrentValueSubject","kind":"typeIdentifier"},{"text":"<","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":", 