{"metadata":{"title":"Inserting Ads","role":"article","modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article"},"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/adinsertion"]}],"seeAlsoSections":[{"title":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"generated":true,"anchor":"Guides"}],"kind":"article","sections":[],"schemaVersion":{"major":0,"patch":0,"minor":3},"abstract":[{"type":"text","text":"Schedule ad breaks against the content timeline and drive your own ad UI."}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController","isActive":true},{"text":", reached through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads"},{"text":", inserts ad breaks as HLS","type":"text"},{"text":" ","type":"text"},{"text":"interstitials. That has two consequences worth knowing up front:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"inlineContent":[{"type":"text","text":"No manifest support is needed."}],"type":"strong"},{"text":" The content playlist does not have to carry","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"EXT-X-DATERANGE"},{"text":" tags — the cue points come from the schedule you supply.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"inlineContent":[{"text":"Resuming is seamless.","type":"text"}],"type":"strong"},{"type":"text","text":" The content item stays buffered across a break, so nothing of the"},{"type":"text","text":" "},{"type":"text","text":"content is lost or skipped when an ad plays."}],"type":"paragraph"}]}]},{"type":"aside","name":"Important","style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Ads require the HLS player. Low-latency RTMP streams have no interstitial","type":"text"},{"text":" ","type":"text"},{"text":"mechanism, and a schedule set on one is ignored.","type":"text"}]}]},{"type":"heading","level":2,"text":"Scheduling Breaks","anchor":"Scheduling-Breaks"},{"type":"paragraph","inlineContent":[{"text":"Build an ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","isActive":true,"type":"reference"},{"text":" from a cue point and the creatives to play there, then hand the whole","type":"text"},{"text":" ","type":"text"},{"text":"schedule to ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)"},{"text":". Each call replaces the previous schedule:","type":"text"}]},{"code":["let breaks = [","    YBVRAdBreak(","        id: \"pre\",","        cue: .preRoll,","        creatives: [YBVRAdCreative(urlString: preRollURL)]","    ),","    YBVRAdBreak(","        id: \"mid-1\",","        cue: .midRoll(120),","        creatives: [","            YBVRAdCreative(urlString: firstInPodURL),","            YBVRAdCreative(urlString: secondInPodURL)","        ],","        skipAfter: 5","    ),","    YBVRAdBreak(","        id: \"post\",","        cue: .postRoll,","        creatives: [YBVRAdCreative(urlString: postRollURL)]","    )","]","","player.ads.schedule(breaks)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCue","isActive":true},{"type":"text","text":" places the break: "},{"type":"codeVoice","code":".preRoll"},{"type":"text","text":" before the content, "},{"type":"codeVoice","code":".midRoll(seconds)"},{"type":"text","text":" at a point"},{"type":"text","text":" "},{"type":"text","text":"on the content timeline, "},{"type":"codeVoice","code":".postRoll"},{"type":"text","text":" after it. Listing several creatives in one break plays"},{"type":"text","text":" "},{"type":"text","text":"them back to back as a pod. Creatives with unusable URLs are dropped."}]},{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/skipAfter"},{"type":"text","text":" sets how many seconds must play before the break can be skipped, and"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak\/maxDuration"},{"type":"text","text":" caps the break. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/scheduled"},{"type":"text","text":" reads back what is"},{"text":" ","type":"text"},{"text":"currently scheduled, and ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/clearSchedule()","type":"reference"},{"text":" drops it — though a break already","type":"text"},{"text":" ","type":"text"},{"text":"on screen plays to its end.","type":"text"}],"type":"paragraph"},{"name":"Note","style":"note","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"Schedules are per content item. Re-apply them after","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true,"type":"reference"},{"text":"; see ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true,"type":"reference"},{"text":".","type":"text"}]}]},{"text":"Immersive Creatives","anchor":"Immersive-Creatives","level":3,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A creative renders as a flat 2D panel by default. Pass "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative\/geometry","type":"reference","isActive":true},{"type":"text","text":" for a"},{"type":"text","text":" "},{"type":"text","text":"creative authored for an immersive geometry, and the surface switches for that creative and is"},{"type":"text","text":" "},{"type":"text","text":"restored to the content’s geometry when the break ends:"}]},{"code":["YBVRAdCreative(urlString: sphericalAdURL, geometry: .nsEquirectangularMono)"],"type":"codeListing","syntax":"swift"},{"text":"Observing Ad Playback","anchor":"Observing-Ad-Playback","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playback","type":"reference","isActive":true},{"text":" carries a ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback","type":"reference","isActive":true},{"text":" while an ad is on screen and ","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"text":"while content plays — the simplest signal for “am I in an ad right now”:","type":"text"}]},{"code":["player.ads.playback","    .receive(on: DispatchQueue.main)","    .sink { [weak self] playback in","        self?.adPlayback = playback","        self?.isPlayingAd = playback != nil","    }","    .store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdPlayback","type":"reference"},{"text":" names the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdBreak","type":"reference"},{"text":", the ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdCreative","type":"reference"},{"text":" on screen, and its index","type":"text"},{"text":" ","type":"text"},{"text":"within the pod — enough to render “Ad 2 of 3”.","type":"text"}]},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didBegin"},{"text":" and ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/didEnd"},{"text":" fire once per break for","type":"text"},{"text":" ","type":"text"},{"text":"one-shot work such as hiding your transport controls:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["player.ads.didBegin","    .receive(on: DispatchQueue.main)","    .sink { [weak self] _ in self?.hideControls() }","    .store(in: &cancellables)"],"syntax":"swift"},{"anchor":"Progress-and-Skipping","type":"heading","text":"Progress and Skipping","level":3},{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/position","isActive":true,"type":"reference"},{"text":" and ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration","isActive":true,"type":"reference"},{"text":" track progress through the ad","type":"text"},{"text":" ","type":"text"},{"text":"on screen, in seconds, and are zero outside a break. Progress is break-relative when the break","type":"text"},{"text":" ","type":"text"},{"text":"declares a ","type":"text"},{"code":"maxDuration","type":"codeVoice"},{"text":" and creative-relative otherwise.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Drive a skip button from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/canSkip"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/skipAvailableIn","isActive":true},{"type":"text","text":", and call"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/cancelCurrentBreak()","isActive":true},{"type":"text","text":" to act on it:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["if vm.canSkipAd {","    Button(\"Skip Ad\") { player.ads.cancelCurrentBreak() }","} else {","    Text(\"Skip in \\(Int(vm.skipAvailableIn))s\")","}"]},{"inlineContent":[{"type":"codeVoice","code":"cancelCurrentBreak()"},{"text":" abandons the break and resumes the content where it was interrupted —","type":"text"},{"text":" ","type":"text"},{"text":"no content is skipped. It returns ","type":"text"},{"code":"false","type":"codeVoice"},{"text":" when refused because the break’s ","type":"text"},{"code":"skipAfter","type":"codeVoice"},{"text":" offset","type":"text"},{"text":" ","type":"text"},{"text":"has not elapsed, so the offset holds even if your own button says otherwise. Binding the","type":"text"},{"text":" ","type":"text"},{"text":"button’s enabled state to ","type":"text"},{"code":"canSkip","type":"codeVoice"},{"type":"text","text":" keeps the two in step."}],"type":"paragraph"},{"type":"heading","text":"Seeks and Missed Mid-Rolls","level":3,"anchor":"Seeks-and-Missed-Mid-Rolls"},{"inlineContent":[{"type":"text","text":"Interstitials fire when playback "},{"inlineContent":[{"type":"text","text":"crosses"}],"type":"emphasis"},{"type":"text","text":" a cue point, so a seek can jump over one. By"},{"type":"text","text":" "},{"type":"text","text":"default the SDK plays the mid-roll guarding the segment the playhead landed in — the last"},{"type":"text","text":" "},{"text":"mid-roll cue at or before the new position, if it has not already played. Turn that off with","type":"text"},{"text":" ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek"},{"type":"text","text":":"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["player.ads.playsMissedMidRollsOnSeek = false"]},{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/isPreparing","isActive":true},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" while an ad re-armed by a seek is being fetched but","type":"text"},{"text":" ","type":"text"},{"text":"has not yet reached the screen — a good cue for a brief spinner.","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds"},{"text":" reports the breaks that have already played or been skipped,","type":"text"},{"text":" ","type":"text"},{"text":"which is what you need to draw timeline markers that distinguish consumed breaks from","type":"text"},{"text":" ","type":"text"},{"text":"upcoming ones.","type":"text"}],"type":"paragraph"},{"anchor":"Resuming-a-Session-on-Another-Player","text":"Resuming a Session on Another Player","type":"heading","level":3},{"inlineContent":[{"text":"Which breaks have played lives in the manager that played them, and a schedule is armed","type":"text"},{"text":" ","type":"text"},{"text":"against the content that manager opened. Resuming the same content on a ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"new","type":"text"}]},{"type":"text","text":" manager —"},{"type":"text","text":" "},{"text":"swapping the rendering surface — therefore starts with an empty history: the pre-roll is armed","type":"text"},{"text":" ","type":"text"},{"text":"again, and restoring the playhead seeks over the mid-rolls already watched, which the catch-up","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"above reads as a viewer skipping them."}],"type":"paragraph"},{"inlineContent":[{"text":"Carry the ids across and hand them over before the new manager opens its stream:","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["let seen = oldPlayer.ads.playedIds.value","\/\/ …build the new manager…","newPlayer.ads.markPlayed(seen)"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","type":"reference","isActive":true},{"type":"text","text":" drops those breaks from the schedule and takes them out of"},{"type":"text","text":" "},{"type":"text","text":"the seek catch-up. It is cleared when the manager moves on to new content, so a genuine"},{"type":"text","text":" "},{"type":"text","text":"content switch still plays its ads. See "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"},{"type":"text","text":"."}]}]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/duration":{"type":"topic","title":"duration","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/duration","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/duration","abstract":[],"kind":"symbol","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"duration"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Combine19CurrentValueSubjectC","kind":"typeIdentifier","text":"CurrentValueSubject"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:Sd","kind":"typeIdentifier","text":"Double"},{"ki