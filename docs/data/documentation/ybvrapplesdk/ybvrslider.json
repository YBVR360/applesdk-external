{"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSlider"},"sections":[],"metadata":{"externalID":"s:12YBVRAppleSDK10YBVRSliderV","title":"YBVRSlider","symbolKind":"struct","roleHeading":"Structure","navigatorTitle":[{"kind":"identifier","text":"YBVRSlider"}],"fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"YBVRSlider"}],"modules":[{"name":"YBVRAppleSDK"}],"role":"symbol"},"abstract":[{"type":"text","text":"The seek and volume slider, with optional ad-break markers on its track."}],"schemaVersion":{"major":0,"patch":0,"minor":3},"primaryContentSections":[{"kind":"declarations","declarations":[{"tokens":[{"text":"@","kind":"attribute"},{"text":"MainActor","kind":"attribute","preciseIdentifier":"s:ScM"},{"text":" ","kind":"text"},{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"YBVRSlider","kind":"identifier"}],"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"]}]},{"kind":"content","content":[{"type":"heading","level":2,"anchor":"overview","text":"Overview"},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Dragging moves the thumb from where it is, by as much as the drag - it does not jump to the touch."}]}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"seekingValue"},{"type":"text","text":" follows the drag continuously, between "},{"type":"codeVoice","code":"onScrubBegan"},{"type":"text","text":" and "},{"type":"codeVoice","code":"onScrubEnded"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"while the thumb holds still against "},{"code":"value","type":"codeVoice"},{"text":" until the scrub is over.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Once it is, the thumb stays where it was let go until "},{"type":"codeVoice","code":"value"},{"type":"text","text":" catches up, rather than"},{"type":"text","text":" "},{"type":"text","text":"jumping back to where playback was while the host’s seek is still under way."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"trackHeight","type":"codeVoice"},{"type":"text","text":" and "},{"code":"thumbSize","type":"codeVoice"},{"type":"text","text":" size the track and the thumb. A thumb smaller than the track"},{"type":"text","text":" "},{"type":"text","text":"sits inside it, a larger one overhangs it, and "},{"code":"0","type":"codeVoice"},{"type":"text","text":" leaves it off - for a bar that only shows"},{"type":"text","text":" "},{"type":"text","text":"progress."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"It looks the same on iOS and visionOS."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"It dims when disabled and is adjustable with VoiceOver, in tenths of its range.","type":"text"}]}]}]}]}],"kind":"symbol","variants":[{"paths":["\/documentation\/ybvrapplesdk\/ybvrslider"],"traits":[{"interfaceLanguage":"swift"}]}],"relationshipsSections":[{"kind":"relationships","type":"conformsTo","title":"Conforms To","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/s8SendableP","doc:\/\/applesdk.YBVRAppleSDK\/7SwiftUI4ViewP"]}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"topicSections":[{"anchor":"Structures","generated":true,"title":"Structures","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSlider\/AdMarker"]},{"anchor":"Initializers","generated":true,"title":"Initializers","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSlider\/init(value:maxValue:seekingValue:trackHeight:thumbSize:minimumTrackTintColor:maximumTrackTintColor:adMarkers:onScrubBegan:onScrubEnded:)"]},{"anchor":"Instance-Properties","generated":true,"title":"Instance Properties","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSD