{"abstract":[{"text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is.","type":"text"}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"schemaVersion":{"minor":3,"major":0,"patch":0},"kind":"article","seeAlsoSections":[{"anchor":"Related-Documentation","title":"Related Documentation","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"]},{"generated":true,"title":"Guides","anchor":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"]}],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","level":2,"type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK plays FairPlay-protected HLS through "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer"},{"type":"text","text":" — the thin wrapper around"},{"type":"text","text":" "},{"type":"text","text":"AVFoundation that skips the YBVR signaling and geometry stack. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":", the"},{"type":"text","text":" "},{"type":"text","text":"pipeline behind "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView"},{"type":"text","text":" and the immersive renderers, has no DRM path at all:"},{"type":"text","text":" "},{"type":"text","text":"nothing in it accepts a "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig"},{"type":"text","text":", so a protected stream opened through it fails to"},{"type":"text","text":" "},{"type":"text","text":"decrypt."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"That split is not an oversight waiting to be wired up. It follows from how protected frames"},{"type":"text","text":" "},{"type":"text","text":"reach the screen, which is covered below, and it decides which content can carry DRM at all."}]},{"text":"Where DRM Can Be Used","anchor":"Where-DRM-Can-Be-Used","level":2,"type":"heading"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Playback path"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"How frames reach the screen"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Protected content"}]}]],[[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer"},{"type":"text","text":" on iOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"codeVoice","code":"AVPlayerLayer"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Yes"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","isActive":true},{"type":"text","text":" on visionOS"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RealityKit "},{"type":"codeVoice","code":"VideoPlayerComponent"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, on device only"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference","isActive":true},{"type":"text","text":" + "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","type":"reference","isActive":true}]}],[{"inlineContent":[{"type":"text","text":"Metal, from "},{"type":"codeVoice","code":"AVPlayerItemVideoOutput"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" + "},{"type":"codeVoice","code":"VisionSurfaceContext"}]}],[{"inlineContent":[{"type":"text","text":"Metal, via Compositor Services"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"No"}]}]],[[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" + "},{"type":"codeVoice","code":"VideoPlayerComponentSurfaceContext"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"RealityKit "},{"type":"codeVoice","code":"VideoPlayerComponent"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Not available — no API to supply a "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig","isActive":true}],"type":"paragraph"}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"The rule behind the table: FairPlay decodes into a protected path that the system can"},{"type":"text","text":" "},{"type":"text","text":"composite but the app cannot read. Surfaces that hand the "},{"type":"codeVoice","code":"AVPlayer"},{"type":"text","text":" to the system — an"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVPlayerLayer"},{"type":"text","text":", or a RealityKit "},{"type":"codeVoice","code":"VideoPlayerComponent"},{"type":"text","text":" — therefore play protected content"},{"type":"text","text":" "},{"type":"text","text":"fine. The YBVR geometry renderers do the opposite: they copy each decoded frame out with"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVPlayerItemVideoOutput.copyPixelBuffer"},{"type":"text","text":" and draw it onto a sphere, dome, fisheye, flat"},{"type":"text","text":" "},{"type":"text","text":"panel, or control-room composition. No frames are handed out for protected content, so there"},{"type":"text","text":" "},{"type":"text","text":"is nothing to texture the geometry with."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"In content terms:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"DRM is possible"}]},{"text":" for material that plays as an ordinary AVFoundation item: flat or","type":"text"},{"text":" ","type":"text"},{"text":"rectilinear video, and immersive video whose projection is described by embedded metadata","type":"text"},{"text":" ","type":"text"},{"text":"the system itself understands (APMP, spatial, and the equirectangular kinds AVFoundation","type":"text"},{"text":" ","type":"text"},{"text":"recognises), which ","type":"text"},{"type":"codeVoice","code":"DirectPlayerImmersiveScene"},{"text":" in the visionOS demo app projects onto a","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"VideoPlayerComponent"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"DRM is not possible"}]},{"text":" for anything that depends on YBVR-side rendering: custom geometry","type":"text"},{"text":" ","type":"text"},{"text":"from the signaling file, viewport-tiled streams, multi-camera control rooms, or camera","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"switching inside a single stream. Those need the pixel buffers FairPlay withholds."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"DRM is not possible over RTMP.","type":"text"}]},{"type":"text","text":" Low-latency streams play through "},{"type":"codeVoice","code":"LowLatencyPlayer"},{"text":",","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"which is not AVFoundation-based and has no FairPlay path, so a "},{"type":"codeVoice","code":"drm"},{"text":" block on an RTMP","type":"text"},{"text":" ","type":"text"},{"text":"stream is reported but cannot be honoured.","type":"text"}]}]}]},{"anchor":"Configuring-DRM","type":"heading","text":"Configuring DRM","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"The signaling file identifies the key; the certificate and license endpoints come from the"},{"type":"text","text":" "},{"type":"text","text":"host app. Both halves are required — a "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","type":"reference","isActive":true},{"type":"text","text":" on its own does not configure"},{"type":"text","text":" "},{"type":"text","text":"anything."}]},{"type":"codeListing","syntax":"swift","code":["let player = DirectPlayer()","","player.drmConfig = DrmConfig(","    certificateURL: \"https:\/\/...\/fairplay.cer\",","    licenseURL: \"https:\/\/...\/AcquireLicense\",","    drmKeyManager: keyManager",")","","await player.open(url: streamURL)"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Set "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/drmConfig","type":"reference","isActive":true},{"type":"text","text":" before "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/open(url:)","type":"reference","isActive":true},{"type":"text","text":". Assigning it builds the"},{"type":"text","text":" "},{"type":"codeVoice","code":"DrmManager"},{"type":"text","text":", and "},{"type":"codeVoice","code":"open"},{"type":"text","text":" installs the platform key handler around the new item — on visionOS"},{"type":"text","text":" "},{"type":"text","text":"the content key session is created there — so a config assigned afterwards does not apply to"},{"type":"text","text":" "},{"type":"text","text":"the item already loaded."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"When the stream follows the convention of a sibling signaling file, the two steps collapse"},{"type":"text","text":" "},{"type":"text","text":"into one call that fetches the key material and opens the stream:"}]},{"type":"codeListing","syntax":"swift","code":["try await player.open(","    url: streamURL,","    fetchingDrmFromSignalingWith: certificateURL,","    licenseURL: licenseURL",")"]},{"anchor":"Providers","type":"heading","text":"Providers","level":3},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager\/provider"},{"type":"text","text":" selects the license flow: "},{"type":"codeVoice","code":"\"axinom\""},{"type":"text","text":" and "},{"type":"codeVoice","code":"\"ybvr\""},{"type":"text","text":" are recognised,"},{"type":"text","text":" "},{"type":"text","text":"and any other value falls back to Axinom. Both currently resolve to the Axinom provider,"},{"type":"text","text":" "},{"type":"text","text":"which mints a license JWT and sends it as "},{"type":"codeVoice","code":"X-AxDRM-Message"},{"type":"text","text":" with the SPC."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"That JWT is minted by "},{"type":"codeVoice","code":"DrmJWTRequest"},{"type":"text","text":" against a hardcoded development XMS"},{"type":"text","text":" "},{"type":"text","text":"backend, using OAuth client credentials compiled into the SDK. DRM therefore only works"},{"type":"text","text":" "},{"type":"text","text":"today against that one environment, and the credentials ship inside any binary that links"},{"type":"text","text":" "},{"type":"text","text":"the SDK. Treat production DRM as needing this made configurable first."}]}],"type":"aside","name":"Important","style":"important"},{"type":"heading","text":"How DRM Is Detected","anchor":"How-DRM-Is-Detected","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Detection runs entirely off the signaling file, before playback starts. Nothing inspects the"},{"type":"text","text":" "},{"type":"text","text":"media playlist, so an encrypted stream whose signaling omits "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" is indistinguishable from"},{"type":"text","text":" "},{"type":"text","text":"clear content until AVFoundation asks for a key and fails."}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","isActive":true,"type":"reference"},{"text":" resolves the signaling version from the","type":"text"},{"text":" ","type":"text"},{"text":"video URL: a path containing ","type":"text"},{"code":"_signaling_v4.json","type":"codeVoice"},{"text":" is v4, any other ","type":"text"},{"code":".json","type":"codeVoice"},{"text":" path is v3, and","type":"text"},{"text":" ","type":"text"},{"text":"a media URL is v2 — where the signaling file is the same URL with its extension swapped","type":"text"},{"text":" ","type":"text"},{"text":"for ","type":"text"},{"code":".json","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The response is decoded into ","type":"text"},{"code":"Signaling","type":"codeVoice"},{"text":" (v2), ","type":"text"},{"code":"SignalingV3","type":"codeVoice"},{"text":", or ","type":"text"},{"code":"SignalingV4","type":"codeVoice"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"The caller asks the result for ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","isActive":true,"type":"reference"},{"text":". A non-","type":"text"},{"code":"nil","type":"codeVoice"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","isActive":true,"type":"reference"},{"text":" means the content is protected, and both demo apps route it to","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","isActive":true,"type":"reference"},{"text":" on that basis.","type":"text"}]}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Content with no "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" key — or with "},{"type":"codeVoice","code":"\"drm\": null"},{"type":"text","text":" — is simply unprotected. The signaling"},{"type":"text","text":" "},{"type":"text","text":"decodes normally, no DRM is reported, and the stream plays through the usual geometry"},{"type":"text","text":" "},{"type":"text","text":"pipeline; this is the ordinary case for every clear title."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoding the block requires all three of "},{"type":"codeVoice","code":"ekid"},{"type":"text","text":", "},{"type":"codeVoice","code":"keyManagerUrl"},{"type":"text","text":", and "},{"type":"codeVoice","code":"drmProvider"},{"type":"text","text":". A block"},{"type":"text","text":" "},{"type":"text","text":"that is present but missing any of them is dropped on every signaling version, leaving the"},{"type":"text","text":" "},{"type":"text","text":"stream playable but reported as clear — so genuinely protected content then fails later at key"},{"type":"text","text":" "},{"type":"text","text":"time with an opaque AVFoundation error rather than a DRM-specific one. Validate the block when"},{"type":"text","text":" "},{"type":"text","text":"publishing. v4 logs the dropped block; v2 and v3 discard it silently."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What each version reports today:"}]},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Signaling version"}]}],[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"drm"},{"type":"text","text":" in the file"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Reported by "},{"type":"codeVoice","code":"drmKeyManager()"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v2"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]],[[{"inlineContent":[{"type":"text","text":"v3"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The key manager"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v4"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"type":"paragraph","inlineContent":[{"text":"The key manager","type":"text"}]}]]],"header":"row"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"A signaling model that decodes ","type":"text"},{"type":"codeVoice","code":"drm"},{"type":"text","text":" but does not implement"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","isActive":true},{"type":"text","text":" inherits the protocol’s default of "},{"type":"codeVoice","code":"nil"},{"type":"text","text":", and"},{"type":"text","text":" "},{"type":"text","text":"silently reports protected content as clear — nothing fails to compile. "},{"type":"codeVoice","code":"SignalingV4"},{"type":"text","text":" did"},{"type":"text","text":" "},{"type":"text","text":"exactly that until its accessor was added, so DRM-protected v4 streams were routed to the"},{"type":"text","text":" "},{"type":"text","text":"geometry pipeline where they cannot decrypt. Any new signaling version must implement that"},{"type":"text","text":" "},{"type":"text","text":"requirement, and "},{"type":"codeVoice","code":"SignalingDrmTests"},{"type":"text","text":" asserts detection through the protocol rather than the"},{"type":"text","text":" "},{"type":"text","text":"concrete type to keep the path covered."}]}],"style":"important","name":"Important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Outside the manager, "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/fetchDrmKeyManager(forStreamURL:session:)","type":"reference","isActive":true},{"type":"text","text":" performs the"},{"type":"text","text":" "},{"type":"text","text":"same lookup standalone: it swaps the stream URL’s extension for "},{"type":"codeVoice","code":".json"},{"type":"text","text":", decodes the v2 shape,"},{"type":"text","text":" "},{"type":"text","text":"and throws "},{"type":"codeVoice","code":"DirectPlayerDrmError.noDrmInfoInSignaling"},{"type":"text","text":" when no "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" entry is present."}]},{"type":"heading","text":"Platform Differences","level":2,"anchor":"Platform-Differences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK ships for iOS 17+ and visionOS 26+, and each uses the key-delivery API available to it."},{"type":"text","text":" "},{"type":"text","text":"Both share the same certificate fetch, license exchange, and "},{"type":"codeVoice","code":"DrmProvider"},{"type":"text","text":"."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"iOS","type":"text"}]},{"type":"text","text":" uses the classic "},{"type":"codeVoice","code":"skd:\/\/"},{"type":"text","text":" resource-loader flow. "},{"type":"codeVoice","code":"ApplePlayer"},{"type":"text","text":" sets itself as the"},{"type":"text","text":" "},{"type":"text","text":"asset’s "},{"type":"codeVoice","code":"AVAssetResourceLoaderDelegate"},{"type":"text","text":" for every stream, protected or not, and forwards"},{"type":"text","text":" "},{"type":"text","text":"key requests to "},{"type":"codeVoice","code":"DrmManager"},{"type":"text","text":" only when a config was supplied. Without one the request goes"},{"type":"text","text":" "},{"type":"text","text":"unanswered and playback fails."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"strong","inlineContent":[{"text":"visionOS","type":"text"}]},{"type":"text","text":" has never supported that flow and uses"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVContentKeySession(keySystem: .fairPlayStreaming)"},{"type":"text","text":" with an "},{"type":"codeVoice","code":"AVContentKeySessionDelegate"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The session is built during "},{"type":"codeVoice","code":"open"},{"type":"text","text":" only when a config is present."}]}]}]},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"FairPlay needs the Secure Enclave, so it does not work in the visionOS simulator —"},{"type":"text","text":" "},{"type":"text","text":"constructing the content key session there raises an uncatchable exception. The SDK detects"},{"type":"text","text":" "},{"type":"text","text":"the simulator, skips the session, and logs instead of trapping, which means protected"},{"type":"text","text":" "},{"type":"text","text":"content will load but not decrypt. Verify DRM on a real Vision Pro."}]}],"style":"note","name":"Note"},{"type":"heading","text":"Failure Modes","level":2,"anchor":"Failure-Modes"},{"type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Symptom"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Cause"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Protected stream plays black, or stalls at start"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Opened through "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":"; the geometry pipeline has no DRM path"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Content treated as clear despite a "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" block"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The block is missing "},{"type":"codeVoice","code":"ekid"},{"type":"text","text":", "},{"type":"codeVoice","code":"keyManagerUrl"},{"type":"text","text":", or "},{"type":"codeVoice","code":"drmProvider"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"License request rejected"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"JWT minting failed; the error is swallowed and an empty "},{"type":"codeVoice","code":"X-AxDRM-Message"},{"type":"text","text":" is sent, so the CKC fetch fails"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Works on device, fails in the visionOS simulator"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expected — FairPlay is unavailable there"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" block is detected but never honoured"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The stream is RTMP, played by "},{"type":"codeVoice","code":"LowLatencyPlayer"},{"type":"text","text":", which has no FairPlay path"}]}]]],"header":"row"}]}],"sections":[],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm","interfaceLanguage":"swift"},"metadata":{"role":"article","modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article","title":"FairPlay DRM"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/drm"]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/SignalingInterface/drmKeyManager()":{"kind":"symbol","required":true,"fragments":[{"text":"fu