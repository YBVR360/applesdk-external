{"metadata":{"roleHeading":"Article","role":"article","title":"FairPlay DRM","modules":[{"name":"YBVRAppleSDK"}]},"schemaVersion":{"patch":0,"minor":3,"major":0},"abstract":[{"type":"text","text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is."}],"kind":"article","hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"},"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"],"anchor":"Related-Documentation","title":"Related Documentation"},{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"],"generated":true,"anchor":"Guides","title":"Guides"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"type":"heading","level":2,"text":"Overview","anchor":"Overview"},{"inlineContent":[{"text":"The SDK plays FairPlay-protected HLS through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer"},{"text":" — the thin wrapper around","type":"text"},{"text":" ","type":"text"},{"text":"AVFoundation that skips the YBVR signaling and geometry stack. ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":", the","type":"text"},{"text":" ","type":"text"},{"text":"pipeline behind ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView"},{"text":" and the immersive renderers, has no DRM path at all:","type":"text"},{"text":" ","type":"text"},{"text":"nothing in it accepts a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig"},{"text":", so a protected stream opened through it fails to","type":"text"},{"text":" ","type":"text"},{"text":"decrypt.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"That split is not an oversight waiting to be wired up. It follows from how protected frames","type":"text"},{"text":" ","type":"text"},{"text":"reach the screen, which is covered below, and it decides which content can carry DRM at all.","type":"text"}],"type":"paragraph"},{"anchor":"Where-DRM-Can-Be-Used","text":"Where DRM Can Be Used","type":"heading","level":2},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Playback path","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"How frames reach the screen","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Protected content","type":"text"}]}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","type":"reference"},{"text":" on iOS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"code":"AVPlayerLayer","type":"codeVoice"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","type":"reference","isActive":true},{"type":"text","text":" on visionOS"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"RealityKit "},{"code":"VideoPlayerComponent","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Yes, on device only"}]}]],[[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference","isActive":true},{"text":" + ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","type":"reference","isActive":true}]}],[{"inlineContent":[{"text":"Metal, from ","type":"text"},{"code":"AVPlayerItemVideoOutput","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"text":"No","type":"text"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" + ","type":"text"},{"code":"VisionSurfaceContext","type":"codeVoice"}]}],[{"type":"paragraph","inlineContent":[{"text":"Metal, via Compositor Services","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"No","type":"text"}]}]],[[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference"},{"text":" + ","type":"text"},{"code":"VideoPlayerComponentSurfaceContext","type":"codeVoice"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"RealityKit "},{"type":"codeVoice","code":"VideoPlayerComponent"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Not available — no API to supply a ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmConfig","type":"reference"}]}]]]},{"type":"paragraph","inlineContent":[{"text":"The rule behind the table: FairPlay decodes into a protected path that the system can","type":"text"},{"type":"text","text":" "},{"text":"composite but the app cannot read. Surfaces that hand the ","type":"text"},{"type":"codeVoice","code":"AVPlayer"},{"text":" to the system — an","type":"text"},{"text":" ","type":"text"},{"type":"codeVoice","code":"AVPlayerLayer"},{"text":", or a RealityKit ","type":"text"},{"type":"codeVoice","code":"VideoPlayerComponent"},{"text":" — therefore play protected content","type":"text"},{"type":"text","text":" "},{"type":"text","text":"fine. The YBVR geometry renderers do the opposite: they copy each decoded frame out with"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVPlayerItemVideoOutput.copyPixelBuffer"},{"type":"text","text":" and draw it onto a sphere, dome, fisheye, flat"},{"type":"text","text":" "},{"type":"text","text":"panel, or control-room composition. No frames are handed out for protected content, so there"},{"text":" ","type":"text"},{"type":"text","text":"is nothing to texture the geometry with."}]},{"type":"paragraph","inlineContent":[{"text":"In content terms:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"DRM is possible","type":"text"}]},{"text":" for material that plays as an ordinary AVFoundation item: flat or","type":"text"},{"text":" ","type":"text"},{"text":"rectilinear video, and immersive video whose projection is described by embedded metadata","type":"text"},{"text":" ","type":"text"},{"text":"the system itself understands (APMP, spatial, and the equirectangular kinds AVFoundation","type":"text"},{"type":"text","text":" "},{"type":"text","text":"recognises), which a visionOS app projects onto a RealityKit "},{"code":"VideoPlayerComponent","type":"codeVoice"},{"text":" ","type":"text"},{"type":"text","text":"through "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/avPlayer","type":"reference"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"text":"DRM is not possible","type":"text"}]},{"type":"text","text":" for anything that depends on YBVR-side rendering: custom geometry"},{"type":"text","text":" "},{"type":"text","text":"from the signaling file, viewport-tiled streams, multi-camera control rooms, or camera"},{"type":"text","text":" "},{"type":"text","text":"switching inside a single stream. Those need the pixel buffers FairPlay withholds."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"strong","inlineContent":[{"type":"text","text":"DRM is not possible over RTMP."}]},{"type":"text","text":" Low-latency streams play through "},{"type":"codeVoice","code":"LowLatencyPlayer"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"which is not AVFoundation-based and has no FairPlay path, so a ","type":"text"},{"type":"codeVoice","code":"drm"},{"text":" block on an RTMP","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"stream is reported but cannot be honoured."}],"type":"paragraph"}]}]},{"anchor":"Configuring-DRM","text":"Configuring DRM","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"The signaling file identifies the key; the certificate and license endpoints come from the","type":"text"},{"text":" ","type":"text"},{"text":"host app. Both halves are required — a ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager"},{"text":" on its own does not configure","type":"text"},{"text":" ","type":"text"},{"text":"anything.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let player = DirectPlayer()","","player.drmConfig = DrmConfig(","    certificateURL: \"https:\/\/...\/fairplay.cer\",","    licenseURL: \"https:\/\/...\/AcquireLicense\",","    drmKeyManager: keyManager",")","","await player.open(url: streamURL)"]},{"type":"paragraph","inlineContent":[{"text":"Set ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/drmConfig"},{"text":" before ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/open(url:)"},{"text":". Assigning it builds the","type":"text"},{"text":" ","type":"text"},{"code":"DrmManager","type":"codeVoice"},{"text":", and ","type":"text"},{"code":"open","type":"codeVoice"},{"text":" installs the platform key handler around the new item — on visionOS","type":"text"},{"text":" ","type":"text"},{"text":"the content key session is created there — so a config assigned afterwards does not apply to","type":"text"},{"text":" ","type":"text"},{"text":"the item already loaded.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"When the stream follows the convention of a sibling signaling file, the two steps collapse","type":"text"},{"text":" ","type":"text"},{"text":"into one call that fetches the key material and opens the stream:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["try await player.open(","    url: streamURL,","    fetchingDrmFromSignalingWith: certificateURL,","    licenseURL: licenseURL",")"]},{"type":"heading","level":3,"text":"Providers","anchor":"Providers"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager\/provider"},{"text":" selects the license flow: ","type":"text"},{"type":"codeVoice","code":"\"axinom\""},{"text":" and ","type":"text"},{"type":"codeVoice","code":"\"ybvr\""},{"text":" are recognised,","type":"text"},{"text":" ","type":"text"},{"text":"and any other value falls back to Axinom. Both currently resolve to the Axinom provider,","type":"text"},{"text":" ","type":"text"},{"text":"which mints a license JWT and sends it as ","type":"text"},{"type":"codeVoice","code":"X-AxDRM-Message"},{"text":" with the SPC.","type":"text"}]},{"name":"Important","type":"aside","content":[{"type":"paragraph","inlineContent":[{"text":"That JWT is minted by ","type":"text"},{"type":"codeVoice","code":"DrmJWTRequest"},{"text":" against a hardcoded development XMS","type":"text"},{"text":" ","type":"text"},{"text":"backend, using OAuth client credentials compiled into the SDK. DRM therefore only works","type":"text"},{"type":"text","text":" "},{"text":"today against that one environment, and the credentials ship inside any binary that links","type":"text"},{"type":"text","text":" "},{"type":"text","text":"the SDK. Treat production DRM as needing this made configurable first."}]}],"style":"important"},{"type":"heading","anchor":"How-DRM-Is-Detected","level":2,"text":"How DRM Is Detected"},{"type":"paragraph","inlineContent":[{"text":"Detection runs entirely off the signaling file, before playback starts. Nothing inspects the","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"media playlist, so an encrypted stream whose signaling omits "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" is indistinguishable from"},{"type":"text","text":" "},{"type":"text","text":"clear content until AVFoundation asks for a key and fails."}]},{"items":[{"content":[{"inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","isActive":true},{"type":"text","text":" resolves the signaling version from the"},{"type":"text","text":" "},{"type":"text","text":"video URL: a path containing "},{"type":"codeVoice","code":"_signaling_v4.json"},{"type":"text","text":" is v4, any other "},{"type":"codeVoice","code":".json"},{"type":"text","text":" path is v3, and"},{"type":"text","text":" "},{"type":"text","text":"a media URL is v2 — where the signaling file is the same URL with its extension swapped"},{"type":"text","text":" "},{"type":"text","text":"for "},{"type":"codeVoice","code":".json"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"The response is decoded into "},{"type":"codeVoice","code":"Signaling"},{"type":"text","text":" (v2), "},{"type":"codeVoice","code":"SignalingV3"},{"type":"text","text":", or "},{"type":"codeVoice","code":"SignalingV4"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"The caller asks the result for ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","isActive":true},{"text":". A non-","type":"text"},{"type":"codeVoice","code":"nil"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DrmKeyManager","type":"reference","isActive":true},{"type":"text","text":" means the content is protected: route it to "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer","isActive":true},{"text":" on that","type":"text"},{"text":" ","type":"text"},{"text":"basis.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"Content with no "},{"code":"drm","type":"codeVoice"},{"text":" key — or with ","type":"text"},{"code":"\"drm\": null","type":"codeVoice"},{"text":" — is simply unprotected. The signaling","type":"text"},{"type":"text","text":" "},{"text":"decodes normally, no DRM is reported, and the stream plays through the usual geometry","type":"text"},{"text":" ","type":"text"},{"text":"pipeline; this is the ordinary case for every clear title.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"Decoding the block requires all three of ","type":"text"},{"type":"codeVoice","code":"ekid"},{"text":", ","type":"text"},{"type":"codeVoice","code":"keyManagerUrl"},{"text":", and ","type":"text"},{"type":"codeVoice","code":"drmProvider"},{"text":". A block","type":"text"},{"text":" ","type":"text"},{"text":"that is present but missing any of them is dropped on every signaling version, leaving the","type":"text"},{"text":" ","type":"text"},{"text":"stream playable but reported as clear — so genuinely protected content then fails later at key","type":"text"},{"type":"text","text":" "},{"type":"text","text":"time with an opaque AVFoundation error rather than a DRM-specific one. Validate the block when"},{"type":"text","text":" "},{"type":"text","text":"publishing. v4 logs the dropped block; v2 and v3 discard it silently."}]},{"type":"paragraph","inlineContent":[{"text":"What each version reports today:","type":"text"}]},{"type":"table","header":"row","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Signaling version","type":"text"}]}],[{"inlineContent":[{"type":"codeVoice","code":"drm"},{"type":"text","text":" in the file"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Reported by "},{"type":"codeVoice","code":"drmKeyManager()"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"text":"v2","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Decoded"}]}],[{"inlineContent":[{"type":"text","text":"The key manager"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"v3"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Decoded","type":"text"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"The key manager","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"v4"}]}],[{"type":"paragraph","inlineContent":[{"text":"Decoded","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"The key manager"}],"type":"paragraph"}]]]},{"style":"important","name":"Important","type":"aside","content":[{"inlineContent":[{"type":"text","text":"A signaling model that decodes "},{"type":"codeVoice","code":"drm"},{"text":" but does not implement","type":"text"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SignalingInterface\/drmKeyManager()","type":"reference"},{"text":" inherits the protocol’s default of ","type":"text"},{"code":"nil","type":"codeVoice"},{"type":"text","text":", and"},{"type":"text","text":" "},{"text":"silently reports protected content as clear — nothing fails to compile. ","type":"text"},{"code":"SignalingV4","type":"codeVoice"},{"type":"text","text":" did"},{"text":" ","type":"text"},{"type":"text","text":"exactly that until its accessor was added, so DRM-protected v4 streams were routed to the"},{"type":"text","text":" "},{"text":"geometry pipeline where they cannot decrypt. Any new signaling version must implement that","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"requirement, and "},{"type":"codeVoice","code":"SignalingDrmTests"},{"type":"text","text":" asserts detection through the protocol rather than the"},{"type":"text","text":" "},{"type":"text","text":"concrete type to keep the path covered."}],"type":"paragraph"}]},{"type":"paragraph","inlineContent":[{"text":"Outside the manager, ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/DirectPlayer\/fetchDrmKeyManager(forStreamURL:session:)"},{"type":"text","text":" performs the"},{"type":"text","text":" "},{"type":"text","text":"same lookup standalone: it swaps the stream URL’s extension for "},{"type":"codeVoice","code":".json"},{"text":", decodes the v2 shape,","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"and throws "},{"type":"codeVoice","code":"DirectPlayerDrmError.noDrmInfoInSignaling"},{"type":"text","text":" when no "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" entry is present."}]},{"type":"heading","level":2,"text":"Platform Differences","anchor":"Platform-Differences"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The SDK ships for iOS 17+ and visionOS 26+, and each uses the key-delivery API available to it."},{"type":"text","text":" "},{"type":"text","text":"Both share the same certificate fetch, license exchange, and "},{"type":"codeVoice","code":"DrmProvider"},{"type":"text","text":"."}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"strong"},{"type":"text","text":" uses the classic "},{"type":"codeVoice","code":"skd:\/\/"},{"type":"text","text":" resource-loader flow. "},{"type":"codeVoice","code":"ApplePlayer"},{"type":"text","text":" sets itself as the"},{"type":"text","text":" "},{"type":"text","text":"asset’s "},{"type":"codeVoice","code":"AVAssetResourceLoaderDelegate"},{"type":"text","text":" for every stream, protected or not, and forwards"},{"type":"text","text":" "},{"type":"text","text":"key requests to "},{"type":"codeVoice","code":"DrmManager"},{"type":"text","text":" only when a config was supplied. Without one the request goes"},{"type":"text","text":" "},{"type":"text","text":"unanswered and playback fails."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"inlineContent":[{"type":"text","text":"visionOS"}],"type":"strong"},{"type":"text","text":" has never supported that flow and uses"},{"type":"text","text":" "},{"type":"codeVoice","code":"AVContentKeySession(keySystem: .fairPlayStreaming)"},{"type":"text","text":" with an "},{"type":"codeVoice","code":"AVContentKeySessionDelegate"},{"type":"text","text":"."},{"type":"text","text":" "},{"type":"text","text":"The session is built during "},{"type":"codeVoice","code":"open"},{"type":"text","text":" only when a config is present."}]}]}]},{"type":"aside","style":"note","content":[{"inlineContent":[{"text":"FairPlay needs the Secure Enclave, so it does not work in the visionOS simulator —","type":"text"},{"type":"text","text":" "},{"type":"text","text":"constructing the content key session there raises an uncatchable exception. The SDK detects"},{"type":"text","text":" "},{"type":"text","text":"the simulator, skips the session, and logs instead of trapping, which means protected"},{"type":"text","text":" "},{"type":"text","text":"content will load but not decrypt. Verify DRM on a real Vision Pro."}],"type":"paragraph"}],"name":"Note"},{"type":"heading","level":2,"text":"Failure Modes","anchor":"Failure-Modes"},{"type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Symptom"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Cause","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Protected stream plays black, or stalls at start","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Opened through ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":"; the geometry pipeline has no DRM path","type":"text"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"Content treated as clear despite a ","type":"text"},{"code":"drm","type":"codeVoice"},{"text":" block","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"The block is missing ","type":"text"},{"type":"codeVoice","code":"ekid"},{"type":"text","text":", "},{"type":"codeVoice","code":"keyManagerUrl"},{"type":"text","text":", or "},{"code":"drmProvider","type":"codeVoice"}],"type":"paragraph"}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"License request rejected"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"JWT minting failed; the error is swallowed and an empty "},{"type":"codeVoice","code":"X-AxDRM-Message"},{"type":"text","text":" is sent, so the CKC fetch fails"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"Works on device, fails in the visionOS simulator"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"Expected — FairPlay is unavailable there"}]}]],[[{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"codeVoice","code":"drm"},{"type":"text","text":" block is detected but never honoured"}]}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"The stream is RTMP, played by "},{"type":"codeVoice","code":"LowLatencyPlayer"},{"type":"text","text":", which has no FairPlay path"}]}]]],"header":"row"}]}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/drm"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK