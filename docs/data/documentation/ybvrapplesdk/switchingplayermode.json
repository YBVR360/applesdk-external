er":"s:Sh","kind":"typeIdentifier","text":"Set"},{"kind":"text","text":"<"},{"preciseIdentifier":"s:SS","kind":"typeIdentifier","text":"String"},{"kind":"text","text":">, "},{"preciseIdentifier":"s:s5NeverO","kind":"typeIdentifier","text":"Never"},{"kind":"text","text":">"}],"kind":"symbol","type":"topic","role":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/surfaceRendersSubtitles":{"kind":"symbol","type":"topic","title":"surfaceRendersSubtitles","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/surfacerenderssubtitles","abstract":[],"fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"surfaceRendersSubtitles","kind":"identifier"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"role":"symbol","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersSubtitles"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/schedule(_:)":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","type":"topic","abstract":[],"url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/schedule(_:)","role":"symbol","kind":"symbol","title":"schedule(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"schedule","kind":"identifier"},{"text":"([","kind":"text"},{"text":"YBVRAdBreak","kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK11YBVRAdBreakV"},{"kind":"text","text":"])"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Video/isTimeShiftingAllowed":{"abstract":[],"role":"symbol","type":"topic","fragments":[{"text":"let","kind":"keyword"},{"kind":"text","text":" "},{"kind":"identifier","text":"isTimeShiftingAllowed"},{"kind":"text","text":": "},{"preciseIdentifier":"s:Sb","kind":"typeIdentifier","text":"Bool"},{"kind":"text","text":"?"}],"kind":"symbol","url":"\/documentation\/ybvrapplesdk\/video