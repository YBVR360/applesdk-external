{"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"schemaVersion":{"patch":0,"major":0,"minor":3},"metadata":{"roleHeading":"Article","title":"Switching Player Mode","modules":[{"name":"YBVRAppleSDK"}],"role":"article"},"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","interfaceLanguage":"swift"},"sections":[],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" belongs to the rendering context it was built for. The context is"},{"type":"text","text":" "},{"type":"text","text":"fixed at init through its "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SurfaceContext"},{"type":"text","text":": a Compositor Services layer for the fully"},{"text":" ","type":"text"},{"type":"text","text":"rendered immersive player, a RealityKit entity for "},{"code":"VideoPlayerComponent","type":"codeVoice"},{"text":" content, or no","type":"text"},{"text":" ","type":"text"},{"text":"context at all for the windowed Metal surface behind ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView"},{"type":"text","text":". None of those can"},{"text":" ","type":"text"},{"text":"follow the viewer into a different scene, so letting someone move a video from an immersive","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"space into a window means building a second manager for the new surface."}]},{"inlineContent":[{"type":"text","text":"What that costs you is everything the first manager was holding: the playhead, whether it was"},{"type":"text","text":" "},{"type":"text","text":"playing, the selected camera, the audio and subtitle languages, and which ad breaks have"},{"type":"text","text":" "},{"type":"text","text":"already been seen. The manager cannot carry them across — it is going away — so hold that"},{"text":" ","type":"text"},{"type":"text","text":"state outside it, and put it back once the new manager is streaming. This guide covers the"},{"type":"text","text":" "},{"text":"hand-over; ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true},{"type":"text","text":" is the different case of keeping one manager and changing"},{"text":" ","type":"text"},{"text":"the video underneath it.","type":"text"}],"type":"paragraph"},{"type":"aside","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"The visionOS demo app in "},{"type":"codeVoice","code":"Examples\/visionOS\/DemoApp"},{"type":"text","text":" implements this end to end:"},{"text":" ","type":"text"},{"type":"codeVoice","code":"PlayerCoordinator"},{"text":" drives the swap, ","type":"text"},{"type":"codeVoice","code":"PlaybackSession"},{"text":" holds the session across it,","type":"text"},{"text":" ","type":"text"},{"code":"PlaybackRestorePoint","type":"codeVoice"},{"text":" is the snapshot below, and ","type":"text"},{"code":"WindowPlayerView","type":"codeVoice"},{"text":" hosts the windowed","type":"text"},{"text":" ","type":"text"},{"text":"player. The session types live in ","type":"text"},{"code":"Examples\/common","type":"codeVoice"},{"text":", shared with the iOS demo.","type":"text"}]}],"name":"Note","style":"note"},{"type":"heading","text":"Ending the Old Manager Without Ending the Content","anchor":"Ending-the-Old-Manager-Without-Ending-the-Content","level":2},{"inlineContent":[{"text":"Take the state you need off the old manager, then tear it down with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/stop(notifyEnded:)","isActive":true,"type":"reference"},{"text":". Pass ","type":"text"},{"code":"notifyEnded: false","type":"codeVoice"},{"type":"text","text":" so"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isVideoEnded","isActive":true},{"type":"text","text":" stays quiet — the video"},{"text":" ","type":"text"},{"text":"is not over, and a host that dismisses its player UI on that signal would close the scene you","type":"text"},{"text":" ","type":"text"},{"text":"are about to move into:","type":"text"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["struct SessionState {","    let position: Double","    let isPlaying: Bool","    let cameraId: Int?","    let audioLanguage: String","    let subtitlesLanguage: String","    let playedAdBreakIds: Set<String>","}","","func snapshot(of player: YBVRPlayerManager) -> SessionState {","    SessionState(","        position: player.videoPosition.value,","        isPlaying: player.videoStatus.value != .paused,","        cameraId: player.currentCamera()?.id,","        audioLanguage: player.currentAudioLanguagePublisher.value,","        subtitlesLanguage: player.currentSubtitlesLanguagePublisher.value,","        playedAdBreakIds: player.ads.playedIds.value","    )","}","","pending = snapshot(of: player)","player.stop(notifyEnded: false)"]},{"type":"heading","level":2,"anchor":"Restoring-on-the-New-Manager","text":"Restoring on the New Manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build the new manager with the surface context for the scene you are moving into, then replay"},{"type":"text","text":" "},{"text":"the snapshot once ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","type":"reference"},{"text":" has returned:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: context)","player.ads.markPlayed(pending.playedAdBreakIds)","","try await player.startStream(video: video, signaling)","","if let camera = pending.cameraId.flatMap({ id in player.cameras().first { $0.id == id } }) {","    await player.selectCamera(camera: camera)","}","if pending.position > 0 {","    player.seek(to: CMTimeMakeWithSeconds(pending.position, preferredTimescale: 1000))","}","await player.setAudioLanguage(language: pending.audioLanguage)","await player.setSubtitlesLanguage(language: pending.subtitlesLanguage)","","pending.isPlaying ? player.play() : player.pause()"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Seek once the stream is actually ready — waiting for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/videoStatus"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"report "},{"code":".ready","type":"codeVoice"},{"type":"text","text":" is enough — or the seek lands on an item that has no seekable range yet."}]},{"inlineContent":[{"type":"text","text":"Live content without time shifting cannot be resumed at a position; check"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video\/isTimeShiftingAllowed","type":"reference","isActive":true},{"type":"text","text":" before restoring one, and let the new player join at the live"},{"text":" ","type":"text"},{"text":"edge otherwise.","type":"text"}],"type":"paragraph"},{"text":"Ads Across the Swap","type":"heading","anchor":"Ads-Across-the-Swap","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","isActive":true},{"text":" is the one restore step that has to happen ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"new manager opens its stream, so call it as soon as the manager exists."}]},{"inlineContent":[{"text":"Two things go wrong without it. A pre-roll is armed at position zero on the fresh manager and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"plays again the moment content starts. And the restore seek jumps forward over any mid-roll"},{"type":"text","text":" "},{"type":"text","text":"the viewer has already watched, which is indistinguishable from someone skipping over one —"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek"},{"text":" re-arms it and it plays a second time.","type":"text"},{"text":" ","type":"text"},{"text":"Marking the ids from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","type":"reference"},{"type":"text","text":" drops those breaks from the schedule and"},{"type":"text","text":" "},{"type":"text","text":"takes them out of the catch-up."}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The schedule itself does not survive either: hand the new manager its breaks with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","isActive":true},{"type":"text","text":" the same way you did the first one. Order does not matter —"},{"type":"text","text":" "},{"type":"text","text":"marking before or after scheduling both work, and so does marking before the stream opens."}]},{"type":"heading","text":"Surfaces Draw Different Things","anchor":"Surfaces-Draw-Different-Things","level":2},{"type":"paragraph","inlineContent":[{"text":"Not every surface renders the same overlays, so what your UI has to supply changes with the","type":"text"},{"text":" ","type":"text"},{"text":"mode. Ask the manager rather than assuming:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersSubtitles"},{"type":"text","text":" is "},{"code":"true","type":"codeVoice"},{"type":"text","text":" for the immersive Compositor"},{"type":"text","text":" "},{"type":"text","text":"Services renderer, which burns cues into the video. On the windowed and RealityKit surfaces"},{"text":" ","type":"text"},{"text":"it is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and the cue from ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/currentSubtitleCue","isActive":true,"type":"reference"},{"text":" is yours to place.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersControlRoomMiniScreens","type":"reference"},{"type":"text","text":" says whether"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)","type":"reference"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/hitTestCRMiniScreen(rayDirection:)","type":"reference"},{"type":"text","text":" do anything. Where it is "},{"code":"false","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"build the mini screens from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"},{"type":"text","text":" with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView"},{"type":"text","text":"."}]}]}]},{"text":"Re-binding Your Subscriptions","type":"heading","level":2,"anchor":"Re-binding-Your-Subscriptions"},{"inlineContent":[{"text":"Every publisher you were observing belonged to the old manager. Cancel those subscriptions as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"part of the swap and re-subscribe to the new manager, exactly as you would around a content"},{"type":"text","text":" "},{"type":"text","text":"switch. Anything you cached — the surface controller from"},{"type":"text","text":" "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/getSurfaceController()","type":"reference","isActive":true},{"type":"text","text":", a control room view model, a renderer — has to"},{"type":"text","text":" "},{"text":"be re-read too.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"A counter that increments on every swap makes this easy to drive from SwiftUI: observe it,","type":"text"},{"text":" ","type":"text"},{"text":"and rebuild your bindings whenever it changes.","type":"text"}]}]}],"abstract":[{"text":"Move a playback session between the immersive player and a window without losing the stream.","type":"text"}],"kind":"article","variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/switchingplayermode"]}],"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"anchor":"Guides","generated":true,"title":"Guides"}],"references":{"doc://applesdk.YBVR