{"primaryContentSections":[{"content":[{"type":"heading","text":"Overview","anchor":"Overview","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference","isActive":true},{"type":"text","text":" belongs to the rendering context it was built for. The context is"},{"type":"text","text":" "},{"type":"text","text":"fixed at init through its "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SurfaceContext","type":"reference","isActive":true},{"type":"text","text":": a Compositor Services layer for the fully"},{"type":"text","text":" "},{"type":"text","text":"rendered immersive player, a RealityKit entity for "},{"code":"VideoPlayerComponent","type":"codeVoice"},{"type":"text","text":" content, or no"},{"type":"text","text":" "},{"type":"text","text":"context at all for the windowed Metal surface behind "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","type":"reference","isActive":true},{"type":"text","text":". None of those can"},{"type":"text","text":" "},{"type":"text","text":"follow the viewer into a different scene, so letting someone move a video from an immersive"},{"type":"text","text":" "},{"type":"text","text":"space into a window means building a second manager for the new surface."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"What that costs you is everything the first manager was holding: the playhead, whether it was"},{"type":"text","text":" "},{"type":"text","text":"playing, the selected camera, the audio and subtitle languages, and which ad breaks have"},{"type":"text","text":" "},{"type":"text","text":"already been seen. The manager cannot carry them across — it is going away — so hold that"},{"type":"text","text":" "},{"type":"text","text":"state outside it, and put it back once the new manager is streaming. This guide covers the"},{"text":" ","type":"text"},{"text":"hand-over; ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true,"type":"reference"},{"text":" is the different case of keeping one manager and changing","type":"text"},{"text":" ","type":"text"},{"text":"the video underneath it.","type":"text"}]},{"content":[{"inlineContent":[{"type":"text","text":"The visionOS demo app in "},{"code":"Examples\/visionOS\/DemoApp","type":"codeVoice"},{"type":"text","text":" implements this end to end:"},{"type":"text","text":" "},{"code":"PlayerCoordinator","type":"codeVoice"},{"type":"text","text":" drives the swap, "},{"code":"PlaybackSession","type":"codeVoice"},{"type":"text","text":" holds the session across it,"},{"type":"text","text":" "},{"code":"PlaybackRestorePoint","type":"codeVoice"},{"type":"text","text":" is the snapshot below, and "},{"code":"WindowPlayerView","type":"codeVoice"},{"type":"text","text":" hosts the windowed"},{"type":"text","text":" "},{"type":"text","text":"player. The session types live in "},{"code":"Examples\/common","type":"codeVoice"},{"type":"text","text":", shared with the iOS demo."}],"type":"paragraph"}],"type":"aside","style":"note","name":"Note"},{"type":"heading","level":2,"text":"Ending the Old Manager Without Ending the Content","anchor":"Ending-the-Old-Manager-Without-Ending-the-Content"},{"type":"paragraph","inlineContent":[{"text":"Take the state you need off the old manager, then tear it down with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/stop(notifyEnded:)","type":"reference","isActive":true},{"text":". Pass ","type":"text"},{"code":"notifyEnded: false","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isVideoEnded","type":"reference","isActive":true},{"type":"text","text":" stays quiet — the video"},{"type":"text","text":" "},{"type":"text","text":"is not over, and a host that dismisses its player UI on that signal would close the scene you"},{"type":"text","text":" "},{"type":"text","text":"are about to move into:"}]},{"syntax":"swift","code":["struct SessionState {","    let position: Double","    let isPlaying: Bool","    let cameraId: Int?","    let audioLanguage: String","    let subtitlesLanguage: String","    let playedAdBreakIds: Set<String>","}","","func snapshot(of player: YBVRPlayerManager) -> SessionState {","    SessionState(","        position: player.videoPosition.value,","        isPlaying: player.videoStatus.value != .paused,","        cameraId: player.currentCamera()?.id,","        audioLanguage: player.currentAudioLanguagePublisher.value,","        subtitlesLanguage: player.currentSubtitlesLanguagePublisher.value,","        playedAdBreakIds: player.ads.playedIds.value","    )","}","","pending = snapshot(of: player)","player.stop(notifyEnded: false)"],"type":"codeListing"},{"type":"heading","level":2,"text":"Restoring on the New Manager","anchor":"Restoring-on-the-New-Manager"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Build the new manager with the surface context for the scene you are moving into, then replay"},{"type":"text","text":" "},{"type":"text","text":"the snapshot once "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","isActive":true},{"type":"text","text":" has returned:"}]},{"syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: context)","player.ads.markPlayed(pending.playedAdBreakIds)","","try await player.startStream(video: video, signaling)","","if let camera = pending.cameraId.flatMap({ id in player.cameras().first { $0.id == id } }) {","    await player.selectCamera(camera: camera)","}","if pending.position > 0 {","    player.seek(to: CMTimeMakeWithSeconds(pending.position, preferredTimescale: 1000))","}","await player.setAudioLanguage(language: pending.audioLanguage)","await player.setSubtitlesLanguage(language: pending.subtitlesLanguage)","","pending.isPlaying ? player.play() : player.pause()"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Seek once the stream is actually ready — waiting for "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/videoStatus"},{"type":"text","text":" to"},{"type":"text","text":" "},{"type":"text","text":"report "},{"type":"codeVoice","code":".ready"},{"type":"text","text":" is enough — or the seek lands on an item that has no seekable range yet."}]},{"type":"paragraph","inlineContent":[{"text":"Live content without time shifting cannot be resumed at a position; check","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video\/isTimeShiftingAllowed","type":"reference"},{"text":" before restoring one, and let the new player join at the live","type":"text"},{"text":" ","type":"text"},{"text":"edge otherwise.","type":"text"}]},{"type":"heading","level":2,"text":"Ads Across the Swap","anchor":"Ads-Across-the-Swap"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)"},{"type":"text","text":" is the one restore step that has to happen "},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"type":"text","text":" the"},{"type":"text","text":" "},{"type":"text","text":"new manager opens its stream, so call it as soon as the manager exists."}]},{"type":"paragraph","inlineContent":[{"text":"Two things go wrong without it. A pre-roll is armed at position zero on the fresh manager and","type":"text"},{"text":" ","type":"text"},{"text":"plays again the moment content starts. And the restore seek jumps forward over any mid-roll","type":"text"},{"text":" ","type":"text"},{"text":"the viewer has already watched, which is indistinguishable from someone skipping over one —","type":"text"},{"text":" ","type":"text"},{"text":"so ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","isActive":true},{"text":" re-arms it and it plays a second time.","type":"text"},{"text":" ","type":"text"},{"text":"Marking the ids from ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true},{"text":" drops those breaks from the schedule and","type":"text"},{"text":" ","type":"text"},{"text":"takes them out of the catch-up.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"The schedule itself does not survive either: hand the new manager its breaks with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","type":"reference"},{"text":" the same way you did the first one. Order does not matter —","type":"text"},{"text":" ","type":"text"},{"text":"marking before or after scheduling both work, and so does marking before the stream opens.","type":"text"}]},{"type":"heading","text":"Surfaces Draw Different Things","level":2,"anchor":"Surfaces-Draw-Different-Things"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Not every surface renders the same overlays, so what your UI has to supply changes with the"},{"type":"text","text":" "},{"type":"text","text":"mode. Ask the manager rather than assuming:"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersSubtitles"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"type":"text","text":" for the immersive Compositor"},{"type":"text","text":" "},{"type":"text","text":"Services renderer, which burns cues into the video. On the windowed and RealityKit surfaces"},{"type":"text","text":" "},{"type":"text","text":"it is "},{"code":"false","type":"codeVoice"},{"type":"text","text":", and the cue from "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/currentSubtitleCue","isActive":true},{"type":"text","text":" is yours to place."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersControlRoomMiniScreens"},{"type":"text","text":" says whether"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)"},{"type":"text","text":" and"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/hitTestCRMiniScreen(rayDirection:)"},{"type":"text","text":" do anything. Where it is "},{"code":"false","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"build the mini screens from "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"},{"type":"text","text":" with"},{"type":"text","text":" "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView"},{"type":"text","text":"."}]}]}]},{"level":2,"type":"heading","text":"Re-binding Your Subscriptions","anchor":"Re-binding-Your-Subscriptions"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every publisher you were observing belonged to the old manager. Cancel those subscriptions as"},{"type":"text","text":" "},{"type":"text","text":"part of the swap and re-subscribe to the new manager, exactly as you would around a content"},{"type":"text","text":" "},{"text":"switch. Anything you cached — the surface controller from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/getSurfaceController()","type":"reference"},{"text":", a control room view model, a renderer — has to","type":"text"},{"text":" ","type":"text"},{"text":"be re-read too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A counter that increments on every swap makes this easy to drive from SwiftUI: observe it,","type":"text"},{"text":" ","type":"text"},{"text":"and rebuild your bindings whenever it changes.","type":"text"}]}],"kind":"content"}],"sections":[],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode","interfaceLanguage":"swift"},"abstract":[{"text":"Move a playback session between the immersive player and a window without losing the stream.","type":"text"}],"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article","role":"article","title":"Switching Player Mode"},"kind":"article","hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"schemaVersion":{"major":0,"patch":0,"minor":3},"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"anchor":"Guides"}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/switchingplayermode"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://applesdk.YBVR