{"schemaVersion":{"patch":0,"minor":3,"major":0},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"},"sections":[],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" belongs to the rendering context it was built for. The context is"},{"type":"text","text":" "},{"type":"text","text":"fixed at init through its "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SurfaceContext","isActive":true},{"type":"text","text":": a Compositor Services layer for the fully"},{"type":"text","text":" "},{"type":"text","text":"rendered immersive player, a RealityKit entity for "},{"type":"codeVoice","code":"VideoPlayerComponent"},{"type":"text","text":" content, or no"},{"type":"text","text":" "},{"type":"text","text":"context at all for the windowed Metal surface behind "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","isActive":true},{"type":"text","text":". None of those can"},{"type":"text","text":" "},{"type":"text","text":"follow the viewer into a different scene, so letting someone move a video from an immersive"},{"type":"text","text":" "},{"type":"text","text":"space into a window means building a second manager for the new surface."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"What that costs you is everything the first manager was holding: the playhead, whether it was"},{"type":"text","text":" "},{"type":"text","text":"playing, the selected camera, the audio and subtitle languages, and which ad breaks have"},{"type":"text","text":" "},{"type":"text","text":"already been seen. The manager cannot carry them across — it is going away — so hold that"},{"type":"text","text":" "},{"type":"text","text":"state outside it, and put it back once the new manager is streaming. This guide covers the"},{"type":"text","text":" "},{"type":"text","text":"hand-over; "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","isActive":true},{"type":"text","text":" is the different case of keeping one manager and changing"},{"type":"text","text":" "},{"type":"text","text":"the video underneath it."}],"type":"paragraph"},{"name":"Note","content":[{"type":"paragraph","inlineContent":[{"text":"The visionOS demo app in ","type":"text"},{"code":"Examples\/visionOS\/DemoApp","type":"codeVoice"},{"text":" implements this end to end:","type":"text"},{"text":" ","type":"text"},{"code":"PlayerCoordinator","type":"codeVoice"},{"text":" drives the swap, ","type":"text"},{"code":"PlaybackSession","type":"codeVoice"},{"text":" holds the session across it,","type":"text"},{"text":" ","type":"text"},{"code":"PlaybackRestorePoint","type":"codeVoice"},{"text":" is the snapshot below, and ","type":"text"},{"code":"WindowPlayerView","type":"codeVoice"},{"text":" hosts the windowed","type":"text"},{"text":" ","type":"text"},{"text":"player. The session types live in ","type":"text"},{"code":"Examples\/common","type":"codeVoice"},{"text":", shared with the iOS demo.","type":"text"}]}],"style":"note","type":"aside"},{"level":2,"text":"Ending the Old Manager Without Ending the Content","anchor":"Ending-the-Old-Manager-Without-Ending-the-Content","type":"heading"},{"inlineContent":[{"type":"text","text":"Take the state you need off the old manager, then tear it down with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/stop(notifyEnded:)","isActive":true},{"type":"text","text":". Pass "},{"type":"codeVoice","code":"notifyEnded: false"},{"type":"text","text":" so"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isVideoEnded","isActive":true},{"type":"text","text":" stays quiet — the video"},{"type":"text","text":" "},{"type":"text","text":"is not over, and a host that dismisses its player UI on that signal would close the scene you"},{"type":"text","text":" "},{"type":"text","text":"are about to move into:"}],"type":"paragraph"},{"code":["struct SessionState {","    let position: Double","    let isPlaying: Bool","    let cameraId: Int?","    let audioLanguage: String","    let subtitlesLanguage: String","    let playedAdBreakIds: Set<String>","}","","func snapshot(of player: YBVRPlayerManager) -> SessionState {","    SessionState(","        position: player.videoPosition.value,","        isPlaying: player.videoStatus.value != .paused,","        cameraId: player.currentCamera()?.id,","        audioLanguage: player.currentAudioLanguagePublisher.value,","        subtitlesLanguage: player.currentSubtitlesLanguagePublisher.value,","        playedAdBreakIds: player.ads.playedIds.value","    )","}","","pending = snapshot(of: player)","player.stop(notifyEnded: false)"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Restoring on the New Manager","anchor":"Restoring-on-the-New-Manager","type":"heading"},{"inlineContent":[{"text":"Build the new manager with the surface context for the scene you are moving into, then replay","type":"text"},{"text":" ","type":"text"},{"text":"the snapshot once ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)","type":"reference","isActive":true},{"text":" has returned:","type":"text"}],"type":"paragraph"},{"code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: context)","player.ads.markPlayed(pending.playedAdBreakIds)","","try await player.startStream(video: video, signaling)","","if let camera = pending.cameraId.flatMap({ id in player.cameras().first { $0.id == id } }) {","    await player.selectCamera(camera: camera)","}","if pending.position > 0 {","    player.seek(to: CMTimeMakeWithSeconds(pending.position, preferredTimescale: 1000))","}","await player.setAudioLanguage(language: pending.audioLanguage)","await player.setSubtitlesLanguage(language: pending.subtitlesLanguage)","","pending.isPlaying ? player.play() : player.pause()"],"type":"codeListing","syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"Seek once the stream is actually ready — waiting for ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/videoStatus","type":"reference","isActive":true},{"text":" to","type":"text"},{"text":" ","type":"text"},{"text":"report ","type":"text"},{"type":"codeVoice","code":".ready"},{"text":" is enough — or the seek lands on an item that has no seekable range yet.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Live content without time shifting cannot be resumed at a position; check","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video\/isTimeShiftingAllowed","type":"reference","isActive":true},{"text":" before restoring one, and let the new player join at the live","type":"text"},{"text":" ","type":"text"},{"text":"edge otherwise.","type":"text"}]},{"text":"Ads Across the Swap","anchor":"Ads-Across-the-Swap","type":"heading","level":2},{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)"},{"text":" is the one restore step that has to happen ","type":"text"},{"type":"emphasis","inlineContent":[{"text":"before","type":"text"}]},{"text":" the","type":"text"},{"text":" ","type":"text"},{"text":"new manager opens its stream, so call it as soon as the manager exists.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"Two things go wrong without it. A pre-roll is armed at position zero on the fresh manager and","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"plays again the moment content starts. And the restore seek jumps forward over any mid-roll"},{"type":"text","text":" "},{"type":"text","text":"the viewer has already watched, which is indistinguishable from someone skipping over one —"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","isActive":true},{"text":" re-arms it and it plays a second time.","type":"text"},{"type":"text","text":" "},{"text":"Marking the ids from ","type":"text"},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","isActive":true},{"text":" drops those breaks from the schedule and","type":"text"},{"text":" ","type":"text"},{"text":"takes them out of the catch-up.","type":"text"}],"type":"paragraph"},{"type":"paragraph","inlineContent":[{"text":"The schedule itself does not survive either: hand the new manager its breaks with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","type":"reference","isActive":true},{"text":" the same way you did the first one. Order does not matter —","type":"text"},{"text":" ","type":"text"},{"text":"marking before or after scheduling both work, and so does marking before the stream opens.","type":"text"}]},{"type":"heading","level":2,"anchor":"Surfaces-Draw-Different-Things","text":"Surfaces Draw Different Things"},{"type":"paragraph","inlineContent":[{"text":"Not every surface renders the same overlays, so what your UI has to supply changes with the","type":"text"},{"text":" ","type":"text"},{"text":"mode. Ask the manager rather than assuming:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersSubtitles","type":"reference"},{"text":" is ","type":"text"},{"code":"true","type":"codeVoice"},{"text":" for the immersive Compositor","type":"text"},{"text":" ","type":"text"},{"text":"Services renderer, which burns cues into the video. On the windowed and RealityKit surfaces","type":"text"},{"text":" ","type":"text"},{"text":"it is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":", and the cue from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/currentSubtitleCue","type":"reference"},{"text":" is yours to place.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersControlRoomMiniScreens","type":"reference"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)","type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/hitTestCRMiniScreen(rayDirection:)","type":"reference"},{"text":" do anything. Where it is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"build the mini screens from ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","type":"reference"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView","type":"reference"},{"text":".","type":"text"}]}]}]},{"type":"heading","level":2,"anchor":"Re-binding-Your-Subscriptions","text":"Re-binding Your Subscriptions"},{"type":"paragraph","inlineContent":[{"text":"Every publisher you were observing belonged to the old manager. Cancel those subscriptions as","type":"text"},{"text":" ","type":"text"},{"text":"part of the swap and re-subscribe to the new manager, exactly as you would around a content","type":"text"},{"text":" ","type":"text"},{"text":"switch. Anything you cached — the surface controller from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/getSurfaceController()","type":"reference"},{"text":", a control room view model, a renderer — has to","type":"text"},{"text":" ","type":"text"},{"text":"be re-read too.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"A counter that increments on every swap makes this easy to drive from SwiftUI: observe it,","type":"text"},{"text":" ","type":"text"},{"text":"and rebuild your bindings whenever it changes.","type":"text"}]}],"kind":"content"}],"metadata":{"title":"Switching Player Mode","roleHeading":"Article","role":"article","modules":[{"name":"YBVRAppleSDK"}]},"kind":"article","seeAlsoSections":[{"anchor":"Guides","title":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"generated":true}],"abstract":[{"text":"Move a playback session between the immersive player and a window without losing the stream.","type":"text"}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/switchingplayermode"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://applesdk.YBVR