":"s:s5NeverO"},{"text":">","kind":"text"}],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/currentsubtitlecue","type":"topic","title":"currentSubtitleCue"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/schedule(_:)":{"role":"symbol","abstract":[],"kind":"symbol","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"schedule","kind":"identifier"},{"text":"([","kind":"text"},{"text":"YBVRAdBreak","kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK11YBVRAdBreakV"},{"text":"])","kind":"text"}],"url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/schedule(_:)","type":"topic","title":"schedule(_:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/showCRMiniScreens(_:)":{"role":"symbol","abstract":[],"kind":"symbol","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showCRMiniScreens","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/showcrminiscreens(_:)","type":"topic","title":"showCRMiniScreens(_:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/surfaceRendersControlRoomMiniScreens":{"role":"symbol","abstract":[],"kind":"symbol","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersControlRoomMiniScreens","fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"kind":"identifier","text":"surfaceRendersControlRoomMiniScreens"},{"kind":"text","text":": "},{"kind":"typeIdentifier","text":"Bool","preciseIdentifier":"s:Sb"}],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/