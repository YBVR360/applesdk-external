ypeIdentifier","preciseIdentifier":"s:s5NeverO","text":"Never"},{"kind":"text","text":">"}],"title":"videoStatus","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/videoStatus","kind":"symbol","abstract":[{"type":"text","text":"Current video status. Can be "},{"type":"codeVoice","code":"ready"},{"type":"text","text":", "},{"type":"codeVoice","code":"paused"},{"type":"text","text":" or "},{"type":"codeVoice","code":"buffering"}],"role":"symbol","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/playsMissedMidRollsOnSeek":{"url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/playsmissedmidrollsonseek","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"playsMissedMidRollsOnSeek","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","preciseIdentifier":"s:Sb","kind":"typeIdentifier"}],"title":"playsMissedMidRollsOnSeek","kind":"symbol","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","abstract":[{"type":"text","text":"Whether a mid-roll the playhead jumped over is played on landing. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"role":"symbol","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/surfaceRendersControlRoomMiniScreens":{"title":"surfaceRendersControlRoomMiniScreens","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/surfacerenderscontrolroomminiscreens","abstract":[],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"surfaceRendersControlRoomMiniScreens","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersControlRoomMiniScreens"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/startStream(video:_:)":{"title":"startStream(video:_:)","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/startstream(video:_:)","abstract":[{"type":"text","text":"Opens "},{"type":"codeVoice","code":"video"},{"type":"text","text":" and starts playing it."}],"kind":"symbol","type":"topic","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"startStream","kind":"identifier"},{"text":"(","kind":"text"},{"text":"video","kind":"externalParam"},{"text":": ","kind":"text"},{"text":"Video","preciseIdentifier":"s:12YBVRAppleSDK5VideoV","kind":"typeIdentifier"},{"text":", ","kind":"text"},{"text":"SignalingInterface","preciseIdentifier":"s:12YBVRAppleSDK18SignalingInterfaceP","kind":"typeIdentifier"},{"text":"?) ","kind":"text"},{"text":"async","kind":"keyword"},{"text":" ","kind":"text"},{"text":"throws","kind":"keyword"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/hitTestCRMiniScreen(rayDirection:)":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/hitTestCRMiniScreen(rayDirection:)","type":"topic","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"hitTestCRMiniScreen"},{"kind":"text","text":"("},{"kind":"externalParam","text":"rayDirection"},{"kind":"text","text":": "},{"preciseIdentifier":"c:@T@simd_float3","kind":"typeIdentifier","text":"simd_float3"},{"text":") -> ","kind":"text"},{"preciseIdentifier":"s:Si","kind":"typeIdentifier","text":"Int"},{"text":"?","kind":"text"}],"title":"hitTestCRMiniScreen(rayDirection:)","kind":"symbol","abstract":[{"text":"Only a surface that draws its own mini screens answers - see ","type":"text"},{"type":"codeVoice","code":"surfaceRendersControlRoomMiniScreens"},{"text":".","type":"text"}],"