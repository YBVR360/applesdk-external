{"schemaVersion":{"patch":0,"minor":3,"major":0},"metadata":{"role":"article","modules":[{"name":"YBVRAppleSDK"}],"title":"Switching Player Mode","roleHeading":"Article"},"abstract":[{"text":"Move a playback session between the immersive player and a window without losing the stream.","type":"text"}],"kind":"article","hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SwitchingPlayerMode"},"seeAlsoSections":[{"generated":true,"title":"Guides","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm"],"anchor":"Guides"}],"sections":[],"primaryContentSections":[{"content":[{"level":2,"text":"Overview","anchor":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"A "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","type":"reference","isActive":true},{"type":"text","text":" belongs to the rendering context it was built for. The context is"},{"type":"text","text":" "},{"type":"text","text":"fixed at init through its "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/SurfaceContext","type":"reference","isActive":true},{"type":"text","text":": a Compositor Services layer for the fully"},{"type":"text","text":" "},{"type":"text","text":"rendered immersive player, a RealityKit entity for "},{"type":"codeVoice","code":"VideoPlayerComponent"},{"type":"text","text":" content, or no"},{"type":"text","text":" "},{"type":"text","text":"context at all for the windowed Metal surface behind "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","type":"reference","isActive":true},{"type":"text","text":". None of those can"},{"type":"text","text":" "},{"type":"text","text":"follow the viewer into a different scene, so letting someone move a video from an immersive"},{"type":"text","text":" "},{"type":"text","text":"space into a window means building a second manager for the new surface."}],"type":"paragraph"},{"inlineContent":[{"text":"What that costs you is everything the first manager was holding: the playhead, whether it was","type":"text"},{"text":" ","type":"text"},{"text":"playing, the selected camera, the audio and subtitle languages, and which ad breaks have","type":"text"},{"text":" ","type":"text"},{"text":"already been seen. The manager cannot carry them across — it is going away — so hold that","type":"text"},{"text":" ","type":"text"},{"text":"state outside it, and put it back once the new manager is streaming. This guide covers the","type":"text"},{"text":" ","type":"text"},{"text":"hand-over; ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","type":"reference"},{"text":" is the different case of keeping one manager and changing","type":"text"},{"text":" ","type":"text"},{"text":"the video underneath it.","type":"text"}],"type":"paragraph"},{"anchor":"Ending-the-Old-Manager-Without-Ending-the-Content","type":"heading","level":2,"text":"Ending the Old Manager Without Ending the Content"},{"inlineContent":[{"text":"Take the state you need off the old manager, then tear it down with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/stop(notifyEnded:)","type":"reference"},{"text":". Pass ","type":"text"},{"code":"notifyEnded: false","type":"codeVoice"},{"text":" so","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/isVideoEnded","type":"reference"},{"text":" stays quiet — the video","type":"text"},{"text":" ","type":"text"},{"text":"is not over, and a host that dismisses its player UI on that signal would close the scene you","type":"text"},{"text":" ","type":"text"},{"text":"are about to move into:","type":"text"}],"type":"paragraph"},{"syntax":"swift","code":["struct SessionState {","    let position: Double","    let isPlaying: Bool","    let cameraId: Int?","    let audioLanguage: String","    let subtitlesLanguage: String","    let playedAdBreakIds: Set<String>","}","","func snapshot(of player: YBVRPlayerManager) -> SessionState {","    SessionState(","        position: player.videoPosition.value,","        isPlaying: player.videoStatus.value != .paused,","        cameraId: player.currentCamera()?.id,","        audioLanguage: player.currentAudioLanguagePublisher.value,","        subtitlesLanguage: player.currentSubtitlesLanguagePublisher.value,","        playedAdBreakIds: player.ads.playedIds.value","    )","}","","pending = snapshot(of: player)","player.stop(notifyEnded: false)"],"type":"codeListing"},{"anchor":"Restoring-on-the-New-Manager","type":"heading","level":2,"text":"Restoring on the New Manager"},{"inlineContent":[{"type":"text","text":"Build the new manager with the surface context for the scene you are moving into, then replay"},{"type":"text","text":" "},{"type":"text","text":"the snapshot once "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/startStream(video:_:)"},{"type":"text","text":" has returned:"}],"type":"paragraph"},{"syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: context)","player.ads.markPlayed(pending.playedAdBreakIds)","","try await player.startStream(video: video, signaling)","","if let camera = pending.cameraId.flatMap({ id in player.cameras().first { $0.id == id } }) {","    await player.selectCamera(camera: camera)","}","if pending.position > 0 {","    player.seek(to: CMTimeMakeWithSeconds(pending.position, preferredTimescale: 1000))","}","await player.setAudioLanguage(language: pending.audioLanguage)","await player.setSubtitlesLanguage(language: pending.subtitlesLanguage)","","pending.isPlaying ? player.play() : player.pause()"],"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Seek once the stream is actually ready — waiting for "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/videoStatus","type":"reference"},{"type":"text","text":" to"},{"text":" ","type":"text"},{"type":"text","text":"report "},{"type":"codeVoice","code":".ready"},{"type":"text","text":" is enough — or the seek lands on an item that has no seekable range yet."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"Live content without time shifting cannot be resumed at a position; check"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video\/isTimeShiftingAllowed"},{"text":" before restoring one, and let the new player join at the live","type":"text"},{"type":"text","text":" "},{"text":"edge otherwise.","type":"text"}],"type":"paragraph"},{"type":"heading","level":2,"text":"Ads Across the Swap","anchor":"Ads-Across-the-Swap"},{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","isActive":true,"type":"reference"},{"type":"text","text":" is the one restore step that has to happen "},{"inlineContent":[{"text":"before","type":"text"}],"type":"emphasis"},{"text":" the","type":"text"},{"type":"text","text":" "},{"text":"new manager opens its stream, so call it as soon as the manager exists.","type":"text"}]},{"inlineContent":[{"type":"text","text":"Two things go wrong without it. A pre-roll is armed at position zero on the fresh manager and"},{"type":"text","text":" "},{"type":"text","text":"plays again the moment content starts. And the restore seek jumps forward over any mid-roll"},{"type":"text","text":" "},{"type":"text","text":"the viewer has already watched, which is indistinguishable from someone skipping over one —"},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek"},{"type":"text","text":" re-arms it and it plays a second time."},{"type":"text","text":" "},{"type":"text","text":"Marking the ids from "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds"},{"type":"text","text":" drops those breaks from the schedule and"},{"type":"text","text":" "},{"type":"text","text":"takes them out of the catch-up."}],"type":"paragraph"},{"inlineContent":[{"type":"text","text":"The schedule itself does not survive either: hand the new manager its breaks with"},{"type":"text","text":" "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/schedule(_:)"},{"type":"text","text":" the same way you did the first one. Order does not matter —"},{"type":"text","text":" "},{"type":"text","text":"marking before or after scheduling both work, and so does marking before the stream opens."}],"type":"paragraph"},{"level":2,"anchor":"Surfaces-Draw-Different-Things","text":"Surfaces Draw Different Things","type":"heading"},{"inlineContent":[{"text":"Not every surface renders the same overlays, so what your UI has to supply changes with the","type":"text"},{"text":" ","type":"text"},{"text":"mode. Ask the manager rather than assuming:","type":"text"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"text":"No surface draws subtitles: the cue from ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/currentSubtitleCue","isActive":true,"type":"reference"},{"text":" is always","type":"text"},{"text":" ","type":"text"},{"text":"yours to place. In the immersive Compositor Services renderer, where no window can go, draw","type":"text"},{"text":" ","type":"text"},{"text":"it into the video with an ","type":"text"},{"code":"ImmersiveOverlayRenderer","type":"codeVoice"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersControlRoomMiniScreens","isActive":true,"type":"reference"},{"text":" says whether","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)","isActive":true,"type":"reference"},{"text":" and","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/hitTestCRMiniScreen(rayDirection:)","isActive":true,"type":"reference"},{"text":" do anything. Where it is ","type":"text"},{"code":"false","type":"codeVoice"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"build the mini screens from ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()","isActive":true,"type":"reference"},{"text":" with","type":"text"},{"text":" ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView","isActive":true,"type":"reference"},{"text":".","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"},{"level":2,"anchor":"Re-binding-Your-Subscriptions","text":"Re-binding Your Subscriptions","type":"heading"},{"inlineContent":[{"text":"Every publisher you were observing belonged to the old manager. Cancel those subscriptions as","type":"text"},{"text":" ","type":"text"},{"text":"part of the swap and re-subscribe to the new manager, exactly as you would around a content","type":"text"},{"text":" ","type":"text"},{"text":"switch. Anything you cached — the surface controller from","type":"text"},{"text":" ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/getSurfaceController()","type":"reference"},{"text":", a control room view model, a renderer — has to","type":"text"},{"text":" ","type":"text"},{"text":"be re-read too.","type":"text"}],"type":"paragraph"},{"inlineContent":[{"text":"A counter that increments on every swap makes this easy to drive from SwiftUI: observe it,","type":"text"},{"text":" ","type":"text"},{"text":"and rebuild your bindings whenever it changes.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/switchingplayermode"],"traits":[{"interfaceLanguage":"swift"}]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/GeometryVideoView":{"url":"\/documentation\/ybvrapplesdk\/geometryvideoview","type":"topic","kind":"symbol","title":"GeometryVideoView","role":"symbol","fragments":[{"kind":"keyword","text":"struct"},{"kind":"text","text":" "},{"kind":"identifier","text":"GeometryVideoView"}],"navigatorTitle":[{"kind":"identifier","text":"GeometryVideoView"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/GeometryVideoView","abstract":[]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/markPlayed(_:)":{"fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"markPlayed"},{"kind":"text","text":"("},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"text":"String","kind":"typeIdentifier","preciseIdentifier":"s:SS"},{"text":">)","kind":"text"}],"kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/markplayed(_:)","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/markPlayed(_:)","role":"symbol","title":"markPlayed(_:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"url":"\/documentation\/ybvrapplesdk","type":"topic","kind":"symbol","title":"YBVRAppleSDK","role":"collection","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","abstract":[{"text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS.","type":"text"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/Drm":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Drm","abstract":[{"type":"text","text":"Where encrypted content plays, where it cannot, and how the SDK decides which it is."}],"kind":"article","type":"topic","title":"FairPlay DRM","role":"article","url":"\/documentation\/ybvrapplesdk\/drm"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/ControlRoomView":{"type":"topic","url":"\/documentation\/ybvrapplesdk\/controlroomview","kind":"symbol","title":"ControlRoomView","role":"symbol","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"kind":"identifier","text":"ControlRoomView"}],"navigatorTitle":[{"text":"ControlRoomView","kind":"identifier"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView","abstract":[]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/playsMissedMidRollsOnSeek":{"fragments":[{"kind":"keyword","text":"var"},{"kind":"text","text":" "},{"text":"playsMissedMidRollsOnSeek","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"kind":"symbol","abstract":[{"type":"text","text":"Whether a mid-roll the playhead jumped over is played on landing. Defaults to "},{"type":"codeVoice","code":"true"},{"type":"text","text":"."}],"type":"topic","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/playsmissedmidrollsonseek","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playsMissedMidRollsOnSeek","role":"symbol","title":"playsMissedMidRollsOnSeek"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/playedIds":{"fragments":[{"text":"let","kind":"keyword"},{"text":" ","kind":"text"},{"text":"playedIds","kind":"identifier"},{"text":": ","kind":"text"},{"text":"CurrentValueSubject","kind":"typeIdentifier","preciseIdentifier":"s:7Combine19CurrentValueSubjectC"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"text":"<","kind":"text"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"Never","preciseIdentifier":"s:s5NeverO"},{"kind":"text","text":">"}],"kind":"symbol","abstract":[],"type":"topic","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/playedids","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","role":"symbol","title":"playedIds"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/getSurfaceController()":{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/getSurfaceController()","abstract":[],"kind":"symbol","title":"getSurfaceController()","type":"topic","role":"symbol","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/getsurfacecontroller()","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getSurfaceController","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"IOSSurfaceController","kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK20IOSSurfaceControllerC"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager":{"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager","type":"topic","kind":"symbol","role":"symbol","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","abstract":[{"type":"text","text":