xt":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"schedule"},{"kind":"text","text":"(["},{"preciseIdentifier":"s:12YBVRAppleSDK11YBVRAdBreakV","kind":"typeIdentifier","text":"YBVRAdBreak"},{"kind":"text","text":"])"}],"title":"schedule(_:)"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRAdController/playedIds":{"role":"symbol","url":"\/documentation\/ybvrapplesdk\/ybvradcontroller\/playedids","kind":"symbol","abstract":[],"type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAdController\/playedIds","fragments":[{"kind":"keyword","text":"let"},{"kind":"text","text":" "},{"kind":"identifier","text":"playedIds"},{"kind":"text","text":": "},{"preciseIdentifier":"s:7Combine19CurrentValueSubjectC","kind":"typeIdentifier","text":"CurrentValueSubject"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"Set","preciseIdentifier":"s:Sh"},{"kind":"text","text":"<"},{"kind":"typeIdentifier","text":"String","preciseIdentifier":"s:SS"},{"kind":"text","text":">, "},{"kind":"typeIdentifier","text":"Never","preciseIdentifier":"s:s5NeverO"},{"kind":"text","text":">"}],"title":"playedIds"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/surfaceRendersSubtitles":{"abstract":[],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/surfacerenderssubtitles","role":"symbol","fragments":[{"text":"var","kind":"keyword"},{"text":" ","kind":"text"},{"text":"surfaceRendersSubtitles","kind":"identifier"},{"text":": ","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"}],"type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/surfaceRendersSubtitles","kind":"symbol","title":"surfaceRendersSubtitles"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/getSurfaceController()":{"abstract":[],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/getsurfacecontroller()","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"getSurfaceController","kind":"identifier"},{"text":"() -> ","kind":"text"},{"text":"IOSSurfaceController","kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK20IOSSurfaceControllerC"}],"type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/getSurfaceController()","kind":"symbol","title":"getSurfaceController()"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/showCRMiniScreens(_:)":{"kind":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"showCRMiniScreens","kind":"identifier"},{"text":"(","kind":"text"},{"text":"Bool","kind":"typeIdentifier","preciseIdentifier":"s:Sb"},{"text":")","kind":"text"}],"role":"symbol","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/showcrminiscreens(_:)","title":"showCRMiniScreens(_:)","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/showCRMiniScreens(_:)","abstract":[],"type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/ControlRoomView":{"role":"symbol","abstract":[],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ControlRoomView","navigatorTitle":[{"text":"ControlRoomView","kind":"identifier"}],"url":"\/documentation\/ybvrapplesdk\/controlroomview","fragments":[{"text":"struct","kind":"keyword"},{"text":" ","kind":"text"},{"text":"ControlRoomView","kind":"identifier"}],"title":"ControlRoomView","kind":"symbol","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/stop(notifyEnded:)":{"abstract":[{"type":"text","text":"Teardown the player"}],"url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/stop(notifyended:)","role":"symbol","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"stop","kind":"identifier"},{"text":"(","kind":"text"},{"text":"notifyEnded","kind":"exte