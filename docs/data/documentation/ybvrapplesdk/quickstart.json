{"sections":[],"abstract":[{"text":"Get up and running with YBVR video playback in your iOS or VisionOS app.","type":"text"}],"schemaVersion":{"patch":0,"minor":3,"major":0},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"kind":"article","primaryContentSections":[{"kind":"content","content":[{"level":2,"text":"Overview","type":"heading","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide walks through the minimum steps to load the SDK configuration, create a player, and start streaming a 360° video. Follow the iOS section for a standard SwiftUI app, or the VisionOS section for an immersive spatial experience.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"If you have not added the SDK to your project yet, start with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},{"text":".","type":"text"}]},{"level":2,"type":"heading","text":"Step 1 — Load the App Configuration","anchor":"Step-1-Load-the-App-Configuration"},{"type":"paragraph","inlineContent":[{"text":"Before creating a player, fetch your app’s remote configuration using ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader"},{"text":". This is an async call — do it once at app launch and store the result.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wire it into your SwiftUI entry point:"}]},{"code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"],"syntax":"swift","type":"codeListing"},{"style":"tip","content":[{"type":"paragraph","inlineContent":[{"text":"Use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development"},{"text":" or ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test"},{"type":"text","text":" during integration to target non-production backends."}]}],"type":"aside","name":"Tip"},{"level":2,"text":"Step 2 — Create a Player","type":"heading","anchor":"Step-2-Create-a-Player"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Instantiate "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" once you have the configuration. Always use ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig"},{"type":"text","text":" unless you have specific requirements."}]},{"level":3,"text":"iOS","type":"heading","anchor":"iOS"},{"type":"paragraph","inlineContent":[{"text":"On iOS no surface context is needed — the SDK manages rendering internally.","type":"text"}]},{"code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"type":"codeListing","syntax":"swift"},{"level":3,"text":"VisionOS — Flat Window","anchor":"VisionOS-Flat-Window","type":"heading"},{"inlineContent":[{"type":"text","text":"For standard 2D window playback on VisionOS, use "},{"type":"codeVoice","code":"surfaceContext: nil"},{"type":"text","text":" just like iOS:"}],"type":"paragraph"},{"type":"codeListing","syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"]},{"level":3,"type":"heading","text":"VisionOS — Immersive (CompositorLayer)","anchor":"VisionOS-Immersive-CompositorLayer"},{"type":"paragraph","inlineContent":[{"text":"For a fully immersive experience, create a ","type":"text"},{"code":"VisionSurfaceContext","type":"codeVoice"},{"text":" from the ","type":"text"},{"code":"LayerRenderer","type":"codeVoice"},{"text":" provided by ","type":"text"},{"code":"CompositorLayer","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"]},{"level":3,"type":"heading","text":"VisionOS — Immersive (RealityKit \/ APMP)","anchor":"VisionOS-Immersive-RealityKit--APMP"},{"type":"paragraph","inlineContent":[{"text":"For RealityKit-based spatial playback, attach the context to a RealityKit ","type":"text"},{"code":"Entity","type":"codeVoice"},{"text":":","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"]},{"level":2,"type":"heading","text":"Step 3 — Set Up Analytics (Optional)","anchor":"Step-3-Set-Up-Analytics-Optional"},{"type":"paragraph","inlineContent":[{"text":"If your ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration","type":"reference","isActive":true},{"text":" includes analytics, attach a ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker","type":"reference","isActive":true},{"text":" to the player right after creation:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"]},{"level":2,"type":"heading","text":"Step 4 — Start Streaming","anchor":"Step-4-Start-Streaming"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"code":"startStream(video:_:)","type":"codeVoice"},{"text":" with the ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video","type":"reference","isActive":true},{"text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling ","type":"text"},{"code":"startStream","type":"codeVoice"},{"text":" speeds up player initialization by avoiding network request inside the SDK.","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["player.getRenderer()?.startRenderLoop()"]},{"level":2,"type":"heading","text":"Step 5 — Embed the Player View","anchor":"Step-5-Embed-the-Player-View"},{"level":3,"type":"heading","text":"iOS and VisionOS Flat — GeometryVideoView","anchor":"iOS-and-VisionOS-Flat-GeometryVideoView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap "},{"type":"codeVoice","code":"GeometryVideoView"},{"type":"text","text":" in a "},{"type":"codeVoice","code":"GeometryReader"},{"type":"text","text":" to maintain the correct aspect ratio:"}]},{"syntax":"swift","type":"codeListing","code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"]},{"level":3,"type":"heading","text":"VisionOS — RealityView (APMP)","anchor":"VisionOS-RealityView-APMP"},{"type":"codeListing","syntax":"swift","code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"]},{"level":3,"type":"heading","text":"VisionOS — CompositorLayer","anchor":"VisionOS-CompositorLayer"},{"type":"codeListing","code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"],"syntax":"swift"},{"level":2,"type":"heading","text":"Step 6 — Observe Player State","anchor":"Step-6-Observe-Player-State"},{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"type":"text","text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use "},{"code":"[weak self]","type":"codeVoice"},{"type":"text","text":" captures."}]},{"type":"codeListing","code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Step-7-Multi-Audio-and-Subtitles","text":"Step 7 — Multi-Audio and Subtitles"},{"inlineContent":[{"type":"text","text":"Retrieve available languages from the player and filter them per active camera for control room streams:"}],"type":"paragraph"},{"type":"codeListing","code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"],"syntax":"swift"},{"type":"heading","level":2,"anchor":"Step-8-Handle-Errors","text":"Step 8 — Handle Errors"},{"type":"paragraph","inlineContent":[{"text":"Errors thrown by ","type":"text"},{"code":"startStream(video:_:)","type":"codeVoice"},{"text":" cover setup failures: a signaling file that cannot be","type":"text"},{"type":"text","text":" "},{"text":"fetched or decoded, signaling that offers no camera to play (","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera","type":"reference","isActive":true},{"type":"text","text":"),"},{"type":"text","text":" "},{"type":"text","text":"and a stream that cannot be opened. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"text","text":"the same signaling errors when you pre-fetch. "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError"},{"type":"text","text":" conforms to "},{"code":"LocalizedError","type":"codeVoice"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so "},{"code":"localizedDescription","type":"codeVoice"},{"type":"text","text":" is fit to show."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once playback is under way, failures arrive on "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true},{"type":"text","text":":"}]},{"code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in self?.loadFailure = error.localizedDescription }","    .store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"anchor":"Next-Steps","type":"heading","text":"Next Steps","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching"},{"text":" — move a live player to another video with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)"},{"text":" instead of rebuilding it, and chain items with","type":"text"},{"text":" ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd"},{"text":".","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion"},{"text":" — schedule ad breaks through ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads"},{"text":" and drive your own ad UI.","type":"text"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Handle control room camera switching via ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"Recenter the camera with ","type":"text"},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/recenterCameraPosition()"}]}]}],"type":"unorderedList"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"},"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"],"title":"Getting Started","generated":true,"a