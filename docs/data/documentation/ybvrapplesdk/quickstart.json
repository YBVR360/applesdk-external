11VideoConfigV","text":"VideoConfig","kind":"typeIdentifier"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/fetchSignalingFile(video:)":{"role":"symbol","kind":"symbol","title":"fetchSignalingFile(video:)","url":"\/documentation\/ybvrapplesdk\/ybvrplayermanager\/fetchsignalingfile(video:)","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)","abstract":[{"text":"Fetches and decodes ","type":"text"},{"code":"video","type":"codeVoice"},{"text":"’s signaling file, and keeps it on this manager for the next","type":"text"},{"text":" ","type":"text"},{"code":"startStream(video:_:)","type":"codeVoice"},{"text":".","type":"text"}],"type":"topic","fragments":[{"text":"func","kind":"keyword"},{"text":" ","kind":"text"},{"text":"fetchSignalingFile","kind":"identifier"},{"text":"(","kind":"text"},{"text":"video","kind":"externalParam"},{"text":": ","kind":"text"},{"preciseIdentifier":"s:12YBVRAppleSDK5VideoV","text":"Video","kind":"typeIdentifier"},{"text":") ","kind":"text"},{"text":"async","kind":"keyword"},{"kind":"text","text":" "},{"kind":"keyword","text":"throws"},{"kind":"text","text":" -> "},{"preciseIdentifier":"s:12YBVRAppleSDK18SignalingInterfaceP","kind":"typeIdentifier","text":"SignalingInterface"},{"kind":"text","text":"?"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/YBVRPlayerManager/controlRoomSelectorViewModel()":{"kind":"symbol","abstract":[],"title":"controlRoomSelectorViewModel()","fragments":[{"kind":"keyword","text":"func"},{"kind":"text","text":" "},{"kind":"identifier","text":"controlRoomSelectorViewModel"},{"kind":"text","text":"() -> "},{"kind":"typeIdentifier","preciseIdentifier":"s:12YBVRAppleSDK28ControlRoomSelectorViewModelC","text":"ControlRoomSelectorViewModel"},{"kind":"text","text":"?"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/do