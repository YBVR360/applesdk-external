{"metadata":{"role":"article","roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}],"title":"Quick Start"},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"sections":[],"abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"seeAlsoSections":[{"title":"Getting Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"],"generated":true,"anchor":"Getting-Started"}],"primaryContentSections":[{"content":[{"type":"heading","level":2,"anchor":"Overview","text":"Overview"},{"type":"paragraph","inlineContent":[{"text":"This guide walks through the minimum steps to load the SDK configuration, create a player, and start streaming a 360° video. Follow the iOS section for a standard SwiftUI app, or the VisionOS section for an immersive spatial experience.","type":"text"}]},{"inlineContent":[{"text":"If you have not added the SDK to your project yet, start with ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation","type":"reference"},{"text":".","type":"text"}],"type":"paragraph"},{"text":"Step 1 — Load the App Configuration","anchor":"Step-1-Load-the-App-Configuration","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Before creating a player, fetch your app’s remote configuration using "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfigurationLoader"},{"type":"text","text":". This is an async call — do it once at app launch and store the result."}]},{"syntax":"swift","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"],"type":"codeListing"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wire it into your SwiftUI entry point:"}]},{"type":"codeListing","code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"],"syntax":"swift"},{"type":"aside","name":"Tip","style":"tip","content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test","type":"reference","isActive":true},{"type":"text","text":" during integration to target non-production backends."}]}]},{"type":"heading","level":2,"text":"Step 2 — Create a Player","anchor":"Step-2-Create-a-Player"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Instantiate "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" once you have the configuration. Always use "},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig","type":"reference"},{"type":"text","text":" unless you have specific requirements."}]},{"anchor":"iOS","type":"heading","level":3,"text":"iOS"},{"type":"paragraph","inlineContent":[{"type":"text","text":"On iOS no surface context is needed — the SDK manages rendering internally."}]},{"code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"type":"codeListing","syntax":"swift"},{"text":"VisionOS — Flat Window","anchor":"VisionOS-Flat-Window","type":"heading","level":3},{"type":"paragraph","inlineContent":[{"text":"For standard 2D window playback on VisionOS, use ","type":"text"},{"code":"surfaceContext: nil","type":"codeVoice"},{"text":" just like iOS:","type":"text"}]},{"syntax":"swift","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"],"type":"codeListing"},{"type":"heading","level":3,"text":"VisionOS — Immersive (CompositorLayer)","anchor":"VisionOS-Immersive-CompositorLayer"},{"inlineContent":[{"text":"For a fully immersive experience, create a ","type":"text"},{"code":"VisionSurfaceContext","type":"codeVoice"},{"text":" from the ","type":"text"},{"code":"LayerRenderer","type":"codeVoice"},{"text":" provided by ","type":"text"},{"code":"CompositorLayer","type":"codeVoice"},{"text":":","type":"text"}],"type":"paragraph"},{"type":"codeListing","code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift"},{"anchor":"VisionOS-Immersive-RealityKit--APMP","level":3,"type":"heading","text":"VisionOS — Immersive (RealityKit \/ APMP)"},{"inlineContent":[{"text":"For RealityKit-based spatial playback, attach the context to a RealityKit ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":":","type":"text"}],"type":"paragraph"},{"code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Step 3 — Set Up Analytics (Optional)","anchor":"Step-3-Set-Up-Analytics-Optional","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"If your "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration","isActive":true},{"type":"text","text":" includes analytics, attach a "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker","isActive":true},{"type":"text","text":" to the player right after creation:"}]},{"code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"],"syntax":"swift","type":"codeListing"},{"level":2,"text":"Step 4 — Start Streaming","anchor":"Step-4-Start-Streaming","type":"heading"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Call "},{"type":"codeVoice","code":"startStream(video:_:)"},{"type":"text","text":" with the "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video"},{"text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling ","type":"text"},{"type":"codeVoice","code":"startStream"},{"text":" speeds up player initialization by avoiding network request inside the SDK.","type":"text"}]},{"code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:"}],"type":"paragraph"},{"code":["player.getRenderer()?.startRenderLoop()"],"type":"codeListing","syntax":"swift"},{"type":"heading","level":2,"anchor":"Step-5-Embed-the-Player-View","text":"Step 5 — Embed the Player View"},{"type":"heading","text":"iOS and VisionOS Flat — GeometryVideoView","level":3,"anchor":"iOS-and-VisionOS-Flat-GeometryVideoView"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Wrap "},{"type":"codeVoice","code":"GeometryVideoView"},{"type":"text","text":" in a "},{"code":"GeometryReader","type":"codeVoice"},{"type":"text","text":" to maintain the correct aspect ratio:"}]},{"type":"codeListing","syntax":"swift","code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"]},{"anchor":"VisionOS-RealityView-APMP","type":"heading","level":3,"text":"VisionOS — RealityView (APMP)"},{"code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"],"type":"codeListing","syntax":"swift"},{"anchor":"VisionOS-CompositorLayer","type":"heading","text":"VisionOS — CompositorLayer","level":3},{"code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-6-Observe-Player-State","type":"heading","text":"Step 6 — Observe Player State","level":2},{"type":"paragraph","inlineContent":[{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager","isActive":true},{"type":"text","text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use "},{"type":"codeVoice","code":"[weak self]"},{"type":"text","text":" captures."}]},{"code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"],"type":"codeListing","syntax":"swift"},{"anchor":"Step-7-Multi-Audio-and-Subtitles","type":"heading","text":"Step 7 — Multi-Audio and Subtitles","level":2},{"type":"paragraph","inlineContent":[{"text":"Retrieve available languages from the player and filter them per active camera for control room streams:","type":"text"}]},{"code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"],"type":"codeListing","syntax":"swift"},{"level":2,"type":"heading","text":"Step 8 — Handle Errors","anchor":"Step-8-Handle-Errors"},{"type":"paragraph","inlineContent":[{"text":"Errors thrown by ","type":"text"},{"type":"codeVoice","code":"startStream(video:_:)"},{"text":" cover setup failures: a signaling file that cannot be","type":"text"},{"text":" ","type":"text"},{"text":"fetched or decoded, signaling that offers no camera to play (","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera","type":"reference","isActive":true},{"text":"),","type":"text"},{"type":"text","text":" "},{"type":"text","text":"and a stream that cannot be opened. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)"},{"type":"text","text":" throws"},{"type":"text","text":" "},{"type":"text","text":"the same signaling errors when you pre-fetch. "},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError"},{"type":"text","text":" conforms to "},{"type":"codeVoice","code":"LocalizedError"},{"type":"text","text":","},{"type":"text","text":" "},{"type":"text","text":"so "},{"type":"codeVoice","code":"localizedDescription"},{"type":"text","text":" is fit to show."}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Once playback is under way, failures arrive on "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/playbackError","isActive":true},{"type":"text","text":":"}]},{"code":["player.playbackError","    .receive(on: DispatchQueue.main)","    .sink { [weak self] error in self?.loadFailure = error.localizedDescription }","    .store(in: &cancellables)"],"type":"codeListing","syntax":"swift"},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/ContentSwitching","type":"reference","isActive":true},{"text":" — move a live player to another video with","type":"text"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/switchContent(to:_:)","isActive":true},{"type":"text","text":" instead of rebuilding it, and chain items with"},{"type":"text","text":" "},{"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/itemDidEnd","isActive":true},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/AdInsertion","type":"reference"},{"text":" — schedule ad breaks through ","type":"text"},{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/ads","type":"reference"},{"text":" and drive your own ad UI.","type":"text"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Handle control room camera switching via "},{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/controlRoomSelectorViewModel()"}]}]},{"content":[{"inlineContent":[{"text":"Recenter the camera with ","type":"text"},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/recenterCameraPosition()","type":"reference","isActive":true}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"schemaVersion":{"minor":3,"patch":0,"major":0},