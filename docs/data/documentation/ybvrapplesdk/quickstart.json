type":"codeListing","code":["import YBVRAppleSDK","","@Observable","final class AppManager {","    private(set) var appConfiguration: YBVRAppConfiguration?","","    func initialize(appName: String, languageCode: String = \"en\") async {","        do {","            appConfiguration = try await YBVRAppConfigurationLoader().load(","                appName: appName,","                sdkBuildNumber: SdkBuildNumber,","                deviceId: DeviceInfo.shared.getDeviceID(),","                platform: AppPlatform.current,","                xmsEnvironment: .production,","                languageCode: languageCode,","                deviceName: UIDevice.current.name","            )","        } catch {","            print(\"Configuration load failed: \\(error)\")","        }","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"Wire it into your SwiftUI entry point:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["@main","struct MyApp: App {","    @State private var appManager = AppManager()","","    var body: some Scene {","        WindowGroup {","            ContentView()","                .environment(appManager)","                .task { await appManager.initialize(appName: \"your-app-name\") }","        }","    }","}"]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Use "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/development","type":"reference","isActive":true},{"type":"text","text":" or "},{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/XmsEnvironment\/test","type":"reference","isActive":true},{"type":"text","text":" during integration to target non-production backends."}]}],"type":"aside","style":"tip","name":"Tip"},{"level":2,"anchor":"Step-2-Create-a-Player","type":"heading","text":"Step 2 — Create a Player"},{"type":"paragraph","inlineContent":[{"text":"Instantiate ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" once you have the configuration. Always use ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/VideoConfig\/defaultConfig"},{"text":" unless you have specific requirements.","type":"text"}]},{"level":3,"anchor":"iOS","type":"heading","text":"iOS"},{"type":"paragraph","inlineContent":[{"text":"On iOS no surface context is needed — the SDK manages rendering internally.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"]},{"level":3,"anchor":"VisionOS-Flat-Window","type":"heading","text":"VisionOS — Flat Window"},{"type":"paragraph","inlineContent":[{"text":"For standard 2D window playback on VisionOS, use ","type":"text"},{"type":"codeVoice","code":"surfaceContext: nil"},{"text":" just like iOS:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["let player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: nil)"]},{"level":3,"anchor":"VisionOS-Immersive-CompositorLayer","type":"heading","text":"VisionOS — Immersive (CompositorLayer)"},{"type":"paragraph","inlineContent":[{"text":"For a fully immersive experience, create a ","type":"text"},{"type":"codeVoice","code":"VisionSurfaceContext"},{"text":" from the ","type":"text"},{"type":"codeVoice","code":"LayerRenderer"},{"text":" provided by ","type":"text"},{"type":"codeVoice","code":"CompositorLayer"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import CompositorServices","","func preparePlayer(layerRenderer: LayerRenderer) {","    let surfaceContext = VisionSurfaceContext(layerRenderer: layerRenderer)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"]},{"level":3,"anchor":"VisionOS-Immersive-RealityKit--APMP","type":"heading","text":"VisionOS — Immersive (RealityKit \/ APMP)"},{"type":"paragraph","inlineContent":[{"text":"For RealityKit-based spatial playback, attach the context to a RealityKit ","type":"text"},{"type":"codeVoice","code":"Entity"},{"text":":","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import RealityKit","","func preparePlayer(entity: Entity) {","    let surfaceContext = VideoPlayerComponentSurfaceContext(entity: entity)","    player = YBVRPlayerManager(videoConfig: .defaultConfig, surfaceContext: surfaceContext)","}"]},{"level":2,"anchor":"Step-3-Set-Up-Analytics-Optional","type":"heading","text":"Step 3 — Set Up Analytics (Optional)"},{"type":"paragraph","inlineContent":[{"text":"If your ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRAppConfiguration"},{"text":" includes analytics, attach a ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Tracker"},{"text":" to the player right after creation:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func attachAnalytics(to player: YBVRPlayerManager, appName: String) async {","    guard let analyticsConfig = appConfiguration?.config.analyticsConfig else { return }","","    let tracker = Tracker(config: analyticsConfig, appName: appName)","    await tracker.setClient(TrackerClient(config: analyticsConfig))","    player.setAnalytics(analytics: tracker)","}"]},{"level":2,"anchor":"Step-4-Start-Streaming","type":"heading","text":"Step 4 — Start Streaming"},{"type":"paragraph","inlineContent":[{"text":"Call ","type":"text"},{"type":"codeVoice","code":"startStream(video:_:)"},{"text":" with the ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Video"},{"text":" object you want to play. The signaling parameter is optional, but pre-fetching it before calling ","type":"text"},{"type":"codeVoice","code":"startStream"},{"text":" speeds up player initialization by avoiding network request inside the SDK.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["func startStream(video: Video) async {","    do {","        let signaling = try await player.fetchSignalingFile(video: video)","        try await player.startStream(video: video, signaling)","    } catch {","        print(\"Stream failed: \\(error)\")","    }","}"]},{"type":"paragraph","inlineContent":[{"text":"On VisionOS immersive modes (CompositorLayer \/ RealityKit), also start the render loop after the stream begins:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["player.getRenderer()?.startRenderLoop()"]},{"level":2,"anchor":"Step-5-Embed-the-Player-View","type":"heading","text":"Step 5 — Embed the Player View"},{"level":3,"anchor":"iOS-and-VisionOS-Flat-GeometryVideoView","type":"heading","text":"iOS and VisionOS Flat — GeometryVideoView"},{"type":"paragraph","inlineContent":[{"text":"Wrap ","type":"text"},{"type":"codeVoice","code":"GeometryVideoView"},{"text":" in a ","type":"text"},{"type":"codeVoice","code":"GeometryReader"},{"text":" to maintain the correct aspect ratio:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import YBVRAppleSDK","import SwiftUI","","struct StreamView: View {","    let player: YBVRPlayerManager","","    var body: some View {","        GeometryReader { reader in","            Color.black","                .overlay {","                    GeometryVideoView(sc: player.getSurfaceController())","                        .aspectRatio(16 \/ 9, contentMode: .fit)","                        .frame(width: reader.size.width, height: reader.size.height)","                }","        }","        .ignoresSafeArea()","        .task { await startStream(video: selectedVideo) }","    }","}"]},{"level":3,"anchor":"VisionOS-RealityView-APMP","type":"heading","text":"VisionOS — RealityView (APMP)"},{"syntax":"swift","type":"codeListing","code":["struct PlayerView: View {","    private let videoEntity = Entity()","","    var body: some View {","        RealityView { content in","            content.add(videoEntity)","        }","        .task {","            preparePlayer(entity: videoEntity)","            await startStream(video: selectedVideo)","        }","    }","}"]},{"level":3,"anchor":"VisionOS-CompositorLayer","type":"heading","text":"VisionOS — CompositorLayer"},{"syntax":"swift","type":"codeListing","code":["ImmersiveSpace(for: AppImmersiveSpace.self) { $space in","    CompositorLayer(configuration: ContentStageConfiguration()) { layerRenderer in","        preparePlayer(layerRenderer: layerRenderer)","        Task { await startStream(video: selectedVideo) }","    }","}",".immersionStyle(selection: .constant(.mixed), in: .mixed)"]},{"level":2,"anchor":"Step-6-Observe-Player-State","type":"heading","text":"Step 6 — Observe Player State"},{"type":"paragraph","inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager"},{"text":" exposes Combine publishers for reactive UI updates. Always receive on the main queue and use ","type":"text"},{"type":"codeVoice","code":"[weak self]"},{"text":" captures.","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["import Combine","","var cancellables = Set<AnyCancellable>()","var videoPositionSubscriber: AnyCancellable?  \/\/ stored separately to pause during scrubbing","","func observePlayer() {","    \/\/ Playback status","    player.videoStatus","        .receive(on: DispatchQueue.main)","        .sink { [weak self] status in","            switch status {","            case .ready:   self?.isPlaying = true","            case .paused:  self?.isPlaying = false","            default: break","            }","        }","        .store(in: &cancellables)","","    \/\/ Duration","    player.videoDuration","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 > 0 }","        .sink { [weak self] in self?.duration = $0 }","        .store(in: &cancellables)","","    \/\/ Position — stored separately so scrubbing can pause updates","    videoPositionSubscriber = player.videoPosition","        .receive(on: DispatchQueue.main)","        .filter { !$0.isNaN && $0 >= 0 }","        .sink { [weak self] in","            guard let self, !self.isScrubbing else { return }","            self.sliderValue = $0","        }","","    \/\/ Video ended","    player.isVideoEnded","        .receive(on: DispatchQueue.main)","        .sink { [weak self] ended in if ended { self?.dismiss() } }","        .store(in: &cancellables)","","    \/\/ Subtitles","    player.currentSubtitleCue","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleCue = $0 }","        .store(in: &cancellables)","","    \/\/ Audio language","    player.currentAudioLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentAudioLanguage = $0 }","        .store(in: &cancellables)","","    \/\/ Subtitle language","    player.currentSubtitlesLanguagePublisher","        .debounce(for: .milliseconds(100), scheduler: DispatchQueue.main)","        .removeDuplicates()","        .sink { [weak self] in self?.currentSubtitleLanguage = $0 }","        .store(in: &cancellables)","}"]},{"level":2,"anchor":"Step-7-Multi-Audio-and-Subtitles","type":"heading","text":"Step 7 — Multi-Audio and Subtitles"},{"type":"paragraph","inlineContent":[{"text":"Retrieve available languages from the player and filter them per active camera for control room streams:","type":"text"}]},{"syntax":"swift","type":"codeListing","code":["\/\/ Global availability","var availableAudioLanguages: [String] { player.availableAudioLanguages }","var availableSubtitleLanguages: [String] { player.availableSubtitlesLanguages }","","\/\/ Per-camera availability (use these to enable\/disable options in the UI)","var cameraAudioLanguages: [String] { player.getAvailableAudioLanguages(for: selectedCamera) }","var cameraSubtitleLanguages: [String] { player.getAvailableSubtitlesLanguages(for: selectedCamera) }","","\/\/ Change selection","func selectAudioLanguage(_ lang: String) async {","    await player.setAudioLanguage(language: lang)","}","","func selectSubtitleLanguage(_ lang: String) async {","    await player.setSubtitlesLanguage(language: lang)  \/\/ pass \"\" to disable subtitles","}"]},{"level":2,"anchor":"Step-8-Handle-Errors","type":"heading","text":"Step 8 — Handle Errors"},{"type":"paragraph","inlineContent":[{"text":"Errors thrown by ","type":"text"},{"type":"codeVoice","code":"startStream(video:_:)"},{"text":" cover setup failures: a signaling file that cannot be","type":"text"},{"text":" ","type":"text"},{"text":"fetched or decoded, signaling that offers no camera to play (","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError\/invalidCamera"},{"text":"),","type":"text"},{"text":" ","type":"text"},{"text":"and a stream that cannot be opened. ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRPlayerManager\/fetchSignalingFile(video:)"},{"text":" throws","type":"text"},{"text":" ","type":"text"},{"text":"the same signaling errors when you pre-fetch. ","type":"text"},{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/YBVRSDKError"},{"text":" conforms to ","type":"text"},{"type":"codeVoice","code":"LocalizedError"},{"text":",","type":"text"},{"text":" ","type":"text"},{"text":"so ","type":"text"},{"type":"codeVoice","code":"localizedDescription"},{"text":" is fit to show.","type":"text"}]},{"type":"paragraph","inlineContent":[{"text":"Onc