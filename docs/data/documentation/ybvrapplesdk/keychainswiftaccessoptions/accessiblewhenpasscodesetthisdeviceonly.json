{"metadata":{"symbolKind":"case","externalID":"s:12YBVRAppleSDK26KeychainSwiftAccessOptionsO39accessibleWhenPasscodeSetThisDeviceOnlyyA2CmF","modules":[{"name":"YBVRAppleSDK"}],"title":"KeychainSwiftAccessOptions.accessibleWhenPasscodeSetThisDeviceOnly","fragments":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibleWhenPasscodeSetThisDeviceOnly","kind":"identifier"}],"roleHeading":"Case","role":"symbol"},"schemaVersion":{"minor":3,"major":0,"patch":0},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/keychainswiftaccessoptions\/accessiblewhenpasscodesetthisdeviceonly"]}],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions\/accessibleWhenPasscodeSetThisDeviceOnly","interfaceLanguage":"swift"},"abstract":[{"text":"The data in the keychain can only be accessed when the device is unlocked. Only available if a passcode is set on the device.","type":"text"}],"primaryContentSections":[{"declarations":[{"tokens":[{"text":"case","kind":"keyword"},{"text":" ","kind":"text"},{"text":"accessibleWhenPasscodeSetThisDeviceOnly","kind":"identifier"}],"languages":["swift"],"platforms":["iOS"]}],"kind":"declarations"},{"content":[{"type":"heading","text":"Discussion","level":2,"anchor":"discussion"},{"inlineContent":[{"text":"This is recommended for items that only need to be accessible while the application is in the foreground. Items with this attribute never migrate to a new device. After a backup is restored to a new device, these items are missing. No items can be stored in this class on devices without a passcode. Disabling the device passcode causes all items in this class to be deleted.","type":"text"}],"type":"paragraph"}],"kind":"content"}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions"]]},"kind":"symbol","sections":[],"re