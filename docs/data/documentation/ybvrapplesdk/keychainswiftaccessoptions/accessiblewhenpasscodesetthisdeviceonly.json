{"schemaVersion":{"minor":3,"patch":0,"major":0},"sections":[],"abstract":[{"text":"The data in the keychain can only be accessed when the device is unlocked. Only available if a passcode is set on the device.","type":"text"}],"identifier":{"url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions\/accessibleWhenPasscodeSetThisDeviceOnly","interfaceLanguage":"swift"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/keychainswiftaccessoptions\/accessiblewhenpasscodesetthisdeviceonly"]}],"primaryContentSections":[{"declarations":[{"platforms":["iOS","iPadOS","Mac Catalyst"],"languages":["swift"],"tokens":[{"kind":"keyword","text":"case"},{"kind":"text","text":" "},{"kind":"identifier","text":"accessibleWhenPasscodeSetThisDeviceOnly"}]}],"kind":"declarations"},{"content":[{"anchor":"discussion","level":2,"text":"Discussion","type":"heading"},{"inlineContent":[{"type":"text","text":"This is recommended for items that only need to be accessible while the application is in the foreground. Items with this attribute never migrate to a new device. After a backup is restored to a new device, these items are missing. No items can be stored in this class on devices without a passcode. Disabling the device passcode causes all items in this class to be deleted."}],"type":"paragraph"}],"kind":"content"}],"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Case","symbolKind":"case","title":"KeychainSwiftAccessOptions.accessibleWhenPasscodeSetThisDeviceOnly","externalID":"s:12YBVRAppleSDK26KeychainSwiftAccessOptionsO39accessibleWhenPasscodeSetThisDeviceOnlyyA2CmF","role":"symbol","fragments":[{"text":"case","kind":"keyword"},{"kind":"text","text":" "},{"text":"accessibleWhenPasscodeSetThisDeviceOnly","kind":"identifier"}]},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/KeychainSwiftAccessOptions