{"seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"generated":true,"anchor":"Getting-Started","title":"Getting Started"}],"variants":[{"paths":["\/documentation\/ybvrapplesdk\/installation"],"traits":[{"interfaceLanguage":"swift"}]}],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"kind":"article","sections":[],"metadata":{"roleHeading":"Article","modules":[{"name":"YBVRAppleSDK"}],"title":"Installation","role":"article"},"schemaVersion":{"minor":3,"major":0,"patch":0},"abstract":[{"type":"text","text":"Add YBVRAppleSDK to your iOS or visionOS project."}],"primaryContentSections":[{"kind":"content","content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built","type":"text"},{"text":" ","type":"text"},{"text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s","type":"text"},{"text":" ","type":"text"},{"text":"own repositories — YBVR provides you with a ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory containing everything","type":"text"},{"text":" ","type":"text"},{"text":"required.","type":"text"}]},{"level":3,"type":"heading","text":"Requirements","anchor":"Requirements"},{"header":"row","type":"table","rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Minimum OS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Xcode"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"text":"17.0","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"16.2 or later"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"visionOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26.0 or later"}],"type":"paragraph"}]]]},{"inlineContent":[{"text":"An Apple silicon Mac is required to build.","type":"text"}],"type":"paragraph"},{"level":2,"anchor":"Step-1-Obtain-the-SDK-Package","text":"Step 1 — Obtain the SDK Package","type":"heading"},{"inlineContent":[{"text":"YBVR delivers the SDK as a ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory with this layout:"}],"type":"paragraph"},{"code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS Sample Scene apps","│   ├── Shared               \/\/ playback code and UI both apps share","│   ├── iOS\/SampleScene","│   └── visionOS\/SampleScene","└── docs\/                    \/\/ offline copy of this reference"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"text":" ","type":"text"},{"type":"text","text":"serves every build configuration."}],"type":"paragraph"},{"type":"aside","style":"important","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Keep the ","type":"text"},{"code":"frameworks","type":"codeVoice"},{"text":" directory next to ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":". The package refers to","type":"text"},{"text":" ","type":"text"},{"text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution.","type":"text"}]}]},{"inlineContent":[{"type":"text","text":"Place the directory anywhere inside — or alongside — your project. A common choice is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Vendor\/"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ThirdParty\/"},{"type":"text","text":" folder in your repository root."}],"type":"paragraph"},{"anchor":"Step-2-Add-the-Package-to-Your-Project","type":"heading","level":2,"text":"Step 2 — Add the Package to Your Project"},{"inlineContent":[{"type":"text","text":"In Xcode:"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"text":"Select ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"File ▸ Add Package Dependencies…"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Click "},{"type":"strong","inlineContent":[{"text":"Add Local…","type":"text"}]},{"type":"text","text":" in the bottom-left of the dialog."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory (the one containing "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":") and click"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Add Package"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In the target chooser, add the "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" library product to your app target."}],"type":"paragraph"}]}]},{"inlineContent":[{"type":"text","text":"To reference it from your own Swift package instead, declare it as a local path dependency:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"]},{"inlineContent":[{"type":"text","text":"The product bundles every binary target the SDK needs, so this single dependency is"},{"type":"text","text":" "},{"type":"text","text":"sufficient — you never list "},{"code":"KSPlayer","type":"codeVoice"},{"type":"text","text":", "},{"code":"Yams","type":"codeVoice"},{"type":"text","text":", or the FFmpeg targets yourself."}],"type":"paragraph"},{"anchor":"Step-3-Confirm-the-Link","type":"heading","level":2,"text":"Step 3 — Confirm the Link"},{"inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}],"type":"paragraph"},{"syntax":"swift","type":"codeListing","code":["import YBVRAppleSDK"]},{"inlineContent":[{"type":"text","text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need"},{"type":"text","text":" "},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"type":"text","text":" "},{"type":"text","text":"link time, the usual cause is that the"},{"type":"text","text":" "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" library product was not added to the target in Step 2.4 — check"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Step-4-Run-a-Sample-Scene","type":"heading","level":2,"text":"Step 4 — Run a Sample Scene"},{"inlineContent":[{"type":"text","text":"The delivered package includes a working Sample Scene app for both platforms under"},{"type":"text","text":" "},{"code":"Examples\/","type":"codeVoice"},{"type":"text","text":". They are the fastest way to confirm your setup and to see the integration"},{"type":"text","text":" "},{"type":"text","text":"patterns in context:"}],"type":"paragraph"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Examples\/iOS\/SampleScene\/SampleScene-iOS.xcodeproj"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Examples\/visionOS\/SampleScene\/SampleScene-VisionOS.xcodeproj","type":"codeVoice"}],"type":"paragraph"}]}]},{"inlineContent":[{"text":"Both projects already reference the delivered package by relative path, so they build as","type":"text"},{"text":" ","type":"text"},{"text":"delivered without further configuration — leave the ","type":"text"},{"code":"Examples","type":"codeVoice"},{"text":" directory inside the package.","type":"text"}],"type":"paragraph"},{"anchor":"Next-Steps","level":2,"text":"Next Steps","type":"heading"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"},{"type":"text","text":" — load configuration, create a player, and start streaming."}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"url":"\/documentation\/ybvrapplesdk","type":"topic","kind":"symbol","title":"YBVRAppleSDK","role":"collection","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","abstract":[{"text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS.","type":"text"}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"kind":"article","abstract":[{"text":"Get up and running with YBVR video playback in your iOS or VisionOS app.","type":"text"}],"type":"topic","url":"\/documentation\/ybvrapplesdk\/quickstart","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","role":"article","title":"Quick Start"}}}