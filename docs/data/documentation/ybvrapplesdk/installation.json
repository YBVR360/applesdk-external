{"primaryContentSections":[{"content":[{"level":2,"type":"heading","text":"Overview","anchor":"Overview"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"type":"text","text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"own repositories — YBVR provides you with a "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory containing everything"},{"type":"text","text":" "},{"type":"text","text":"required."}]},{"level":3,"type":"heading","text":"Requirements","anchor":"Requirements"},{"header":"row","type":"table","rows":[[[{"type":"paragraph","inlineContent":[{"text":"Platform","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Minimum OS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Xcode","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"iOS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"17.0","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"16.2 or later","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"visionOS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"26.0","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"26.0 or later","type":"text"}]}]]]},{"type":"paragraph","inlineContent":[{"type":"text","text":"An Apple silicon Mac is required to build."}]},{"level":2,"type":"heading","text":"Step 1 — Obtain the SDK Package","anchor":"Step-1-Obtain-the-SDK-Package"},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVR delivers the SDK as a "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory with this layout:"}]},{"syntax":null,"type":"codeListing","code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}]},{"style":"important","type":"aside","name":"Important","content":[{"type":"paragraph","inlineContent":[{"text":"Keep the ","type":"text"},{"code":"frameworks","type":"codeVoice"},{"text":" directory next to ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":". The package refers to","type":"text"},{"text":" ","type":"text"},{"text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution.","type":"text"}]}]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Place the directory anywhere inside — or alongside — your project. A common choice is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Vendor\/"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ThirdParty\/"},{"type":"text","text":" folder in your repository root."}]},{"level":2,"type":"heading","text":"Step 2 — Add the Package to Your Project","anchor":"Step-2-Add-the-Package-to-Your-Project"},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode:"}]},{"type":"orderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Select "},{"type":"strong","inlineContent":[{"text":"File ▸ Add Package Dependencies…","type":"text"}]}]}]},{"content":[{"inlineContent":[{"text":"Click ","type":"text"},{"type":"strong","inlineContent":[{"text":"Add Local…","type":"text"}]},{"text":" in the bottom-left of the dialog.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory (the one containing ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":") and click","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Add Package"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"In the target chooser, add the "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" library product to your app target."}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"To reference it from your own Swift package instead, declare it as a local path dependency:","type":"text"}]},{"code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The product bundles every binary target the SDK needs, so this single dependency is"},{"type":"text","text":" "},{"type":"text","text":"sufficient — you never list "},{"type":"codeVoice","code":"KSPlayer"},{"type":"text","text":", "},{"type":"codeVoice","code":"Yams"},{"type":"text","text":", or the FFmpeg targets yourself."}],"type":"paragraph"},{"text":"Step 3 — Confirm the Link","anchor":"Step-3-Confirm-the-Link","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}],"type":"paragraph"},{"code":["import YBVRAppleSDK"],"type":"codeListing","syntax":"swift"},{"inlineContent":[{"type":"text","text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need"},{"type":"text","text":" "},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"type":"text","text":" "},{"type":"text","text":"link time, the usual cause is that the"},{"type":"text","text":" "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" library product was not added to the target in Step 2.4 — check"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"text":"Step 4 — Run a Demo App","anchor":"Step-4-Run-a-Demo-App","type":"heading","level":2},{"inlineContent":[{"type":"text","text":"The delivered package includes working demo apps for both platforms under "},{"type":"codeVoice","code":"Examples\/"},{"type":"text","text":". They"},{"type":"text","text":" "},{"type":"text","text":"are the fastest way to confirm your setup and to see the integration patterns in context:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"codeVoice","code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both projects already reference the delivered package by relative path, so they build as"},{"type":"text","text":" "},{"type":"text","text":"delivered without further configuration — leave the "},{"type":"codeVoice","code":"Examples"},{"type":"text","text":" directory inside the package."}],"type":"paragraph"},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"items":[{"content":[{"inlineContent":[{"isActive":true,"type":"reference","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"},{"type":"text","text":" — load configuration, create a player, and start streaming."}],"type":"paragraph"}]}],"type":"unorderedList"}],"kind":"content"}],"abstract":[{"type":"text","text":"Add YBVRAppleSDK to your iOS or visionOS project."}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"title":"Installation","roleHeading":"Article","role":"article"},"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"anchor":"Getting-Started","title":"Getting Started"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"sections":[],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"kind":"article","abstract":[{"text":"Get up and running with YBVR video playback in your iOS or VisionOS app.","type":"text"}],"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","type":"topic","url":"\/documentation\/ybvrapplesdk\/quickstart","title":"Quick Start","role":"article"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"title":"YBVRAppleSDK","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","role":"collection","url":"\/documentation\/ybvrapplesdk","type":"topic","kind":"symbol"}}}