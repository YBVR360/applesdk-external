{"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"title":"Installation","roleHeading":"Article","role":"article"},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"abstract":[{"text":"Add YBVRAppleSDK to your iOS or visionOS project.","type":"text"}],"kind":"article","seeAlsoSections":[{"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"generated":true,"anchor":"Getting-Started","title":"Getting Started"}],"sections":[],"primaryContentSections":[{"kind":"content","content":[{"text":"Overview","anchor":"Overview","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"type":"text","text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"own repositories — YBVR provides you with a "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory containing everything"},{"type":"text","text":" "},{"type":"text","text":"required."}]},{"text":"Requirements","anchor":"Requirements","type":"heading","level":3},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Platform","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Minimum OS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Xcode","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"iOS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"17.0","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"16.2 or later","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"visionOS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"26.0","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"26.0 or later","type":"text"}]}]]],"type":"table","header":"row"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An Apple silicon Mac is required to build."}]},{"text":"Step 1 — Obtain the SDK Package","anchor":"Step-1-Obtain-the-SDK-Package","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"YBVR delivers the SDK as a "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory with this layout:"}]},{"syntax":null,"type":"codeListing","code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"]},{"inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}],"type":"paragraph"},{"style":"important","name":"Important","content":[{"inlineContent":[{"text":"Keep the ","type":"text"},{"type":"codeVoice","code":"frameworks"},{"text":" directory next to ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":". The package refers to","type":"text"},{"text":" ","type":"text"},{"type":"text","text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution."}],"type":"paragraph"}],"type":"aside"},{"inlineContent":[{"text":"Place the directory anywhere inside — or alongside — your project. A common choice is a","type":"text"},{"text":" ","type":"text"},{"code":"Vendor\/","type":"codeVoice"},{"text":" or ","type":"text"},{"code":"ThirdParty\/","type":"codeVoice"},{"text":" folder in your repository root.","type":"text"}],"type":"paragraph"},{"anchor":"Step-2-Add-the-Package-to-Your-Project","text":"Step 2 — Add the Package to Your Project","level":2,"type":"heading"},{"inlineContent":[{"text":"In Xcode:","type":"text"}],"type":"paragraph"},{"type":"orderedList","items":[{"content":[{"inlineContent":[{"type":"text","text":"Select "},{"type":"strong","inlineContent":[{"type":"text","text":"File ▸ Add Package Dependencies…"}]}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Click ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Add Local…"}]},{"text":" in the bottom-left of the dialog.","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the ","type":"text"},{"type":"codeVoice","code":"YBVRAppleSDK"},{"text":" directory (the one containing ","type":"text"},{"type":"codeVoice","code":"Package.swift"},{"text":") and click","type":"text"},{"text":" ","type":"text"},{"type":"strong","inlineContent":[{"type":"text","text":"Add Package"}]},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In the target chooser, add the ","type":"text"},{"type":"codeVoice","code":"YBVRAppleSDK"},{"text":" library product to your app target.","type":"text"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"To reference it from your own Swift package instead, declare it as a local path dependency:","type":"text"}]},{"type":"codeListing","code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The product bundles every binary target the SDK needs, so this single dependency is","type":"text"},{"text":" ","type":"text"},{"text":"sufficient — you never list ","type":"text"},{"code":"KSPlayer","type":"codeVoice"},{"text":", ","type":"text"},{"code":"Yams","type":"codeVoice"},{"text":", or the FFmpeg targets yourself.","type":"text"}]},{"type":"heading","text":"Step 3 — Confirm the Link","level":2,"anchor":"Step-3-Confirm-the-Link"},{"type":"paragraph","inlineContent":[{"text":"Add the import to any Swift file and build:","type":"text"}]},{"type":"codeListing","code":["import YBVRAppleSDK"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need","type":"text"},{"text":" ","type":"text"},{"text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at","type":"text"},{"text":" ","type":"text"},{"text":"link time, the usual cause is that the","type":"text"},{"text":" ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" library product was not added to the target in Step 2.4 — check","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content","type":"text"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"heading","text":"Step 4 — Run a Demo App","level":2,"anchor":"Step-4-Run-a-Demo-App"},{"type":"paragraph","inlineContent":[{"text":"The delivered package includes working demo apps for both platforms under ","type":"text"},{"code":"Examples\/","type":"codeVoice"},{"text":". They","type":"text"},{"text":" ","type":"text"},{"text":"are the fastest way to confirm your setup and to see the integration patterns in context:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}],"type":"paragraph"}]}]},{"type":"paragraph","inlineContent":[{"text":"Both projects already reference the delivered package by relative path, so they build as","type":"text"},{"text":" ","type":"text"},{"text":"delivered without further configuration — leave the ","type":"text"},{"code":"Examples","type":"codeVoice"},{"text":" directory inside the package.","type":"text"}]},{"anchor":"Next-Steps","text":"Next Steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","isActive":true,"type":"reference"},{"type":"text","text":" — load configuration, create a player, and start streaming."}],"type":"paragraph"}]}]}]}],"schemaVersion":{"major":0,"patch":0,"minor":3},"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"kind":"symbol","title":"YBVRAppleSDK","url":"\/documentation\/ybvrapplesdk","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","role":"collection","type":"topic"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"title":"Quick Start","kind":"article","abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"type":"topic","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","url":"\/documentation\/ybvrapplesdk\/quickstart","role":"article"}}}