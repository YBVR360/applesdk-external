{"sections":[],"identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},"primaryContentSections":[{"kind":"content","content":[{"anchor":"Overview","level":2,"text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"type":"text","text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"own repositories — YBVR provides you with a "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory containing everything"},{"type":"text","text":" "},{"type":"text","text":"required."}],"type":"paragraph"},{"anchor":"Requirements","level":3,"text":"Requirements","type":"heading"},{"rows":[[[{"type":"paragraph","inlineContent":[{"text":"Platform","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Minimum OS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"Xcode","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"iOS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"17.0","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"16.2 or later","type":"text"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"visionOS","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"26.0","type":"text"}]}],[{"type":"paragraph","inlineContent":[{"text":"26.0 or later","type":"text"}]}]]],"header":"row","type":"table"},{"inlineContent":[{"type":"text","text":"An Apple silicon Mac is required to build."}],"type":"paragraph"},{"anchor":"Step-1-Obtain-the-SDK-Package","level":2,"text":"Step 1 — Obtain the SDK Package","type":"heading"},{"inlineContent":[{"type":"text","text":"YBVR delivers the SDK as a "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory with this layout:"}],"type":"paragraph"},{"code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}],"type":"paragraph"},{"style":"important","content":[{"type":"paragraph","inlineContent":[{"text":"Keep the ","type":"text"},{"code":"frameworks","type":"codeVoice"},{"text":" directory next to ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":". The package refers to","type":"text"},{"text":" ","type":"text"},{"text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution.","type":"text"}]}],"name":"Important","type":"aside"},{"inlineContent":[{"type":"text","text":"Place the directory anywhere inside — or alongside — your project. A common choice is a"},{"type":"text","text":" "},{"code":"Vendor\/","type":"codeVoice"},{"type":"text","text":" or "},{"code":"ThirdParty\/","type":"codeVoice"},{"type":"text","text":" folder in your repository root."}],"type":"paragraph"},{"anchor":"Step-2-Add-the-Package-to-Your-Project","level":2,"text":"Step 2 — Add the Package to Your Project","type":"heading"},{"inlineContent":[{"type":"text","text":"In Xcode:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"text","text":"Select "},{"inlineContent":[{"type":"text","text":"File ▸ Add Package Dependencies…"}],"type":"strong"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"type":"text","text":"Click "},{"inlineContent":[{"type":"text","text":"Add Local…"}],"type":"strong"},{"type":"text","text":" in the bottom-left of the dialog."}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"Choose the ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory (the one containing ","type":"text"},{"code":"Package.swift","type":"codeVoice"},{"text":") and click","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Add Package"}],"type":"strong"},{"text":".","type":"text"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"text":"In the target chooser, add the ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" library product to your app target.","type":"text"}],"type":"paragraph"}]}],"type":"orderedList"},{"inlineContent":[{"type":"text","text":"To reference it from your own Swift package instead, declare it as a local path dependency:"}],"type":"paragraph"},{"code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The product bundles every binary target the SDK needs, so this single dependency is"},{"type":"text","text":" "},{"type":"text","text":"sufficient — you never list "},{"code":"KSPlayer","type":"codeVoice"},{"type":"text","text":", "},{"code":"Yams","type":"codeVoice"},{"type":"text","text":", or the FFmpeg targets yourself."}],"type":"paragraph"},{"anchor":"Step-3-Confirm-the-Link","level":2,"text":"Step 3 — Confirm the Link","type":"heading"},{"inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}],"type":"paragraph"},{"code":["import YBVRAppleSDK"],"syntax":"swift","type":"codeListing"},{"inlineContent":[{"type":"text","text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need"},{"type":"text","text":" "},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"type":"text","text":" "},{"type":"text","text":"link time, the usual cause is that the"},{"type":"text","text":" "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" library product was not added to the target in Step 2.4 — check"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":"."}],"type":"paragraph"},{"anchor":"Step-4-Run-a-Demo-App","level":2,"text":"Step 4 — Run a Demo App","type":"heading"},{"inlineContent":[{"type":"text","text":"The delivered package includes working demo apps for both platforms under "},{"code":"Examples\/","type":"codeVoice"},{"type":"text","text":". They"},{"type":"text","text":" "},{"type":"text","text":"are the fastest way to confirm your setup and to see the integration patterns in context:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}],"type":"paragraph"}]},{"content":[{"inlineContent":[{"code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}],"type":"paragraph"}]}],"type":"unorderedList"},{"inlineContent":[{"type":"text","text":"Both projects already reference the delivered package by relative path, so they build as"},{"type":"text","text":" "},{"type":"text","text":"delivered without further configuration — leave the "},{"code":"Examples","type":"codeVoice"},{"type":"text","text":" directory inside the package."}],"type":"paragraph"},{"anchor":"Next-Steps","level":2,"text":"Next Steps","type":"heading"},{"items":[{"content":[{"inlineContent":[{"isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","type":"reference"},{"text":" — load configuration, create a player, and start streaming.","type":"text"}],"type":"paragraph"}]}],"type":"unorderedList"}]}],"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"title":"Getting Started","anchor":"Getting-Started"}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"schemaVersion":{"minor":3,"patch":0,"major":0},"kind":"article","metadata":{"modules":[{"name":"YBVRAppleSDK"}],"role":"article","title":"Installation","roleHeading":"Article"},"abstract":[{"text":"Add YBVRAppleSDK to your iOS or visionOS project.","type":"text"}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"title":"YBVRAppleSDK","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","kind":"symbol","role":"collection","type":"topic","url":"\/documentation\/ybvrapplesdk","abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}]},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"title":"Quick Start","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","kind":"article","role":"article","type":"topic","url":"\/documentation\/ybvrapplesdk\/quickstart","abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}]}}}