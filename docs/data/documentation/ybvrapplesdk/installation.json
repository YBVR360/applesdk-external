{"schemaVersion":{"patch":0,"minor":3,"major":0},"seeAlsoSections":[{"generated":true,"identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"title":"Getting Started","anchor":"Getting-Started"}],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"sections":[],"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"role":"article","title":"Installation","roleHeading":"Article"},"abstract":[{"type":"text","text":"Add YBVRAppleSDK to your iOS or visionOS project."}],"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},"primaryContentSections":[{"content":[{"level":2,"anchor":"Overview","text":"Overview","type":"heading"},{"inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"type":"text","text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"own repositories — YBVR provides you with a "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"type":"text","text":" directory containing everything"},{"type":"text","text":" "},{"type":"text","text":"required."}],"type":"paragraph"},{"level":3,"anchor":"Requirements","text":"Requirements","type":"heading"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"inlineContent":[{"text":"Minimum OS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"Xcode"}],"type":"paragraph"}]],[[{"inlineContent":[{"text":"iOS","type":"text"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"17.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"16.2 or later"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"visionOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26.0"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"26.0 or later","type":"text"}]}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"type":"text","text":"An Apple silicon Mac is required to build."}]},{"anchor":"Step-1-Obtain-the-SDK-Package","text":"Step 1 — Obtain the SDK Package","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"text":"YBVR delivers the SDK as a ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory with this layout:","type":"text"}]},{"syntax":null,"type":"codeListing","code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"]},{"type":"paragraph","inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the "},{"type":"codeVoice","code":"frameworks"},{"type":"text","text":" directory next to "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":". The package refers to"},{"type":"text","text":" "},{"type":"text","text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution."}]}],"name":"Important","type":"aside","style":"important"},{"type":"paragraph","inlineContent":[{"type":"text","text":"Place the directory anywhere inside — or alongside — your project. A common choice is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Vendor\/"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ThirdParty\/"},{"type":"text","text":" folder in your repository root."}]},{"anchor":"Step-2-Add-the-Package-to-Your-Project","text":"Step 2 — Add the Package to Your Project","type":"heading","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"In Xcode:"}]},{"items":[{"content":[{"inlineContent":[{"text":"Select ","type":"text"},{"type":"strong","inlineContent":[{"text":"File ▸ Add Package Dependencies…","type":"text"}]}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click "},{"inlineContent":[{"type":"text","text":"Add Local…"}],"type":"strong"},{"type":"text","text":" in the bottom-left of the dialog."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"Choose the "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory (the one containing "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":") and click"},{"type":"text","text":" "},{"inlineContent":[{"type":"text","text":"Add Package"}],"type":"strong"},{"type":"text","text":"."}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"text":"In the target chooser, add the ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" library product to your app target.","type":"text"}]}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"To reference it from your own Swift package instead, declare it as a local path dependency:","type":"text"}]},{"type":"codeListing","syntax":"swift","code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"]},{"type":"paragraph","inlineContent":[{"text":"The product bundles every binary target the SDK needs, so this single dependency is","type":"text"},{"text":" ","type":"text"},{"text":"sufficient — you never list ","type":"text"},{"code":"KSPlayer","type":"codeVoice"},{"type":"text","text":", "},{"type":"codeVoice","code":"Yams"},{"text":", or the FFmpeg targets yourself.","type":"text"}]},{"type":"heading","text":"Step 3 — Confirm the Link","anchor":"Step-3-Confirm-the-Link","level":2},{"type":"paragraph","inlineContent":[{"type":"text","text":"Add the import to any Swift file and build:"}]},{"type":"codeListing","syntax":"swift","code":["import YBVRAppleSDK"]},{"type":"paragraph","inlineContent":[{"text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need","type":"text"},{"text":" ","type":"text"},{"text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at","type":"text"},{"text":" ","type":"text"},{"text":"link time, the usual cause is that the","type":"text"},{"text":" ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" library product was not added to the target in Step 2.4 — check","type":"text"},{"text":" ","type":"text"},{"inlineContent":[{"type":"text","text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content"}],"type":"strong"},{"text":".","type":"text"}]},{"type":"heading","text":"Step 4 — Run a Demo App","anchor":"Step-4-Run-a-Demo-App","level":2},{"type":"paragraph","inlineContent":[{"text":"The delivered package includes working demo apps for both platforms under ","type":"text"},{"code":"Examples\/","type":"codeVoice"},{"text":". They","type":"text"},{"text":" ","type":"text"},{"text":"are the fastest way to confirm your setup and to see the integration patterns in context:","type":"text"}]},{"type":"unorderedList","items":[{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj"}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"codeVoice","code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj"}]}]}]},{"type":"paragraph","inlineContent":[{"text":"Both projects already reference the delivered package by relative path, so they build as","type":"text"},{"type":"text","text":" "},{"type":"text","text":"delivered without further configuration — leave the "},{"type":"codeVoice","code":"Examples"},{"type":"text","text":" directory inside the package."}]},{"text":"Next Steps","anchor":"Next-Steps","type":"heading","level":2},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","type":"reference","isActive":true},{"type":"text","text":" — load configuration, create a player, and start streaming."}],"type":"paragraph"}]}]}],"kind":"content"}],"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"title":"YBVRAppleSDK","type":"topic","role":"collection","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","url":"\/documentation\/ybvrapplesdk","kind":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"url":"\/documentation\/ybvrapplesdk\/quickstart","title":"Quick Start","abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}],"type":"topic","role":"article","kind":"article","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"}}}