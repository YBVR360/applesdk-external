{"kind":"article","identifier":{"interfaceLanguage":"swift","url":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/Installation"},"schemaVersion":{"minor":3,"major":0,"patch":0},"metadata":{"modules":[{"name":"YBVRAppleSDK"}],"roleHeading":"Article","role":"article","title":"Installation"},"primaryContentSections":[{"content":[{"anchor":"Overview","level":2,"type":"heading","text":"Overview"},{"inlineContent":[{"type":"text","text":"YBVRAppleSDK is delivered as a self-contained Swift package that wraps pre-built"},{"type":"text","text":" "},{"type":"text","text":"XCFrameworks. You do not build the SDK from source, and you do not need access to the SDK’s"},{"type":"text","text":" "},{"type":"text","text":"own repositories — YBVR provides you with a "},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory containing everything","type":"text"},{"text":" ","type":"text"},{"text":"required.","type":"text"}],"type":"paragraph"},{"type":"heading","level":3,"anchor":"Requirements","text":"Requirements"},{"header":"row","rows":[[[{"inlineContent":[{"type":"text","text":"Platform"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"text":"Minimum OS","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"Xcode"}],"type":"paragraph"}]],[[{"inlineContent":[{"type":"text","text":"iOS"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"17.0"}],"type":"paragraph"}],[{"type":"paragraph","inlineContent":[{"type":"text","text":"16.2 or later"}]}]],[[{"type":"paragraph","inlineContent":[{"text":"visionOS","type":"text"}]}],[{"inlineContent":[{"type":"text","text":"26.0"}],"type":"paragraph"}],[{"inlineContent":[{"type":"text","text":"26.0 or later"}],"type":"paragraph"}]]],"type":"table"},{"type":"paragraph","inlineContent":[{"text":"An Apple silicon Mac is required to build.","type":"text"}]},{"level":2,"text":"Step 1 — Obtain the SDK Package","anchor":"Step-1-Obtain-the-SDK-Package","type":"heading"},{"inlineContent":[{"text":"YBVR delivers the SDK as a ","type":"text"},{"code":"YBVRAppleSDK","type":"codeVoice"},{"text":" directory with this layout:","type":"text"}],"type":"paragraph"},{"code":["YBVRAppleSDK\/","├── Package.swift            \/\/ declares every binary target","├── frameworks\/              \/\/ the XCFrameworks the package wraps","│   ├── YBVRAppleSDK.xcframework","│   ├── KSPlayer.xcframework","│   ├── Yams.xcframework","│   ├── FFmpegKit.xcframework","│   └── … Libav*, libass, Libsw* …","├── Examples\/                \/\/ runnable iOS and visionOS demo apps","│   ├── common               \/\/ playback code both demos share","│   ├── iOS\/DemoApp","│   └── visionOS\/DemoApp","└── docs\/                    \/\/ offline copy of this reference"],"syntax":null,"type":"codeListing"},{"inlineContent":[{"type":"text","text":"Every XCFramework covers device and simulator for both iOS and visionOS, so one package"},{"type":"text","text":" "},{"type":"text","text":"serves every build configuration."}],"type":"paragraph"},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Keep the "},{"type":"codeVoice","code":"frameworks"},{"type":"text","text":" directory next to "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":". The package refers to"},{"text":" ","type":"text"},{"text":"each XCFramework by relative path, and moving or flattening the directory breaks resolution.","type":"text"}]}],"type":"aside","name":"Important","style":"important"},{"inlineContent":[{"type":"text","text":"Place the directory anywhere inside — or alongside — your project. A common choice is a"},{"type":"text","text":" "},{"type":"codeVoice","code":"Vendor\/"},{"type":"text","text":" or "},{"type":"codeVoice","code":"ThirdParty\/"},{"type":"text","text":" folder in your repository root."}],"type":"paragraph"},{"type":"heading","text":"Step 2 — Add the Package to Your Project","level":2,"anchor":"Step-2-Add-the-Package-to-Your-Project"},{"inlineContent":[{"type":"text","text":"In Xcode:"}],"type":"paragraph"},{"items":[{"content":[{"type":"paragraph","inlineContent":[{"text":"Select ","type":"text"},{"type":"strong","inlineContent":[{"text":"File ▸ Add Package Dependencies…","type":"text"}]}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Click "},{"type":"strong","inlineContent":[{"type":"text","text":"Add Local…"}]},{"type":"text","text":" in the bottom-left of the dialog."}]}]},{"content":[{"type":"paragraph","inlineContent":[{"type":"text","text":"Choose the "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" directory (the one containing "},{"type":"codeVoice","code":"Package.swift"},{"type":"text","text":") and click"},{"type":"text","text":" "},{"inlineContent":[{"text":"Add Package","type":"text"}],"type":"strong"},{"type":"text","text":"."}]}]},{"content":[{"inlineContent":[{"type":"text","text":"In the target chooser, add the "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" library product to your app target."}],"type":"paragraph"}]}],"type":"orderedList"},{"type":"paragraph","inlineContent":[{"text":"To reference it from your own Swift package instead, declare it as a local path dependency:","type":"text"}]},{"type":"codeListing","code":["dependencies: [","    .package(path: \"Vendor\/YBVRAppleSDK\")","],","targets: [","    .target(","        name: \"MyApp\",","        dependencies: [","            .product(name: \"YBVRAppleSDK\", package: \"YBVRAppleSDK\")","        ]","    )","]"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The product bundles every binary target the SDK needs, so this single dependency is"},{"text":" ","type":"text"},{"text":"sufficient — you never list ","type":"text"},{"type":"codeVoice","code":"KSPlayer"},{"text":", ","type":"text"},{"type":"codeVoice","code":"Yams"},{"text":", or the FFmpeg targets yourself.","type":"text"}]},{"type":"heading","anchor":"Step-3-Confirm-the-Link","text":"Step 3 — Confirm the Link","level":2},{"type":"paragraph","inlineContent":[{"text":"Add the import to any Swift file and build:","type":"text"}]},{"type":"codeListing","code":["import YBVRAppleSDK"],"syntax":"swift"},{"type":"paragraph","inlineContent":[{"type":"text","text":"The XCFrameworks come in through the package, and Xcode links and embeds whatever they need"},{"type":"text","text":" "},{"type":"text","text":"for you, so there is no “Embed & Sign” step to configure. If Xcode reports missing symbols at"},{"type":"text","text":" "},{"type":"text","text":"link time, the usual cause is that the"},{"type":"text","text":" "},{"type":"codeVoice","code":"YBVRAppleSDK"},{"type":"text","text":" library product was not added to the target in Step 2.4 — check"},{"type":"text","text":" "},{"type":"strong","inlineContent":[{"text":"Target ▸ General ▸ Frameworks, Libraries, and Embedded Content","type":"text"}]},{"type":"text","text":"."}]},{"text":"Step 4 — Run a Demo App","anchor":"Step-4-Run-a-Demo-App","level":2,"type":"heading"},{"inlineContent":[{"type":"text","text":"The delivered package includes working demo apps for both platforms under "},{"type":"codeVoice","code":"Examples\/"},{"type":"text","text":". They"},{"type":"text","text":" "},{"type":"text","text":"are the fastest way to confirm your setup and to see the integration patterns in context:"}],"type":"paragraph"},{"items":[{"content":[{"inlineContent":[{"type":"codeVoice","code":"Examples\/iOS\/DemoApp\/DemoApp.xcodeproj"}],"type":"paragraph"}]},{"content":[{"type":"paragraph","inlineContent":[{"code":"Examples\/visionOS\/DemoApp\/DemoApp.xcodeproj","type":"codeVoice"}]}]}],"type":"unorderedList"},{"inlineContent":[{"text":"Both projects already reference the delivered package by relative path, so they build as","type":"text"},{"text":" ","type":"text"},{"text":"delivered without further configuration — leave the ","type":"text"},{"code":"Examples","type":"codeVoice"},{"text":" directory inside the package.","type":"text"}],"type":"paragraph"},{"text":"Next Steps","anchor":"Next-Steps","level":2,"type":"heading"},{"type":"unorderedList","items":[{"content":[{"inlineContent":[{"type":"reference","isActive":true,"identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"},{"type":"text","text":" — load configuration, create a player, and start streaming."}],"type":"paragraph"}]}]}],"kind":"content"}],"seeAlsoSections":[{"anchor":"Getting-Started","title":"Getting Started","identifiers":["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart"],"generated":true}],"variants":[{"traits":[{"interfaceLanguage":"swift"}],"paths":["\/documentation\/ybvrapplesdk\/installation"]}],"abstract":[{"type":"text","text":"Add YBVRAppleSDK to your iOS or visionOS project."}],"sections":[],"hierarchy":{"paths":[["doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK"]]},"references":{"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK":{"abstract":[{"type":"text","text":"YBVR Apple SDK for streaming and displaying VR video on iOS and visionOS."}],"title":"YBVRAppleSDK","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK","type":"topic","role":"collection","url":"\/documentation\/ybvrapplesdk","kind":"symbol"},"doc://applesdk.YBVRAppleSDK/documentation/YBVRAppleSDK/QuickStart":{"url":"\/documentation\/ybvrapplesdk\/quickstart","type":"topic","kind":"article","title":"Quick Start","identifier":"doc:\/\/applesdk.YBVRAppleSDK\/documentation\/YBVRAppleSDK\/QuickStart","role":"article","abstract":[{"type":"text","text":"Get up and running with YBVR video playback in your iOS or VisionOS app."}]}}}